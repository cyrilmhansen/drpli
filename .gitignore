# transient harness tags created by tools/e2e_gate.py --link-run and
# tools/prefix_check.py (removed by the tools themselves; ignored so a
# running job never looks like working-tree dirt). NEVER used for real
# goldens -- those are golden/<corpus-or-experiment>/NAME/NAME.REL.
golden/e2elink*/
golden/e2elinkdr*/
golden/e2erun*/
golden/e2erundr*/
golden/e2estage*/
golden/e2epfx*/
golden/e2etmp*/
golden/e2echk*/

# derived link/run artifacts (linked .COM + cpmsim transcripts) are not
# goldens: the semantic content is transcribed into spec/CLAIMS.md.
# [E2E-7A] tags like e2e7link / e2e7run are DR-arm verification output.
golden/e2e*link*/
golden/e2e*run*/
golden/e2e*pfx*/

# Independent test corpus: shallow clone of https://github.com/Steadsoft/PLI-2000 (see SOURCES.md).
# Kept untracked -- it is a nested git repo, not vendored source, and its tests are inputs,
# not goldens.  Copies we DO track: e20src/*.PLI (line-ending-normalized) and golden/e2e214.
thirdparty/PLI-2000/

# [E2E-33/P0] the --runtime arm re-links and re-runs, and cpmsim prints wall-clock
# timing into its transcript.  Console bytes and .COM are deterministic and stay tracked;
# these transcript files are not, and leaving them tracked dirtied the tree on every gate run.
golden/e32rt_*/link-batch*.transcript.txt
golden/e32rt_*/*.transcript.txt

# [E2E-35/P2] same rule for the NETWORK oracle/verification dirs: the cpmsim transcript carries
# wall-clock text, the linked .COM and the .REL/.PRN inside do not, so those stay tracked.
golden/e35net*/link-batch*.transcript.txt
