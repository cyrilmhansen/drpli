a:
    procedure options(main);
    declare r fixed;
    r = f();
    put skip list('W', r);
    stop;
    g: procedure(n) returns(fixed);
    declare n fixed;
    return (n * 3);
    end g;
    f: procedure returns(fixed);
    declare t fixed, u fixed;
    t = 5;
    u = 7;
    return (t + u + g(3));
    end f;
end a;
