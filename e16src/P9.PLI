a:
    procedure options(main);
    declare r fixed;
    r = f();
    put skip list('W', r);
    stop;
    h: procedure(n) returns(fixed);
    declare n fixed;
    return (n * 5);
    end h;
    g: procedure(n) returns(fixed);
    declare n fixed;
    return (n + 3);
    end g;
    f: procedure returns(fixed);
    declare t fixed;
    t = 100;
    return (t + g(h(2)));
    end f;
end a;
