a:
    procedure options(main);
    declare r fixed;
    r = f();
    put skip list('W', r);
    stop;
    g: procedure(n) returns(fixed);
    declare n fixed;
    return (n * 3);
    end g;
    f: procedure returns(fixed);
    declare t fixed;
    t = 100;
    return (g(3) - t);
    end f;
end a;
