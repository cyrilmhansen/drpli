E49D3:
  procedure options(main);
  /* [E2E-49/P3] BARE/BARE member-vs-member (`na = nb').  If DR
     admits all three spellings, D1/D2/D3 and E49B1 form a byte-
     identical quartet (modulo module names) and the encoding
     ignores qualification entirely; any byte difference in the
     relocations or a refusal names a qualification effect the
     ledger has never seen. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if na = nb then k = 1;
  put list('K=', k);
  stop;
end E49D3;
