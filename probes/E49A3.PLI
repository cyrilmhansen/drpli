E49A3:
  procedure options(main);
  /* [E2E-49/P1] the inverted compare with ^=.  [C072] pins DR's ^=
     skip byte as CA in every sampled family, and arm 4 lowered the
     FIXED TEST ^= as a [C072] SYNTHESIS: E48E7 measured C2 only,
     and C330 says so.  This probe measures the CA byte in the
     ?SCCCM family itself, with the member on the left. */
  dcl
    1 rec,
      2 name char(3),
      2 nxt fixed bin(15);
  dcl k fixed bin(15);
  if rec.name ^= 'AB' then k = 1;
  put list('K=', k);
  stop;
end E49A3;
