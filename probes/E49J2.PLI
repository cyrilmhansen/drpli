E49J2:
  procedure options(main);
  /* [E2E-49/P4] `^(rec.na < rec.nb)' -- negated STRICT relation,
     equal extents.  H-D-inv: F1's written-order stacked head
     (collapse 06 03 / 78) with the JNC d2 skip INVERTED to JC da;
     H-D-simpl rewrites `< ' to `>= ' -- same head, same da --
     again non-separable; H-D-extra: an extra branch or helper call
     distinguishes it. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if ^(rec.na < rec.nb) then k = 1;
  put list('K=', k);
  stop;
end E49J2;
