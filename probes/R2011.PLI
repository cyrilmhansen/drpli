R2011:
 procedure options(main);
   dcl i fixed;
   dcl j fixed;
   dcl k fixed;
   dcl r fixed;
   i = 3;
   j = 5;
   r = f2(i, j);
   put skip list(r);
   put skip list(i);

   f2: procedure (a,b) returns (fixed);
      declare (a,b) fixed;
      a = a + b;
      return (a);
   end f2;
   stop;
end R2011;
