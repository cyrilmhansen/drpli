E49G3:
  procedure options(main);
  /* [E2E-49/P4] ORDERED relation `> ' -- a SWAPPED relation per
     [C346] -- member LEFT, literal RIGHT, UNEQUAL attributes 3/2.
     H-A-sw: the swap lowers `'AB' < rec.na'-style pair order,
     literal FIRST, so the head becomes the DIRECT template and the
     position immediates are `06 02 / 3E 03' read off the LOWERED
     operands; H-A-or: member-written-left keeps the STAGED `EB'
     head with `06 03 / 3E 02' written-order positionals.  The byte
     pair at 000D..0012 decides.  Strict: JNC d2. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na > 'AB' then k = 1;
  put list('K=', k);
  stop;
end E49G3;
