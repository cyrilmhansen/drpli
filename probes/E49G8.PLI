E49G8:
  procedure options(main);
  /* [E2E-49/P4] `>= ' with literal LEFT, member RIGHT, equal
     attributes.  Written order again per the ORDER law, so both
     template hypotheses coincide on the direct head; collapse and
     skip byte are the open bytes.  Completion of the 4-relations x
     2-orientations literal matrix at equal attributes. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if 'ABC' >= rec.na then k = 1;
  put list('K=', k);
  stop;
end E49G8;
