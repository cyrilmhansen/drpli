E46M11:
  procedure options(main);
  /* [E2E-42/P2b] CHARACTER VARYING beside FIXED DECIMAL, both orders, FILE ONLY.  This is CREATE's zip-among-the-characters shape in its smallest form.  The CONSOLE route refuses a mixed character/decimal multi-item list today (the [E2E-29/P1] classifier admits literals, characters and BINARYs beside each other, not DECIMALS), so the console twin is E46M12 and not an unrelated refusal inside this object. */
  dcl outf file, v char(20) varying, z fixed dec(6);
  open file(outf) stream output title('M11OUT DAT');
  put file(outf) list(v,z);
  put file(outf) list(z,v);
  close file(outf);
end E46M11;
