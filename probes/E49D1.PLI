E49D1:
  procedure options(main);
  /* [E2E-49/P3] member-vs-member compare, BARE LEFT and QUALIFIED
     RIGHT (`na = rec.nb'), equal extents.  E49B1 measured the
     qualified-qualified head `21 *D(left) / E5 / 21 *D(right) / D1
     / 06 03 / 78 / CD ?SCCCM'; [C335] proved the [C253]/[C258]
     fold invisible to the encoding member-LEFT-of-literal.  If the
     fold is invisible here too the object equals E49B1 byte for
     byte but the module-name bytes; a PASS-2 refusal would be a
     new dr-refuses boundary. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if na = rec.nb then k = 1;
  put list('K=', k);
  stop;
end E49D1;
