E49E2:
  procedure options(main);
  /* [E2E-49/P3] E49E1 under ^= : the CA skip byte on an over-
     extent literal-left head -- the first object pairing those two
     attributes; E48E7 shows C2, E49A3 shows CA at 3/2.  The
     verdict of E49E1 governs; this row measures the skip byte if
     it accepts. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if 'ABCD' ^= rec.na then k = 1;
  put list('K=', k);
  stop;
end E49E2;
