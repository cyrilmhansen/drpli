E49H4:
  procedure options(main);
  /* [E2E-49/P4] `nb >= na' -- BARE/BARE, WRITTEN-order weak, and
     deliberately the SAME LOWERED operand order as F3's swap (nb
     first, na second).  H-B-invis predicts H4 byte-equals the
     E49F3 golden but module names: two DIFFERENT written spellings
     collapsing to ONE object is a strong transfer test of the
     ORDER law onto bare operands. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if nb >= na then k = 1;
  put list('K=', k);
  stop;
end E49H4;
