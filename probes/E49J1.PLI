E49J1:
  procedure options(main);
  /* [E2E-49/P4] NEGATED equality `^(rec.na = rec.nb)' -- FIRST
     acceptance probe for `^ ( )' on a FIXED CHARACTER string head
     (the numeric/fixed-bin NegL bank [C143] never touches
     strings).  If accepted: H-D-inv predicts the un-negated
     stacked head with skip C2 INVERTED to CA -- byte-identical to
     the E49B5 golden (`rec.na ^= rec.nb') but names; H-D-simpl
     (rewrite to ^=) gives the SAME bytes -- non-separable on this
     shape, stated.  H-D-extra shows extra branch/helper bytes;
     H-D-refuse is a DR boundary and then MY refusal stays.  NO De
     Morgan assumption. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if ^(rec.na = rec.nb) then k = 1;
  put list('K=', k);
  stop;
end E49J1;
