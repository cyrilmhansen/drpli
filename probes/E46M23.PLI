E46M23:
  procedure options(main);
  /* [E2E-42/P2b] THE SECOND-ITEM GUARD: an EXPRESSION in position 2.
     E46L9 pins `list(k + 1)' as a my-gap in position 1; here a
     character item precedes it, which is the shape a program would
     actually write. */
  dcl outf file, v char(20) varying, k fixed bin(15);
  open file(outf) stream output title('M23OUT DAT');
  put file(outf) list(v,k + 1);
  close file(outf);
end E46M23;
