E49J4:
  procedure options(main);
  /* [E2E-49/P4] `^(rec.na <= rec.s2)' -- negated SWAPPED WEAK
     relation, unequal extents.  H-D-inv: the I4 head (swap, `06 02
     / 3E 03') with the weak JC da inverted to strict JNC d2; H-D-
     simpl rewrites `<= ' to `> ' -- swapped too, same lowered
     head, same d2 -- non-separable.  The unequal-extent negated
     witness completes the matrix. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if ^(rec.na <= rec.s2) then k = 1;
  put list('K=', k);
  stop;
end E49J4;
