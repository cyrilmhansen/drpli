E49B1:
  procedure options(main);
  /* [E2E-49/P2] a FIXED member compared with ANOTHER FIXED member,
     equal extents, QUALIFIED both sides.  [C330] s3 and [C333] s3
     name member-vs-member as NO OBJECT; E49A1 staged its member-
     left cell through EB and E48E7 loaded its member-right cell
     straight into HL, so the recorded laws CANNOT predict this
     head -- Form S `21 *D(nb) / 11 *D(na)' versus Form M `21
     *D(na) / EB / 21 *D(nb)' both end HL on the right ([C191]).
     EB here or not is the measured answer. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na = rec.nb then k = 1;
  put list('K=', k);
  stop;
end E49B1;
