E49H6:
  procedure options(main);
  /* [E2E-49/P4] `s2 <= rec.na' -- BARE LEFT unequal extent,
     SWAPPED weak relation; the bare twin of Panel C's I5 (`rec.s2
     <= rec.na').  H-B-invis: swap loads na first, `06 03 / 3E 02',
     JC da.  Completion of the bare/qualified pair for the unequal-
     extent weak cell. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if s2 <= rec.na then k = 1;
  put list('K=', k);
  stop;
end E49H6;
