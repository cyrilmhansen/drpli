E49G1:
  procedure options(main);
  /* [E2E-49/P4] ORDERED relation `< ' with member LEFT, literal
     RIGHT, EQUAL attributes (char(3) vs 'ABC').  [C346] measured
     the relation family on QUALIFIED member pairs only; a literal
     operand in a relation has NO object.  `<' is written-order per
     the ORDER law, so H-A-sw and H-A-or predict the SAME staged
     template `21 *D / EB / 21 *D(pool)'; the discriminator is the
     equal-attribute COLLAPSE ([C342], keyed on the numbers, not
     the relation): 06 03 / 78 vs two immediates 06 03 / 3E 03.
     Strict skips JNC d2. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na < 'ABC' then k = 1;
  put list('K=', k);
  stop;
end E49G1;
