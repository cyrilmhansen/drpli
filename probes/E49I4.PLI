E49I4:
  procedure options(main);
  /* [E2E-49/P4] `rec.na <= rec.s2' -- swapped weak relation,
     unequal extents.  Swap loads s2 first: `06 02 / 3E 03'; weak
     JC da.  The weak unequal cell F4 could not separate (its
     written order was already short-first). */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na <= rec.s2 then k = 1;
  put list('K=', k);
  stop;
end E49I4;
