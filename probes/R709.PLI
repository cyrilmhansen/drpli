l709:
 procedure options(main);
   dcl r fixed dec(9,2);
   dcl b fixed dec(9,2);
   dcl n fixed dec(9,2);
   b = 3;
   n = 7;
   r = g(n) / b;
      g: procedure(j) returns(fixed dec(9,2));
      dcl j fixed dec(9,2);
      return (j);
   end g;
   put skip list(r);
   stop;
end l709;
