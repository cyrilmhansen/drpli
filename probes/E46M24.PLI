E46M24:
  procedure options(main);
  /* [E2E-42/P2b] THE SECOND-ITEM GUARD: the WHOLE ROW of an internal
     structure in position 2. The first item is fully authorized, so
     this isolates the structure-valued item. */
  dcl outf file, v char(20) varying;
  dcl 1 rec, 2 line char(14) varying, 2 nxt fixed bin(15);
  open file(outf) stream output title('M24OUT DAT');
  put file(outf) list(v,rec);
  close file(outf);
end E46M24;
