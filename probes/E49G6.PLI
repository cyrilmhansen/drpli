E49G6:
  procedure options(main);
  /* [E2E-49/P4] G5's INVERSION: `<= ' with the OVER-EXTENT literal
     LEFT, member RIGHT.  H-A-sw: lowered member-FIRST -- staged
     `EB' head, positionals `06 03 / 3E 04'; H-A-or: direct head,
     `06 04 / 3E 03'.  The pool must hold 'ABCD' whole iff [C345]
     transfers to relations -- a TRUNCATED pool literal or a
     min/max length reading falsifies it. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if 'ABCD' <= rec.na then k = 1;
  put list('K=', k);
  stop;
end E49G6;
