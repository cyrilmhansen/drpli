E49A4:
  procedure options(main);
  /* [E2E-49/P1] the inverted compare with an OVER-EXTENT literal,
     'ABCD' against char(3).  No object anywhere compares a fixed
     member with a longer literal: str_cmp_shape_fix's own comment
     records DR's verdict as [TBD] (not gated, matching the varying
     family's ungated MVI len arms), and [C191]'s truncation
     witness (E30T1, len 8 / cap 6) is a STORE.  This is a VERDICT
     question first: accept gives 06 04 / 3E 03 in the form this
     round selects; refuse makes it dr-refuses law. */
  dcl
    1 rec,
      2 name char(3),
      2 nxt fixed bin(15);
  dcl k fixed bin(15);
  if rec.name = 'ABCD' then k = 1;
  put list('K=', k);
  stop;
end E49A4;
