E49B2:
  procedure options(main);
  /* [E2E-49/P2] the member-vs-member compare with the operands
     INVERTED (E49B1 reversed).  Under either accepted form this
     object must equal E49B1 with the two member-cell relocations
     swapped in their slots -- if instead B1 and B2 come out byte-
     identical, the encoding does NOT follow the written side and
     [C334]'s positional law breaks for member pairs. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.nb = rec.na then k = 1;
  put list('K=', k);
  stop;
end E49B2;
