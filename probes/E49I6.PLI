E49I6:
  procedure options(main);
  /* [E2E-49/P4] `rec.na >= rec.s2' -- the written-order twin of F4
     at the same extents (3/2).  Expect `06 03 / 3E 02', JC da.
     With I1..I5 this completes 4 relations x 2 orientations x
     unequal extents; every row is compared against my arm-c
     baseline bytes, which the primary hypothesis says are ALREADY
     DR's bytes (NO arm). */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na >= rec.s2 then k = 1;
  put list('K=', k);
  stop;
end E49I6;
