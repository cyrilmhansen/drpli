E49F4:
  procedure options(main);
  /* [E2E-49/P3] ordered relation `>= ' with UNEQUAL extents and
     the SHORTER member on the LEFT.  The inversion pair of F2 for
     the positional law, and the fourth relation's own branch
     encoding; refusal of any row is DR's boundary, recorded as
     such. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.s2 >= rec.na then k = 1;
  put list('K=', k);
  stop;
end E49F4;
