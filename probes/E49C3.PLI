E49C3:
  procedure options(main);
  /* [E2E-49/P3] E49C1's shape under ^= : the CA skip byte in the
     equal-length member-left literal template ([C072]/[C333]
     measured CA in this family member-vs-literal 3/2 and member-
     vs-member 3/3; the equal literal case has no object).  Length
     collapse or not is the same A-panel discriminator as E49C1. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na ^= 'ABC' then k = 1;
  put list('K=', k);
  stop;
end E49C3;
