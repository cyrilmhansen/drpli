E49B4:
  procedure options(main);
  /* [E2E-49/P2] the INVERSION of E49B3: char(2) on the LEFT,
     char(3) on the RIGHT.  The positional law predicts the length
     pair SWAPPED with the operands (`06 02 / 3E 03'); a pair
     identical to E49B3's instead would show the lengths keyed by
     CLASS (e.g. shorter-in-B) and re-open [C330]'s falsified
     polarity reading for member pairs. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.s2 = rec.na then k = 1;
  put list('K=', k);
  stop;
end E49B4;
