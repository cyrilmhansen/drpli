E48E6:
  procedure options(main);
  /* [E2E-48/P2e] truthiness of an internal CHARACTER VARYING
     member used as a bare condition -- the E46K14 shape with a
     fresh module name.  NO golden of ANY program in this
     repository tests a character operand without a compare, so
     this probe decides whether my named refusal is a DR rule (dr-
     refuses) or a gap (my-gap). */
  dcl
    1 rec,
      2 line char(14) varying,
      2 nxt fixed bin(15);
  dcl k fixed bin(15);
  if line then k = 1;
  put list('K=', k);
  stop;
end E48E6;
