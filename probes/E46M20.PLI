E46M20:
  procedure options(main);
  /* [E2E-42/P2b] CREATE's six-item list with the members of a VISIBLE level-numbered RECORD, which is what RECORD.DCL declares.  This object is expected to refuse HERE at the FIXED DECIMAL MEMBER, not at the PUT: bind lays a decimal member out but registers no alias for it ([E2E-39/P2]'s registry is FIXED BINARY(15), POINTER and CHARACTER only).  It is probed because it is the only object that says whether DR accepts the member spelling at all, and because the refusal this compiler gives must be shown to come from bind and not from a PUT route this milestone chose to keep closed. */
  dcl outf file;
  dcl 1 record,
    2 name  char(30) varying,
    2 addr  char(30) varying,
    2 city  char(20) varying,
    2 state char(10) varying,
    2 zip   fixed dec(6),
    2 phone char(12) varying;
  open file(outf) stream output title('M20OUT DAT');
  put file(outf) list(name,addr,city,state,zip,phone);
  close file(outf);
end E46M20;
