E48D1:
  procedure options(main);
  /* [E2E-48/P2d] static CHARACTER VARYING as an OPEN TITLE operand, OUTPUT side -- E46F5's own shape, re-measured with a distinct module name so the object is a fresh witness. */
  dcl outf file,
      nm char(14) varying static initial('AB'),
      k fixed bin(15);
  open file(outf) stream output title(nm);
  put file(outf) list('X');
  close file(outf);
  stop;
end E48D1;
