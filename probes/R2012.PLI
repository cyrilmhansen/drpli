R2012:
 procedure options(main);
   dcl i fixed;
   dcl j fixed;
   dcl k fixed;
   dcl r fixed;
   dcl s fixed;
   i = 3;
   j = 5;
   r = f2(i, j);
   s = f2(j, i);
   put skip list(r);
   put skip list(s);

   f2: procedure (a,b) returns (fixed);
      declare (a,b) fixed;
      return (a - b);
   end f2;
   stop;
end R2012;
