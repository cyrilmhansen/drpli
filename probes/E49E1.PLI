E49E1:
  procedure options(main);
  /* [E2E-49/P3] literal LEFT, longer than the extent: 'ABCD' vs
     rec.na char(3).  E49A4 measured the INVERSE orientation
     (member LEFT, literal RIGHT: [C336] ACCEPTED, literal pooled
     WHOLE, positional `06 03 / 3E 04') and P1 RESULTS s2.6
     explicitly refuses to extrapolate to this one.  H-CE accepts
     on E48E7's direct template with positional lengths `06 04 / 3E
     03' and the full pool; falsifiers: refusal, a TRUNCATED pool
     literal, or min/max length readings. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if 'ABCD' = rec.na then k = 1;
  put list('K=', k);
  stop;
end E49E1;
