E49F2:
  procedure options(main);
  /* [E2E-49/P3] ordered relation `> ' with UNEQUAL extents
     (char(3) vs char(2)).  If accepted with immediates, [C334]'s
     positional law predicts B = LEFT extent 3, A = RIGHT extent 2;
     min/max/keyed readings are the falsifiers -- the same
     discriminators E49B3/B4 killed for =, re-tested here because
     no transfer may be assumed. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na > rec.s2 then k = 1;
  put list('K=', k);
  stop;
end E49F2;
