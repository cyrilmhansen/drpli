E49H5:
  procedure options(main);
  /* [E2E-49/P4] `na > rec.s2' -- the BARE-LEFT twin of E49F2
     (unequal extents 3/2, swapped, strict). H-B-invis predicts the
     F2 golden's head exactly: swapped loads s2 first, positional
     `06 02 / 3E 03' on the LOWERED operands, JNC d2, two
     immediates (no collapse at unequal lengths).  Any refusal or
     byte drift falsifies [C344]-transfer for relations. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if na > rec.s2 then k = 1;
  put list('K=', k);
  stop;
end E49H5;
