E49C4:
  procedure options(main);
  /* [E2E-49/P3] E49C2's shape under ^= : CA skip on the literal-
     left equal-length head.  Kept as its own witness so the skip
     byte is measured in BOTH orientations at equal lengths,
     independent of what C1/C2 show. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if 'ABC' ^= rec.na then k = 1;
  put list('K=', k);
  stop;
end E49C4;
