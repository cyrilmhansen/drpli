E49H2:
  procedure options(main);
  /* [E2E-49/P4] qualified LEFT, BARE RIGHT, SWAPPED relation:
     `rec.na > nb' (3/3 written, equal extents).  Twin built from
     the laws: `> ' swaps, collapse 06 03 / 78 survives the swap
     (keyed on numbers, [C346]), strict JNC d2.  A PASS-2 refusal
     here would be a qualification gate INSIDE the relation family
     only -- invisible to =/^= per [C344] -- a first-class DR
     boundary, not noise. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na > nb then k = 1;
  put list('K=', k);
  stop;
end E49H2;
