R2005:
 procedure options(main);
   dcl i fixed;
   dcl j fixed;
   dcl k fixed;
   dcl r fixed;
   i = 1;
   j = 2;
   k = 3;
   r = 9;
   r = f4(i, j, k, r);
   put skip list(r);

   f4: procedure (a,b,c,d) returns (fixed);
      declare (a,b,c,d) fixed;
      return (a + b + c + d);
   end f4;
   stop;
end R2005;
