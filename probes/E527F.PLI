E527F: procedure options(main);
   /* [E2E-53/P3] H-E: IMPLICIT label-constant array with       */
   /* DISTINCT label values.  LABELS pins only the degenerate   */
   /* all-equal DATA init (c(1..3) -> 8D 00 x3 at data@0000)    */
   /* and the dynamic read (007E-008C).  Prediction: cells      */
   /* data@0000,0002,0004 = addresses of lab1/lab2/lab3 entry   */
   /* points, static DATA records.                              */
   dcl i fixed;
   i = 2;
   goto c(i);
 lab1:;
 lab2:;
 lab3:;
   stop;
end E527F;
