l724:
 procedure options(main);
   dcl a fixed dec(9,2);
   dcl b fixed dec(9,2);
   dcl d fixed dec(9,2);
   dcl f fixed dec(9,2);
   dcl c fixed dec(9,2);
   dcl g fixed dec(9,2);
   a = 7;
   b = 3;
   d = 2;
   f = 5;
   c = (a + b) * (d + f);
   g = a + b + d;
   put skip list(c, g);
   stop;
end l724;
