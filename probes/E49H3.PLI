E49H3:
  procedure options(main);
  /* [E2E-49/P4] BARE/BARE in a SWAPPED weak relation: `na <= nb'
     (3/3).  Twin: swap loads nb first, collapse 06 03 / 78, weak
     JC da -- the bare twin of the E49F3 shape modulo names. All
     three spellings accepted => the relation encoder ignores
     qualification entirely, exactly as [C344] found for =/^=. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if na <= nb then k = 1;
  put list('K=', k);
  stop;
end E49H3;
