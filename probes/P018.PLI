p018: procedure options(main);
   /* ON/SIGNAL numeric designators + ONCODE vs RTL "(n)" suffixes */
   declare n fixed;
   n = 0;
   on error(1) begin;
      n = n + 1;
      put skip list('handler1 oncode=', oncode());
   end;
   on error begin;
      put skip list('general oncode=', oncode());
   end;
   signal error(1);
   put skip list('n=', n);
   n = 65536;
   put skip list('after conv err n=', n);
end p018;
