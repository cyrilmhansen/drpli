E49A1:
  procedure options(main);
  /* [E2E-49/P1] operand inversion of golden/e48p2e/E48E7 [C330].
     That object's single reading is ambiguous: HL carried the
     member, which was BOTH the right operand ([C191]'s "HL =
     right") and the internal cell ([C326]'s wording), and A
     carried the extent while B carried the literal length, class-
     and position-readings alike.  Here the member is written on
     the LEFT; [C330] itself names "the FIXED member on the LEFT of
     a TEST" as having no object. */
  dcl
    1 rec,
      2 name char(3),
      2 nxt fixed bin(15);
  dcl k fixed bin(15);
  if rec.name = 'AB' then k = 1;
  put list('K=', k);
  stop;
end E49A1;
