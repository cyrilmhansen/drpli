E49B5:
  procedure options(main);
  /* [E2E-49/P2] the member-vs-member compare with ^=.  [C333]
     measured the CA skip byte in the ?SCCCM family only member-vs-
     LITERAL (E49A3); [C072] says CA everywhere.  This measures the
     skip byte on a member-vs-member head -- same head as E49B1's
     winner, skip 0xca, fill = the next statement ([C309]). */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na ^= rec.nb then k = 1;
  put list('K=', k);
  stop;
end E49B5;
