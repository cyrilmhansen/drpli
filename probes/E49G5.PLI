E49G5:
  procedure options(main);
  /* [E2E-49/P4] `<= ' -- a SWAPPED weak relation -- member LEFT,
     literal RIGHT, literal OVER-EXTENT (char(3) vs 'ABCD').
     Combines TWO unmeasured boundaries: the relation-with-literal
     family and over-extent under a relation ([C345] measured over-
     extent WHOLE-POOL for = only, in the written orientation).
     H-A-sw: lowered literal-FIRST, direct head, `06 04 / 3E 03';
     H-A-or: staged head, `06 03 / 3E 04'.  Weak skips JC da.
     Refusal of the over-extent spelling here would be a relation-
     specific [C336]/[C345] boundary. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na <= 'ABCD' then k = 1;
  put list('K=', k);
  stop;
end E49G5;
