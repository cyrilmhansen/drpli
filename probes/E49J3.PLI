E49J3:
  procedure options(main);
  /* [E2E-49/P4] `^('ABC' = rec.na)' -- negated equality on the
     LITERAL-LEFT DIRECT template, equal attributes.  H-D-inv: C2's
     direct head with C2-skip inverted to CA -- byte-equal to the
     E49C4 golden (`'ABC' ^= rec.na') but names; tests the collapse
     too (06 03 / 78, [C342] in the negated form).  Refusal here
     with acceptance in J1/J2 would name a literal-specific
     boundary on the composition. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if ^('ABC' = rec.na) then k = 1;
  put list('K=', k);
  stop;
end E49J3;
