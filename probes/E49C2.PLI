E49C2:
  procedure options(main);
  /* [E2E-49/P3] the INVERSION of E49C1: literal LEFT, member
     RIGHT, lengths EQUAL.  E48E7 (2/3) carried `21 *D(member) / 11
     *D(pool) / 06 02 / 3E 03' -- direct, no EB, CODE 65.  No
     shared rule is presupposed with E49C1: H-AK-L keeps `06 03 /
     3E 03' (CODE 65); H-AC-L collapses to `06 03 / 78' (CODE 64).
     A split verdict between the two orientations is a first-class
     outcome. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if 'ABC' = rec.na then k = 1;
  put list('K=', k);
  stop;
end E49C2;
