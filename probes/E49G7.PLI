E49G7:
  procedure options(main);
  /* [E2E-49/P4] `>= ' -- WRITTEN order per the [C346] ORDER law --
     member LEFT, literal RIGHT, equal attributes.  H-A-sw and H-A-
     or predict the SAME staged template here; the discriminators
     are the COLLAPSE (06 03 / 78 iff [C342] keys on numbers in
     this template too) and the weak skip byte JC da.  Fourth
     relation's own witness. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na >= 'ABC' then k = 1;
  put list('K=', k);
  stop;
end E49G7;
