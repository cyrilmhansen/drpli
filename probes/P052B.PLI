p052b: procedure options(main);
   declare z fixed, w bit(4), v bit(2);
   z = 5 ^= 3;
   put list('z1=', z);
   z = 5 ^= 5;
   put list('z2=', z);
   z = 3 ^= 1;
   put list('z3=', z);
   w = '1111'b ^= '0110'b;
   put list('w=', w);
   v = '10'b ^= '10'b;
   put list('v=', v);
   put list('chain=', 7 ^= 2 ^= 1);
end p052b;
