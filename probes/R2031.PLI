lR2031:
 procedure options(main);
   dcl i fixed;
   dcl j fixed;
   dcl k fixed;
   dcl r fixed;
   dcl s fixed;
   i = 3;
   j = 5;
   r = f2(i, j);
   put skip list(r);
   stop;
   f2: procedure (a,b) returns (fixed);
      declare (a,b) fixed;
      return (a + b);
   end f2;

end lR2031;
