E49F3:
  procedure options(main);
  /* [E2E-49/P3] ordered relation `<= ' between equal-extent
     members.  A distinct skip byte or helper from F1 is possible
     -- the four relations are not one mechanism.  Verdict, helper,
     lengths and branch are each measured independently in the
     object. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na <= rec.nb then k = 1;
  put list('K=', k);
  stop;
end E49F3;
