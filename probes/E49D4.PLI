E49D4:
  procedure options(main);
  /* [E2E-49/P3] BARE fixed member to the RIGHT of a literal (`'AB'
     = na') -- the P1 asymmetry: E49A2 admitted bare LEFT-of-
     literal ([C335]) and P1 RESULTS s2.4 scopes that finding to
     the left side; E48E7's literal-left route has only ever been
     sampled QUALIFIED.  If accepted, byte-identical to E48E7 but
     the module name; if refused, the asymmetry becomes a measured
     DR law instead of an untested mirror. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if 'AB' = na then k = 1;
  put list('K=', k);
  stop;
end E49D4;
