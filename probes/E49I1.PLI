E49I1:
  procedure options(main);
  /* [E2E-49/P4] `rec.na < rec.s2' -- unequal extents 3/2, WRITTEN
     order (strict).  [C346]'s F2/F4 pair sampled `>' and `>= '
     only; `< ' unequal and the weak relations unequal have NO
     object.  Primary: DR accepts and the laws transfer -- stacked
     head `21 *D(na) / E5 / 21 *D(s2) / D1 / 06 03 / 3E 02 / CD
     ?SCCCM', JNC d2, CODE 67, DATA 000C -- EQUAL to my arm-c
     baseline; falsified by refusal or any byte drift. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na < rec.s2 then k = 1;
  put list('K=', k);
  stop;
end E49I1;
