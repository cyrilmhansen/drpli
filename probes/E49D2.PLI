E49D2:
  procedure options(main);
  /* [E2E-49/P3] the mirror: QUALIFIED LEFT, BARE RIGHT (`rec.na =
     nb').  Same alternatives as E49D1; an acceptance here with
     refusal there (or vice versa) is an orientation-specific
     qualification boundary -- exactly the shape of P1's asymmetry
     and a first-class reading, not noise. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.na = nb then k = 1;
  put list('K=', k);
  stop;
end E49D2;
