E49I3:
  procedure options(main);
  /* [E2E-49/P4] `rec.s2 > rec.na' -- the INVERSION PAIR of E49F2:
     same relation `>', extents swapped in writing.  `> ' is
     lowered SWAPPED, so na loads first: `06 03 / 3E 02', JNC d2.
     This row re-tests whether lengths follow the lowered operands
     in the OTHER unequal orientation (F2 measured one direction of
     the swap only). */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if rec.s2 > rec.na then k = 1;
  put list('K=', k);
  stop;
end E49I3;
