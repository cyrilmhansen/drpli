E49G4:
  procedure options(main);
  /* [E2E-49/P4] G3's INVERSION: `> ' with literal LEFT, member
     RIGHT, 2/3 written.  H-A-sw: the swap lowers member-FIRST --
     the STAGED `EB' head with positionals `06 03 / 3E 02'; H-A-or:
     direct literal-left head with `06 02 / 3E 03'.  Together with
     G3 this row tests whether the swap REKEYS the template choice
     or only the operand order. */
  dcl
    1 rec,
      2 na char(3),
      2 nb char(3),
      2 s2 char(2);
  dcl k fixed bin(15);
  if 'AB' > rec.na then k = 1;
  put list('K=', k);
  stop;
end E49G4;
