/* BUILTIN-00 - ORIGINAL DRPLi work (FC-01 hop 4 REV2,       */
/* 2026-11-02).  BLOCKER PROBE: the LENGTH built-in.  Rev1    */
/* stored t = substr(s,1,3) FIRST and the CHAR-STORE          */
/* refusal ('char store from non-literal') fired BEFORE the   */
/* built-in path (build/fc01/batchB, hop 3).  Rev2 drops the  */
/* SUBSTR store and calls n = length(s) before any            */
/* non-literal char store, so the built-in refusal ITSELF is  */
/* what is measured.  Every documented built-in except ADDR   */
/* and bare NULL is a MEASURED MY-COMPILER refusal            */
/* (spec/coverage-builtin-sweep.tsv; BUILTIN.DOCUMENTED_SET   */
/* is PARTIAL).  Deliverable: typed COMPILE FAIL, message     */
/* verbatim (README sec 9).  FUTURE design: LENGTH of         */
/* char(10) is the EXTENT 10.  Framing blank per [C352];      */
/* derived, never captured (L3).                              */
builtin0: procedure options(main);
  declare s char(10);
  declare n fixed bin;
  n = length(s);
  s = 'hello';
  put skip list('LEN=', n);
  stop;
end builtin0;
