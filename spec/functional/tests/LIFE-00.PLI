/* LIFE-00 - FC-01 corpus adaptation, 2026-11-03.           */
/* Original: BASIC "LIFE" (LIFE.bas), Creative Computing     */
/* MORRISTOWN NJ.  Research copy: build/functional/          */
/* fc01-sources/basic/LIFE.bas (upstream                     */
/* coding-horror/basic-computer-games 55_Life, sha256        */
/* e268ed69..., licence UNVERIFIED - recorded as             */
/* unverified, not asserted).  ADAPTATION (full removal/     */
/* substitution list is in LIFE-00.json notes): the INPUT/   */
/* DONE/B$/LEN/LEFT$/RIGHT$/MID$ pattern phase is DROPPED    */
/* (character GET UNMEASURED) and replaced by 18 literal     */
/* seed stores (glider, beacon, block, blinker, shifted 2    */
/* columns right); the 24x70 grid becomes a declared 12x30   */
/* window in ONE flat padded array a(448), index n = x*32    */
/* + y + 1; the dynamic bounding box, the 301..307 clamps    */
/* and the INVALID! flag are DROPPED (whole-window scan);    */
/* the generation count is BOUNDED at 6 (upstream never      */
/* terminates); TAB banner offsets dropped; dead cells       */
/* render '.' (declared cosmetic divergence, positional      */
/* tokens under collapse-spaces-v1); every put list is       */
/* single-item under the MEASURED leading-blank separator    */
/* law; neighbour sums count the 3x3 INCLUDING the centre    */
/* exactly as BASIC 530..550.  Expected stream:              */
/* reference.py:life00, derived, never captured.             */
life00: procedure options(main);
  declare (x, y, i, n, g, s, cs, v, t1, t2) fixed bin(15);
  declare (n1, n2, n3, n4, n5, n6, n7, n8) fixed bin(15);
  declare a(448) fixed bin(15);
  do i = 1 to 448;
     a(i) = 0;
  end;
  a(69) = 1;
  a(77) = 1;
  a(78) = 1;
  a(102) = 1;
  a(109) = 1;
  a(132) = 1;
  a(133) = 1;
  a(134) = 1;
  a(144) = 1;
  a(175) = 1;
  a(176) = 1;
  a(274) = 1;
  a(306) = 1;
  a(338) = 1;
  a(348) = 1;
  a(349) = 1;
  a(380) = 1;
  a(381) = 1;
  cs = 0;
  do x = 1 to 12;
     n = x * 32 + 1;
     do y = 1 to 30;
        n = n + 1;
        t1 = a(n);
        if t1 = 1 then cs = cs + 1;
     end;
  end;
  put list('LIFE');
  put skip;
  put list('CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY');
  put skip;
  put skip;
  put skip;
  put skip;
  do g = 0 to 5;
     put skip;
     put list('GENERATION');
     put list(g);
     put list('POPULATION');
     put list(cs);
     put skip;
     do x = 1 to 12;
        n = x * 32 + 1;
        do y = 1 to 30;
           n = n + 1;
           t1 = a(n);
           v = 0;
           if t1 = 1 then v = 1;
           if t1 = 3 then v = 1;
           call cellprint(v);
           if t1 = 2 then a(n) = 0;
           if t1 = 3 then a(n) = 1;
        end;
        put skip;
     end;
     cs = 0;
     do x = 1 to 12;
        n = x * 32 + 1;
        do y = 1 to 30;
           n = n + 1;
           t1 = a(n);
           s = 0;
           t2 = a(n);
           if t2 = 1 then s = s + 1;
           n1 = n - 33;
           t2 = a(n1);
           if t2 = 1 then s = s + 1;
           if t2 = 2 then s = s + 1;
           n2 = n - 32;
           t2 = a(n2);
           if t2 = 1 then s = s + 1;
           if t2 = 2 then s = s + 1;
           n3 = n - 31;
           t2 = a(n3);
           if t2 = 1 then s = s + 1;
           if t2 = 2 then s = s + 1;
           n4 = n - 1;
           t2 = a(n4);
           if t2 = 1 then s = s + 1;
           if t2 = 2 then s = s + 1;
           n5 = n + 1;
           t2 = a(n5);
           if t2 = 1 then s = s + 1;
           if t2 = 2 then s = s + 1;
           n6 = n + 31;
           t2 = a(n6);
           if t2 = 1 then s = s + 1;
           if t2 = 2 then s = s + 1;
           n7 = n + 32;
           t2 = a(n7);
           if t2 = 1 then s = s + 1;
           if t2 = 2 then s = s + 1;
           n8 = n + 33;
           t2 = a(n8);
           if t2 = 1 then s = s + 1;
           if t2 = 2 then s = s + 1;
           if t1 = 0 then do;
              if s = 3 then a(n) = 3;
              if s = 3 then cs = cs + 1;
           end;
           if t1 = 1 then do;
              a(n) = 2;
              if s = 3 then a(n) = 1;
              if s = 4 then a(n) = 1;
              if s = 3 then cs = cs + 1;
              if s = 4 then cs = cs + 1;
           end;
        end;
     end;
  end;
  put skip;
  stop;
cellprint: procedure (q);
  declare q fixed bin(15);
  declare ch character(1) varying;
  if q = 1 then ch = '*';
  if q = 0 then ch = '.';
  put list(ch);
end cellprint;
end life00;
