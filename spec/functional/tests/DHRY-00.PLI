/* DHRY-00: Dhrystone 2.1 (Pascal) adapted to the PL/I-80 subset.
   Chars, enums and booleans are integer codes; the two records are
   parallel arrays over sx(180); VAR parameters use result cells;
   DIV is a subtraction loop; timing and reals are dropped. */
dhry00: procedure options(main);
  declare (intglob, int1g, int2g, int3g) fixed bin(15);
  declare (boolg, char1g, char2g, enumg) fixed bin(15);
  declare (numruns, runidx, ci, z, tv) fixed bin(15);
  declare (dvq, r2, r3, r6, r7) fixed bin(15);
  declare a1(50) fixed bin(15);
  declare a2(2500) fixed bin(15);
  declare sx(180) fixed bin(15);
  declare pcp(2) fixed bin(15);
  declare dsc(2) fixed bin(15);
  declare enm(2) fixed bin(15);
  declare inc(2) fixed bin(15);
  do z = 1 to 180; sx(z) = 0; end;
  do z = 1 to 50; a1(z) = 0; end;
  do z = 1 to 2500; a2(z) = 0; end;
  pcp(1) = 0; pcp(2) = 0; dsc(1) = 0; dsc(2) = 0;
  enm(1) = 0; enm(2) = 0; inc(1) = 0; inc(2) = 0;
  sx(1) = 68; sx(2) = 72; sx(3) = 82; sx(4) = 89;
  sx(5) = 83; sx(6) = 84; sx(7) = 79; sx(8) = 78;
  sx(9) = 69; sx(10) = 32; sx(11) = 80; sx(12) = 82;
  sx(13) = 79; sx(14) = 71; sx(15) = 82; sx(16) = 65;
  sx(17) = 77; sx(18) = 44; sx(19) = 32; sx(20) = 83;
  sx(21) = 79; sx(22) = 77; sx(23) = 69; sx(24) = 32;
  sx(25) = 83; sx(26) = 84; sx(27) = 82; sx(28) = 73;
  sx(29) = 78; sx(30) = 71;
  sx(61) = 68; sx(62) = 72; sx(63) = 82; sx(64) = 89;
  sx(65) = 83; sx(66) = 84; sx(67) = 79; sx(68) = 78;
  sx(69) = 69; sx(70) = 32; sx(71) = 80; sx(72) = 82;
  sx(73) = 79; sx(74) = 71; sx(75) = 82; sx(76) = 65;
  sx(77) = 77; sx(78) = 44; sx(79) = 32; sx(80) = 49;
  sx(81) = 83; sx(82) = 84; sx(83) = 32; sx(84) = 83;
  sx(85) = 84; sx(86) = 82; sx(87) = 73; sx(88) = 78;
  sx(89) = 71; sx(90) = 32;
  sx(121) = 68; sx(122) = 72; sx(123) = 82; sx(124) = 89;
  sx(125) = 83; sx(126) = 84; sx(127) = 79; sx(128) = 78;
  sx(129) = 69; sx(130) = 32; sx(131) = 80; sx(132) = 82;
  sx(133) = 79; sx(134) = 71; sx(135) = 82; sx(136) = 65;
  sx(137) = 77; sx(138) = 44; sx(139) = 32; sx(140) = 50;
  sx(141) = 78; sx(142) = 68; sx(143) = 32; sx(144) = 83;
  sx(145) = 84; sx(146) = 82; sx(147) = 73; sx(148) = 78;
  sx(149) = 71; sx(150) = 32;
  sx(151) = 68; sx(152) = 72; sx(153) = 82; sx(154) = 89;
  sx(155) = 83; sx(156) = 84; sx(157) = 79; sx(158) = 78;
  sx(159) = 69; sx(160) = 32; sx(161) = 80; sx(162) = 82;
  sx(163) = 79; sx(164) = 71; sx(165) = 82; sx(166) = 65;
  sx(167) = 77; sx(168) = 44; sx(169) = 32; sx(170) = 51;
  sx(171) = 82; sx(172) = 68; sx(173) = 32; sx(174) = 83;
  sx(175) = 84; sx(176) = 82; sx(177) = 73; sx(178) = 78;
  sx(179) = 71; sx(180) = 32;
  pcp(1) = 2; dsc(1) = 0; enm(1) = 2; inc(1) = 40;
  a2(357) = 10;
  put skip;
  put list('Dhrystone Benchmark, Version 2.1 (Language: Pascal)');
  put skip;
  put skip;
  put list('Please give the number of runs through the benchmark:');
  put skip;
  get list(numruns);
  put skip;
  put list('Execution starts,');
  put list(numruns);
  put list('runs through Dhrystone');
  put skip;
  do runidx = 1 to numruns;
    call proc5;
    call proc4;
    int1g = 2;
    int2g = 3;
    call cp30(120, 90);
    enumg = 1;
    tv = f2(60, 90);
    boolg = 0;
    if tv = 0 then boolg = 1;
    do while int1g < int2g;
      int3g = 5 * int1g - int2g;
      call proc7(int1g, int2g);
      int3g = r7;
      int1g = int1g + 1;
    end;
    call proc8(int1g, int3g);
    call proc1(1);
    do ci = 65 to char2g;
      tv = f1(ci, 67);
      if enumg = tv then do;
        call proc6(0);
        enumg = r6;
        call cp30(150, 90);
        int2g = runidx;
        intglob = runidx;
      end;
    end;
    int2g = int2g * int1g;
    call divsub(int2g, int3g);
    int1g = dvq;
    tv = int2g - int3g;
    tv = 7 * tv;
    int2g = tv - int1g;
    call proc2(int1g);
    int1g = r2;
  end;
  put list('Execution ends');
  put skip;
  put list('Final values of the variables used in the benchmark:');
  put skip;
  put skip;
  put list('IntGlob:');
  put list(intglob);
  put skip;
  put list('should be:');
  put list('5');
  put skip;
  put list('Array1Glob [8]:');
  tv = a1(8);
  put list(tv);
  put skip;
  put list('should be:');
  put list('7');
  put skip;
  put list('Array2Glob [8,7]:');
  tv = a2(357);
  put list(tv);
  put skip;
  put list('should be:');
  tv = numruns + 10;
  put list(tv);
  put skip;
  put list('PointerGlob^.Discr:');
  tv = dsc(1);
  put list(tv);
  put skip;
  put list('should be:');
  put list('0');
  put skip;
  put list('PointerGlob^.EnumComp:');
  tv = enm(1);
  put list(tv);
  put skip;
  put list('should be:');
  put list('2');
  put skip;
  put list('PointerGlob^.IntComp:');
  tv = inc(1);
  put list(tv);
  put skip;
  put list('should be:');
  put list('17');
  put skip;
  put list('NextPointerGlob^.Discr:');
  tv = dsc(2);
  put list(tv);
  put skip;
  put list('should be:');
  put list('0');
  put skip;
  put list('NextPointerGlob^.EnumComp:');
  tv = enm(2);
  put list(tv);
  put skip;
  put list('should be:');
  put list('1');
  put skip;
  put list('NextPointerGlob^.IntComp:');
  tv = inc(2);
  put list(tv);
  put skip;
  put list('should be:');
  put list('18');
  put skip;
  put list('Int1Glob:');
  put list(int1g);
  put skip;
  put list('should be:');
  put list('5');
  put skip;
  put list('Int2Glob:');
  put list(int2g);
  put skip;
  put list('should be:');
  put list('13');
  put skip;
  put list('Int3Glob:');
  put list(int3g);
  put skip;
  put list('should be:');
  put list('7');
  put skip;
  put list('EnumGlob:');
  put list(enumg);
  put skip;
  put list('should be:');
  put list('1');
  put skip;
  put list('BoolGlob:');
  if boolg = 1 then put list('TRUE');
  else put list('FALSE');
  put skip;
  put list('should be:');
  put list('TRUE');
  put skip;
  put list('Char1Glob:');
  call putc(char1g);
  put skip;
  put list('should be:');
  put list('A');
  put skip;
  put list('Char2Glob:');
  call putc(char2g);
  put skip;
  put list('should be:');
  put list('B');
  put skip;
  put list('PointerGlob^.StringComp:');
  put skip;
  call putstr(0);
  put skip;
  put list('should be:');
  put list('DHRYSTONE PROGRAM, SOME STRING');
  put skip;
  put list('NextPointerGlob^.StringComp:');
  put skip;
  call putstr(30);
  put skip;
  put list('should be:');
  put list('DHRYSTONE PROGRAM, SOME STRING');
  put skip;
  put list('String1Glob:');
  put skip;
  call putstr(60);
  put skip;
  put list('should be:');
  put list('DHRYSTONE PROGRAM, 1ST STRING');
  put skip;
  put list('String2Glob:');
  put skip;
  call putstr(90);
  put skip;
  put list('should be:');
  put list('DHRYSTONE PROGRAM, 2ND STRING');
  put skip;
  put skip;
  put skip;
  stop;
proc5: procedure;
  char1g = 65;
  boolg = 0;
end proc5;
proc4: procedure;
  declare bl fixed bin(15);
  bl = 0;
  if char1g = 65 then bl = 1;
  if bl = 1 then boolg = 1;
  char2g = 66;
end proc4;
proc7: procedure (p7v1, p7v2);
  declare (p7v1, p7v2) fixed bin(15);
  declare il7 fixed bin(15);
  il7 = p7v1 + 2;
  r7 = p7v2 + il7;
end proc7;
proc8: procedure (p8v1, p8v2);
  declare (p8v1, p8v2) fixed bin(15);
  declare (l8, v82, p18, p38, b8, h8, ix8, ix2, v22, m8) fixed bin(15);
  declare (k8, b28, t8) fixed bin(15);
  l8 = p8v1 + 5;
  v82 = p8v2;
  a1(l8) = v82;
  p18 = l8 + 1;
  a1(p18) = a1(l8);
  p38 = l8 + 30;
  a1(p38) = l8;
  b8 = (l8 - 1) * 50;
  h8 = l8 + 2;
  ix8 = l8;
p8a:
  ix2 = b8 + ix8;
  a2(ix2) = l8;
  ix8 = ix8 + 1;
  if ix8 < h8 then goto p8a;
p8b:
  m8 = l8 - 1;
  ix2 = b8 + m8;
  v22 = ix2;
  t8 = a2(v22);
  t8 = t8 + 1;
  a2(v22) = t8;
  k8 = l8 + 20;
  b28 = (k8 - 1) * 50;
  ix2 = b28 + l8;
  a2(ix2) = a1(l8);
  intglob = 5;
end proc8;
proc1: procedure (pv);
  declare pv fixed bin(15);
  declare (p1a, r1a, d1a, tv1) fixed bin(15);
  p1a = pv;
  r1a = pcp(p1a);
  d1a = (r1a - 1) * 30;
  dsc(r1a) = dsc(1);
  enm(r1a) = enm(1);
  inc(r1a) = inc(1);
  pcp(r1a) = pcp(1);
  call cp30(0, d1a);
  inc(p1a) = 5;
  inc(r1a) = inc(p1a);
  pcp(r1a) = pcp(p1a);
  call proc3(r1a);
  tv1 = dsc(r1a);
  if tv1 = 0 then do;
    inc(r1a) = 6;
    call proc6(enm(p1a));
    enm(r1a) = r6;
    pcp(r1a) = pcp(1);
    tv1 = inc(r1a);
    call proc7(tv1, 10);
    inc(r1a) = r7;
  end;
end proc1;
proc3: procedure (p3tgt);
  declare p3tgt fixed bin(15);
  declare (t3a, t3b) fixed bin(15);
  t3a = pcp(1);
  t3b = p3tgt;
  r3 = 0;
  if t3a = 1 then r3 = 1;
  if t3a = 2 then r3 = 2;
  pcp(t3b) = r3;
  call proc7(10, intglob);
  inc(1) = r7;
end proc3;
proc6: procedure (p6ev);
  declare p6ev fixed bin(15);
  declare (e6, t6) fixed bin(15);
  e6 = p6ev;
  r6 = e6;
  t6 = f3(e6);
  if t6 = 0 then r6 = 3;
  if e6 = 0 then r6 = 0;
  if e6 = 1 then do;
    if intglob > 100 then r6 = 0;
    if intglob < 101 then r6 = 3;
  end;
  if e6 = 2 then r6 = 1;
  if e6 = 4 then r6 = 2;
end proc6;
proc2: procedure (pv2);
  declare pv2 fixed bin(15);
  declare (il2b, el2) fixed bin(15);
  il2b = pv2 + 10;
  el2 = 1;
p2t:
  if char1g = 65 then do;
    il2b = il2b - 1;
    r2 = il2b - intglob;
    el2 = 0;
  end;
  if el2 = 0 then goto p2x;
  goto p2t;
p2x:
end proc2;
f1: procedure (c1v, c2v) returns(fixed bin(15));
  declare (c1v, c2v) fixed bin(15);
  declare (cl1, cl2, rv1) fixed bin(15);
  cl1 = c1v;
  cl2 = cl1;
  rv1 = 0;
  if cl2 = c2v then do;
    char1g = cl1;
    rv1 = 1;
  end;
  return (rv1);
end f1;
f2: procedure (b1v, b2v) returns(fixed bin(15));
  declare (b1v, b2v) fixed bin(15);
  declare (ilf, clf, sgf, dif, c1f, c2f, sp1, sp2, rvf) fixed bin(15);
  declare (k1f, v1f, v2f) fixed bin(15);
  v1f = b1v;
  v2f = b2v;
  rvf = 0;
  ilf = 2;
  clf = 0;
f2l:
  if ilf > 2 then goto f2x;
  sp1 = v1f + ilf;
  c1f = sx(sp1);
  sp2 = v2f + ilf;
  c2f = sx(sp2);
  if c1f < c2f then goto f2e;
  if c1f > c2f then goto f2e;
  clf = 65;
  ilf = ilf + 1;
  goto f2l;
f2x:
f2e:
  if clf > 86 then do;
    if clf < 90 then ilf = 7;
  end;
  if clf = 82 then do;
    rvf = 1;
    return (rvf);
  end;
  sgf = 0;
  dif = 0;
  do k1f = 1 to 30;
    sp1 = v1f + k1f;
    c1f = sx(sp1);
    sp2 = v2f + k1f;
    c2f = sx(sp2);
    if dif = 0 then do;
      if c1f < c2f then dif = 2;
      if c1f > c2f then do;
        dif = 1;
        sgf = 1;
      end;
    end;
  end;
  if sgf = 1 then do;
    ilf = ilf + 7;
    intglob = ilf;
    rvf = 1;
  end;
  return (rvf);
end f2;
f3: procedure (f3ev) returns(fixed bin(15));
  declare f3ev fixed bin(15);
  declare (e3, rv3) fixed bin(15);
  e3 = f3ev;
  rv3 = 0;
  if e3 = 2 then rv3 = 1;
  return (rv3);
end f3;
divsub: procedure (dv, ds);
  declare (dv, ds) fixed bin(15);
  declare rr fixed bin(15);
  dvq = 0;
  rr = dv;
dl:
  if rr < ds then goto dd;
  rr = rr - ds;
  dvq = dvq + 1;
  goto dl;
dd:
end divsub;
cp30: procedure (frm, dst);
  declare (frm, dst) fixed bin(15);
  declare (k3, sp3, dp3) fixed bin(15);
  do k3 = 1 to 30;
    sp3 = frm + k3;
    dp3 = dst + k3;
    sx(dp3) = sx(sp3);
  end;
end cp30;
putc: procedure (v);
  declare v fixed bin(15);
  declare ch character(1) varying;
  ch = ' ';
  if v = 32 then ch = ' ';
  if v = 44 then ch = ',';
  if v = 48 then ch = '0';
  if v = 49 then ch = '1';
  if v = 50 then ch = '2';
  if v = 51 then ch = '3';
  if v = 58 then ch = ':';
  if v = 65 then ch = 'A';
  if v = 66 then ch = 'B';
  if v = 67 then ch = 'C';
  if v = 68 then ch = 'D';
  if v = 69 then ch = 'E';
  if v = 71 then ch = 'G';
  if v = 72 then ch = 'H';
  if v = 73 then ch = 'I';
  if v = 77 then ch = 'M';
  if v = 78 then ch = 'N';
  if v = 79 then ch = 'O';
  if v = 80 then ch = 'P';
  if v = 82 then ch = 'R';
  if v = 83 then ch = 'S';
  if v = 84 then ch = 'T';
  if v = 89 then ch = 'Y';
  put list(ch);
end putc;
putstr: procedure (frms);
  declare frms fixed bin(15);
  declare (k4, sp4, tv4) fixed bin(15);
  do k4 = 1 to 30;
    sp4 = frms + k4;
    tv4 = sx(sp4);
    if tv4 > 32 then call putc(tv4);
  end;
end putstr;
end dhry00;
