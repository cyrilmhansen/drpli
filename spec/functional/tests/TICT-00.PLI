  if t1 = g then goto l0171;
  goto l0175;
l0475:
  ps = 88;
  qs = 79;
l0500:
  put skip;
  put list('WHERE DO YOU MOVE ');
  get list(m);
l0502:
  t1 = m + 1;
  if t1 = 1 then goto l0502t;
  goto l0503;
l0502t:
  put list('THANKS FOR THE GAME.');
  put skip;
  goto l2000;
l0503:
