/* TICT-00 - FC-01 corpus adaptation, 2026-11-03.           */
/* Original: BASIC "Tic-Tac-Toe" (TICTACTOE2.bas), Creative  */
/* Computing MORRISTOWN NJ.  Research copy: build/           */
/* functional/fc01-sources/basic/TICTACTOE2.bas (upstream    */
/* coding-horror/basic-computer-games, sha256                */
/* 9945f459..., licence UNVERIFIED - recorded as             */
/* unverified, not asserted).  ADAPTATION (full removal/     */
/* substitution list is in TICT-00.json notes): the string   */
/* C$ choice GET becomes a NUMERIC console GET (1 = X,       */
/* 2 = O); board cells are codes 1 = computer, 2 = empty,    */
/* 3 = human so every compare has a positive literal or a    */
/* scalar on the right; AND-gated IFs became f-count         */
/* ladders with both members re-loaded at every label; the   */
/* BASIC FOR loops are emulated as flat goto loops (NO       */
/* BY-3, NO active DO crossed by a goto); TAB() banner       */
/* offsets are dropped; IT'S is rewritten WITHOUT an         */
/* apostrophe; the unreachable 1180/1200/1112/1137 routes    */
/* are kept as faithful dead code; every put list is         */
/* single-item under the MEASURED leading-blank separator    */
/* law.  Expected stream: reference.py:tict00, derived       */
/* from the declared design, never captured.                 */
tict00: procedure options(main);
  declare (i, j, k, m, c, g, h, r, f, t1, t2, t3) fixed bin(15);
  declare (ps, qs, b1, b2, b3) fixed bin(15);
  declare s(9) fixed bin(15);
  do i = 1 to 9;
     s(i) = 2;
  end;
l0002:
  put list('TIC-TAC-TOE');
