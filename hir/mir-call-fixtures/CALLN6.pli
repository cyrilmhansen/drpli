nest2: procedure returns(fixed bin(15));
   dcl x fixed bin(15);
   x = 4;
   call mid(x + 0);
   return (x);
   mid: procedure(m);
      dcl m fixed bin(15);
      dcl u fixed bin(15);
      u = m;
      deep: procedure(dd);
         dcl dd fixed bin(15);
         dd = 1;
      end deep;
   end mid;
end nest2;
