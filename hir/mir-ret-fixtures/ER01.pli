earlya: procedure returns(fixed bin(15));
   dcl r fixed bin(15);
   r = sel(2);
   put list(r);
   r = sel(7);
   put list(r);
   r = sel(5);
   put list(r);
   return (r);
   sel: procedure(x) returns(fixed bin(15));
      dcl x fixed bin(15);
      if x > 5 then
         return (9);
      return (4);
   end sel;
end earlya;
