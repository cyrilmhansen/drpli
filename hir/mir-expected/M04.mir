M0:	module
p_put:	proto	i64, i64:v
p_nl:	proto	i64
p_exit:	proto	i64:c
	import	pli_console_put_i64, pli_console_put_nl, exit
pli80_io1:	func	i64
	local	i64:v0, i64:st, i64:t1, i64:t2, i64:t3, i64:t4, i64:t5
	mov t1, 6
	mov t2, 7
	mul t3, t1, t2
	mov v0, t3
	mov t4, v0
	call p_put, pli_console_put_i64, st, t4
	bne Lfail, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail, st, 0
	mov t5, v0
	ret t5
Lfail:
	call p_exit, exit, st
	ret st
	endfunc
	export pli80_io1
	endmodule
