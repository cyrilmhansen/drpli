scaling: procedure returns(fixed bin(15));
   dcl q fixed bin(15);
   dcl cat fixed bin(15);
   dcl bill fixed bin(15);
   q = 3;
   cat = capped(q + 0);
   bill = cat * 1000;
   put list(bill);
   q = 7;
   cat = capped(q + 0);
   bill = cat * 1000;
   put list(bill);
   q = 12;
   cat = capped(q + 0);
   bill = cat * 1000;
   put list(bill);
   return (bill);
   capped: procedure(x) returns(fixed bin(15));
      dcl x fixed bin(15);
      dcl c fixed bin(15);
      if x > 20 then
         c = 20;
      else
         c = x;
      return (c);
   end capped;
end scaling;

