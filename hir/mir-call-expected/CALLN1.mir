M0:	module
pc1:	proto	i64, i64:v1
pli80_pv:	func	i64, i64:v1
	local	i64:t3
	mov t3, i64:(v1)
	ret t3
	endfunc
pli80_pval:	func	i64
	local	i64:v0, i64:hv1, i64:r1, i64:t1, i64:t2
	alloca hv1, 8
	mov t1, 1
	mov i64:(hv1), t1
	call pc1, pli80_pv, r1, hv1
	mov v0, r1
	mov t2, v0
	ret t2
	endfunc
	export pli80_pval
	endmodule
