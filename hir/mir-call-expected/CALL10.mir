M0:	module
pc1:	proto	i64:v2, i64:v3
p_put:	proto	i64, i64:v
p_nl:	proto	i64
p_exit:	proto	i64:c
	import	pli_console_put_i64, pli_console_put_nl, exit
pli80_clob:	func	i64:v2, i64:v3
	local	i64:t8, i64:t9
	mov t8, 3
	mov i64:(v3), t8
	mov t9, 7
	mov i64:(v2), t9
	ret
	endfunc
pli80_mixmod:	func	i64
	local	i64:v1, i64:st, i64:h0, i64:hv1, i64:hv2, i64:t1, i64:t2, i64:t3, i64:t4, i64:t5, i64:t6, i64:t7
	alloca h0, 8
	alloca hv1, 8
	alloca hv2, 8
	mov t1, 2
	mov i64:(h0), t1
	mov t2, 2
	mov v1, t2
	call pc1, pli80_clob, h0, h0
	mov t3, i64:(h0)
	call p_put, pli_console_put_i64, st, t3
	bne Lfail_0, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_0, st, 0
	mov t4, 20
	mov i64:(hv1), t4
	mov t5, 40
	mov i64:(hv2), t5
	call pc1, pli80_clob, hv1, hv2
	mov t6, i64:(h0)
	call p_put, pli_console_put_i64, st, t6
	bne Lfail_0, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_0, st, 0
	mov t7, i64:(h0)
	ret t7
Lfail_0:
	call p_exit, exit, st
	ret st
	endfunc
	export pli80_mixmod
	endmodule
