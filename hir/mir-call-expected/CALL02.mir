M0:	module
pc1:	proto	i64:v1
p_put:	proto	i64, i64:v
p_nl:	proto	i64
p_exit:	proto	i64:c
	import	pli_console_put_i64, pli_console_put_nl, exit
pli80_side:	func	i64:v1
	local	i64:v2, i64:t7, i64:t8, i64:t9
	mov t7, i64:(v1)
	mov t8, 0
	add t9, t7, t8
	mov v2, t9
	ret
	endfunc
pli80_call02:	func	i64
	local	i64:v0, i64:st, i64:hv1, i64:t1, i64:t2, i64:t3, i64:t4, i64:t5, i64:t6
	alloca hv1, 8
	mov t1, 2
	mov v0, t1
	mov t2, 4
	mov t3, v0
	add t4, t2, t3
	mov i64:(hv1), t4
	call pc1, pli80_side, hv1
	mov t5, v0
	call p_put, pli_console_put_i64, st, t5
	bne Lfail_0, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_0, st, 0
	mov t6, v0
	ret t6
Lfail_0:
	call p_exit, exit, st
	ret st
	endfunc
	export pli80_call02
	endmodule
