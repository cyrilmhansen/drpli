M0:	module
pc1:	proto	i64, i64:v1, i64:v2, i64:v3
p_put:	proto	i64, i64:v
p_nl:	proto	i64
p_exit:	proto	i64:c
	import	pli_console_put_i64, pli_console_put_nl, exit
pli80_pick3:	func	i64, i64:v1, i64:v2, i64:v3
	local	i64:v4, i64:st, i64:t6, i64:t7, i64:t8, i64:t9
	mov t6, i64:(v1)
	call p_put, pli_console_put_i64, st, t6
	bne Lfail_1, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_1, st, 0
	mov t7, i64:(v2)
	call p_put, pli_console_put_i64, st, t7
	bne Lfail_1, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_1, st, 0
	mov t8, i64:(v3)
	mov v4, t8
	mov t9, v4
	ret t9
Lfail_1:
	call p_exit, exit, st
	ret st
	endfunc
pli80_thrice:	func	i64
	local	i64:v0, i64:st, i64:hv1, i64:hv2, i64:hv3, i64:r1, i64:t1, i64:t2, i64:t3, i64:t4, i64:t5
	alloca hv1, 8
	alloca hv2, 8
	alloca hv3, 8
	mov t1, 1
	mov i64:(hv1), t1
	mov t2, 2
	mov i64:(hv2), t2
	mov t3, 3
	mov i64:(hv3), t3
	call pc1, pli80_pick3, r1, hv1, hv2, hv3
	mov v0, r1
	mov t4, v0
	call p_put, pli_console_put_i64, st, t4
	bne Lfail_0, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_0, st, 0
	mov t5, v0
	ret t5
Lfail_0:
	call p_exit, exit, st
	ret st
	endfunc
	export pli80_thrice
	endmodule
