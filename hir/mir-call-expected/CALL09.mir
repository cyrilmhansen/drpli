M0:	module
pc1:	proto	i64:v1
pli80_dsub:	func	i64:v1
	ret
	endfunc
pli80_uncalled:	func	i64
	local	i64:v0, i64:hv1, i64:t1, i64:t2, i64:t3, i64:t4, i64:t5
	alloca hv1, 8
	mov t1, 3
	mov v0, t1
	mov t2, v0
	mov t3, 0
	add t4, t2, t3
	mov i64:(hv1), t4
	call pc1, pli80_dsub, hv1
	mov t5, v0
	ret t5
	endfunc
	export pli80_uncalled
	endmodule
