M0:	module
pc1:	proto	i64, i64:v1
p_put:	proto	i64, i64:v
p_nl:	proto	i64
p_exit:	proto	i64:c
	import	pli_console_put_i64, pli_console_put_nl, exit
pli80_sel:	func	i64, i64:v1
	local	i64:t6, i64:t7, i64:t8, i64:t9
	mov t6, i64:(v1)
	mov t7, 10
	ble Ljoin1, t6, t7
	mov t8, i64:(v1)
	ret t8
	Ljoin1:
	mov t9, 3
	ret t9
	endfunc
pli80_earlyb:	func	i64
	local	i64:v0, i64:st, i64:hv1, i64:hv2, i64:r1, i64:r2, i64:t1, i64:t2, i64:t3, i64:t4, i64:t5
	alloca hv1, 8
	alloca hv2, 8
	mov t1, 4
	mov i64:(hv1), t1
	call pc1, pli80_sel, r1, hv1
	mov v0, r1
	mov t2, v0
	call p_put, pli_console_put_i64, st, t2
	bne Lfail_0, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_0, st, 0
	mov t3, 12
	mov i64:(hv2), t3
	call pc1, pli80_sel, r2, hv2
	mov v0, r2
	mov t4, v0
	call p_put, pli_console_put_i64, st, t4
	bne Lfail_0, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_0, st, 0
	mov t5, v0
	ret t5
Lfail_0:
	call p_exit, exit, st
	ret st
	endfunc
	export pli80_earlyb
	endmodule
