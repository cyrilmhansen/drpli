M0:	module
pc1:	proto	i64, i64:v1
p_put:	proto	i64, i64:v
p_nl:	proto	i64
p_exit:	proto	i64:c
	import	pli_console_put_i64, pli_console_put_nl, exit
pli80_sel:	func	i64, i64:v1
	local	i64:t8, i64:t9, i64:t10, i64:t11
	mov t8, i64:(v1)
	mov t9, 5
	ble Ljoin1, t8, t9
	mov t10, 9
	ret t10
	Ljoin1:
	mov t11, 4
	ret t11
	endfunc
pli80_earlya:	func	i64
	local	i64:v0, i64:st, i64:hv1, i64:hv2, i64:hv3, i64:r1, i64:r2, i64:r3, i64:t1, i64:t2, i64:t3, i64:t4, i64:t5, i64:t6, i64:t7
	alloca hv1, 8
	alloca hv2, 8
	alloca hv3, 8
	mov t1, 2
	mov i64:(hv1), t1
	call pc1, pli80_sel, r1, hv1
	mov v0, r1
	mov t2, v0
	call p_put, pli_console_put_i64, st, t2
	bne Lfail_0, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_0, st, 0
	mov t3, 7
	mov i64:(hv2), t3
	call pc1, pli80_sel, r2, hv2
	mov v0, r2
	mov t4, v0
	call p_put, pli_console_put_i64, st, t4
	bne Lfail_0, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_0, st, 0
	mov t5, 5
	mov i64:(hv3), t5
	call pc1, pli80_sel, r3, hv3
	mov v0, r3
	mov t6, v0
	call p_put, pli_console_put_i64, st, t6
	bne Lfail_0, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail_0, st, 0
	mov t7, v0
	ret t7
Lfail_0:
	call p_exit, exit, st
	ret st
	endfunc
	export pli80_earlya
	endmodule
