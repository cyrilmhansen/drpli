M0:	module
p_put:	proto	i64, i64:v
p_nl:	proto	i64
p_exit:	proto	i64:c
	import	pli_console_put_i64, pli_console_put_nl, exit
pli80_loopcond:	func	i64
	local	i64:v0, i64:v1, i64:st, i64:t1, i64:t2, i64:t3, i64:t4, i64:t5, i64:t6, i64:t7, i64:t8, i64:t9, i64:t10, i64:t11, i64:t12
	mov t1, 0
	mov v0, t1
	mov t2, 9
	mov v1, t2
	Lh1:
	mov t3, v0
	mov t4, 2
	bge Lx1, t3, t4
	mov t5, v0
	mov t6, 0
	bne Ljoin2, t5, t6
	mov t7, v1
	call p_put, pli_console_put_i64, st, t7
	bne Lfail, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail, st, 0
	Ljoin2:
	mov t8, v0
	mov t9, 1
	add t10, t8, t9
	mov v0, t10
	jmp Lh1
	Lx1:
	mov t11, v0
	call p_put, pli_console_put_i64, st, t11
	bne Lfail, st, 0
	call p_nl, pli_console_put_nl, st
	bne Lfail, st, 0
	mov t12, v0
	ret t12
Lfail:
	call p_exit, exit, st
	ret st
	endfunc
	export pli80_loopcond
	endmodule
