(* ===================================================================
   PARSER-ROUND DELTAS (supersede older inline comments where they
   conflict; details + evidence pointers in spec/notes/parser-phase.md,
   claims C040/C041):
   - idents include '_'; bit literals: 'digits'xN repeat suffix
   - operators: ~ and ^ both NOT; ~= and >< and <> all NE; ^= XOR
   - builtin words include LOG (and CHAR/DEC appear as compiler-internal
     BUILTIN symbols; see C043)
   - FIXED BINARY storage ladder: p<=8 -> 1B, p<=16 -> 2B, else 4B
     [C042; boundaries PROBE 63]
   - declare synonym: DCL; bare type words DECIMAL/BINARY/PTR/FILE
   - dcl: type and attribute order interleaves freely; groups
     (lvl, names...) with per-member dims AND per-member types;
     attrs LABEL INITIAL VARIABLE VAR RECURSIVE added
   - entry param lists may contain (group) type items
   - bare `PUT SKIP;` / `GET SKIP;`; file-options and skip/page/line
     controls interleave before the kind word
   - labels may carry subscripts (c(1):) and may precede END
   - statement head `end` is an identifier when followed by = ( . 
   - do-loop modifier order FREE: BY TO WHILE REPEAT any permutation;
     `do i = e by s;` with no bound loops forever
   - edit parentheses: counted items `4a`, counted groups
     `2(skip,column(indent),a)`, and item replication
     `(item do n = f to l)`; format words COLUMN, WIDTH attested
   =================================================================== *)

(* =====================================================================
   PL/I-80 grammar draft 0
   Source of productions: PL/I-80 Language Manual, 2nd printing Dec 1980
     (manuals/PL1-80_Language_Manual_Dec80.pdf, OCR: extracted/...txt)
   Target binary under study: PL/I-80 Compiler v1.4 (1983) — the manual
     predates it; RELNOTES.PRN lists doc errata and 1.3/1.4 changes.
   Every production carries a provenance tag:
     [M §x]      stated in the manual, section x
     [M AppB.x]  manual Appendix B statement x
     [M AppC.x]  manual Appendix C attribute x
     [RN]        RELNOTES.PRN (v1.3->v1.4 bug notes)
     [EX file]   appears in an artefact sample program
     [PROBE n]   behavior must be pinned down by black-box test n
   Grammar is not yet verified against the compiler; PROBE markers
   list exactly what must be established experimentally.
   ===================================================================== *)

(* ---- Lexical ------------------------------------------------------ *)
(* Character set: ASCII; source identifiers/literals case-insensitive
   for keywords? [PROBE 1: keyword case sensitivity — sample files mix
   DCL/declare, uppercase keywords, lower-case names; assume insensitive] *)

identifier      = letter, { letter | digit } ;          (* length limit?
                                                           [PROBE 2: max id length, truncation] *)
label-constant  = identifier ;
number          = {digit} [ "." {digit} ]
                [ ( "E" | "D" ) [ "+" | "-" ] {digit} ] ;
                (* [PROBE 3: lowercase 'e' float exponent — fixed in 1.4 [RN];
                   'b' suffix on bit strings: 5'b10101 [EX OPTIMIST] *)
bit-literal     = {bit-digit}, "'", ( "B" | "b" ) ;
char-literal    = "'", { any-char | "''" /* quote escape? */ }, "'" ;
                (* [PROBE 4: quote escape mechanism, control chars in
                   string literals (added by PL/I-80) [M §1.3]] *)
delimiter       = ( "," | ";" | "=" | "(" | ")" | "'" | '"'
                  | "+" | "-" | "*" | "/" | "|" | ":" | "<" | ">"
                  | "**" | "^" | "/\" | "[]" | "()" ) ;

(* reserved words [PROBE 5: exact reserved-word table, incl. abbrevs
   ALLOW? and 2-letter forms: BIN, DEC, CHAR, VAR, INIT, PROC, EN, EX...] *)

(* ---- Program structure -------------------------------------------- *)
program         = { external-procedure } ;
external-procedure = [ label-constant ] ":" procedure ;
                (* exactly one OPTIONS(MAIN) [PROBE 6: multiple/zero main] *)

procedure       = "PROCEDURE" | "PROC" ;
procedure-stmt  = [ "procedure-name ":" ]
                  ( "PROCEDURE" | "PROC" )
                    [ "(" [ "STRUCTURE" | parm { "," parm } ] ")" ]
                    [ "OPTIONS" "(" options { "," options } ")" ]
                    [ "RETURNS" "(" type-attrs ")" ]
                    [ "RECURSIVE" ] ;
parm            = [ formal-attrs ] identifier ;   (* like DCL without name slot
                     [PROBE 7: parameter attribute grammar, by-value/by-ref] *)
options         = "MAIN" | "SINGLE" | "STACK" "(" constant ")" ;
                     (* STACK from ACKTST.PLI [EX]; others? [PROBE 8] *)
block           = [ procedure-stmt ] [ declarative-part ]
                  { statement } "END" [ label ] ;
group           = "BEGIN" [ declarative-part ] { statement } "END" ;
declarative-part = { declare-stmt | procedure-stmt-spec | preproc-stmt } ;
                    (* ordering rules [PROBE 9] *)

(* ---- Preprocessor (2 commands only, global scope) ------------------ *)
preproc-stmt    = include-stmt | replace-stmt ;
include-stmt    = "%INCLUDE" string-constant ";" ;   (* [M §2.6]
                   [PROBE 10: drive/path handling, nesting depth, EOF] *)
replace-stmt    = "%REPLACE" repname "BY" const-exp
                    { "," repname "BY" const-exp } ";" ; (* [M §2.6] [EX OPTIMIST,
                   MATSIZE.LIB]; must be at outer block level [PROBE 11:
                   what error if nested? textual subst into literals?] *)

(* ---- Statements (Appendix B, complete list = 31) ------------------- *)
statement       = label-prefix basic-stmt | empty-stmt ;
empty-stmt      = ";" ;                               (* [M AppB.15] *)
basic-stmt       =
    allocate-stmt | assignment-stmt | begin-stmt | call-stmt
  | close-stmt | declare-stmt | do-stmt | end-stmt | format-stmt
  | free-stmt | get-edit-stmt | get-list-stmt | goto-stmt | if-stmt
  | on-stmt | open-stmt | procedure-stmt | put-edit-stmt | put-list-stmt
  | read-stream-stmt | read-seq-stmt | read-keyto-stmt | read-key-stmt
  | return-stmt | revert-stmt | signal-stmt | stop-stmt
  | write-stream-stmt | write-seq-stmt | write-keyfrom-stmt ;

allocate-stmt   = "ALLOCATE" based-var "SET" "(" ptr-var ")" ; (* [M AppB.1]
                     [EX ALLTST 2 files] [PROBE 34: ALLOCATE/FREE runtime —
                     CP/M storage: what does SET do, STKSIZ limits?] *)
assignment-stmt = lvalue "=" exp ";" ;
                (* lvalue: var | substr-builtin | unspec-builtin [M §7.4]
                   | GROUP-NAME (whole-record copy [EX ENTER l.48]) *)
call-stmt       = "CALL" proc-name [ "(" [ exp { "," exp } ] ")" ] ;
close-stmt      = "CLOSE" "FILE" "(" file-name { "," file-name } ")" ;
do-stmt         = "DO" [ "label" ":" ] [ "TO" ] [ iter-spec ]
                  [ "DO" [ stmt ] ] { stmt } "END" [ label ] ;
                (* iter-spec forms (order-sensitive!): [M AppB.7]
                   ident "=" exp [ "TO" exp ] [ "BY" exp ] [ "WHILE" "(" cond ")" ]
                   ident "=" exp [ "BY" exp ] [ "TO" exp ]   [ "WHILE" "(" cond ")" ]
                   ident "=" exp [ "REPEAT" "(" exp ")" ]     [ "WHILE" "(" cond ")" ]
                   "WHILE" "(" cond ")"
                   [PROBE 12: DO label: / DO WHILE / DO; / iteration
                   edge semantics (<= vs <), negative steps] *)
if-stmt         = "IF" cond "THEN" stmt [ "ELSE" [ stmt ] ] ;
                (* cond: bit-string or "()" boolean [PROBE 13: exact
                   accepted cond types; 1.4 fix: SUBSTR of bit as cond [RN]] *)
on-stmt         = "ON" condition on-unit ;              (* [M §8.5]
                   condition = cond-name [ "(" ( file-name | code ) ")" ]
                   cond-name = "ERROR" | "FIXEDOVERFLOW" | "OVERFLOW"
                             | "UNDERFLOW" | "ZERODIVIDE" | "ENDFILE"
                             | "ENDPAGE" | "UNDEFINEDFILE" | "KEY"  [M §8.5]
                             | user-condition-name       (* via SIGNAL only? *)
                   on-unit   = statement | "BEGIN" { stmt } "END"
                   [M §8.5: no RETURN exit from on-unit BEGIN; non-local GOTO
                   allowed; on-units STACK (max 16 active); REVERT pops most
                   recent; automatic revert on block exit]
                   [M §8.8 default actions: print message + terminate, EXCEPT
                   FIXEDOVERFLOW (never raised for BINARY overflow — matches
                   observed silent 16-bit wrap C024) and ENDPAGE (form feed)]
                   [PROBE 32: "ON ERROR(1)" numeric designator (seen in
                   EXPR1/EXPR2 [EX]) — meaning, relation to ONCODE and to the
                   "(1)"/"(2)" suffix in RTL messages [C020] ] *)
revert-stmt     = "REVERT" condition { "," condition } ;
signal-stmt     = "SIGNAL" cond-name [ "(" ( file-name | code ) ")" ] ;
                (* [M §8.6] plain form; corpus uses SIGNAL ENDPAGE(file),
                   SIGNAL ERROR(1) [EX COPYLPT/EXPR1] [PROBE 32 covers codes] *)
stop-stmt       = "STOP" ;                              (* [PROBE 15:
                   STOP with code? interplay with $STOP compiler msg] *)
goto-stmt       = ( "GOTO" | "GO" "TO" ) label [ "(" subscript ")" ] ;
                (* computed goto LAB(K) [M AppB.13]; [PROBE 16: bounds check] *)
return-stmt     = "RETURN" [ "(" [ exp ] ")" ] ;

(* ---- DECLARE (the big one) ----------------------------------------- *)
declare-stmt    = ( "DECLARE" | "DCL" )
                  [ "(" decl { "," decl } ")" | decl { "," decl } ] ";" ;
decl            = [ level ] designator
                  [ constant ]        (* array extents, static only
                     [PROBE 17: lower bound default, multi-dim, bounds] *)
                  [ type-attrs ] [ storage-attrs ] ;
                  (* GROUP ITEM: level + name, NO type attrs (ENTER.PLI
                     "2 address," / "1 default static,") — occupies the
                     contiguous span of its subitems [EX] *)
level           = unsigned-int ;      (* RESOLVED [P047B]: level may stay
                     same or increase by exactly 1; 1 -> 3 = pass1
                     CONFLICT diagnostic on the offending line. level 0?
                     still open [PROBE 18b] *)
type-attrs      = ( "FIXED" [ "BINARY"|"BIN"|"DECIMAL"|"DEC" [ "(" p [ "," s ] ")" ] ]
                  | "FLOAT" [ "BINARY"|"BIN" | "DECIMAL" ] [ "(" p ")" ] )
                  (* precision max 15 [C022]; default FIXED = BIN(15) [C021];
                     FLOAT DECIMAL => pass1 "CONFLICT" diag, no object:
                     Subset G CUT CONFIRMED [EX P017A]; bare FLOAT ok
                     [EX P017B] — default float precision TBD via $S *)
                  | ( "CHARACTER"|"CHAR" ) [ "(" n [ "VARYING"|"VAR" ] ")" ]
                  | ( "BIT"|"B" ) [ "(" n ")" ] [ "ALIGNED" ]
                  (* [PROBE 19: VARYING placement inside/outside parens —
                     samples show both CHAR(20) VAR and CHAR(20)VARYING] *)
                  | "LABEL" | "POINTER"|"PTR"
                  | "FILE" [ file-attrs ]
                    (* file-attrs (DCL or OPEN position — split TBD):
                       [ "STREAM" | "RECORD" ] [ "KEYED" ]
                       [ "ENVIRONMENT" "(" env-list ")" ]
                       [ "PAGESIZE" "(" n ")" ]
                       env-list = ( "F" | "B" ) "(" n ")" { "," ... }
                       [EX "open file(emp) keyed output
                            environment(f(128),b(4000))" KEYFILE [EX]]
                       [PROBE 33: which attrs legal where + defaults] *)
                  | "ENTRY"
                    [ "(" [ type-attrs { "," type-attrs } ] ")" ]
                    [ "RETURNS" "(" type-attrs ")" ]
                  | "BUILTIN" ;
storage-attrs   = { "STATIC" | "AUTOMATIC"|"AUTO"
                  | "BASED" "(" ptr ")"          (* EX ALLTST/ALLDCL [EX];
                     BASED(q()) fn-valued variant [M §5.2] *)
                  | ( "EXTERNAL"|"EXT" ) [ "(" ext-name-lit ")" ]
                  | "VARIABLE"                   (* with FILE/ENTRY [M §5.2 EX] *)
                  | "INITIAL"|"INIT" "(" init { "," init } ")" } ;
                (* NOTE: no DEFAULT attribute in corpus — ENTER.PLI
                   "1 default static" is a GROUP NAMED default [EX];
                   ANSI `b fixed default(a)` => pass1 SYNTAX [EX P025]:
                   DEFAULT(reference) attribute CUT. Confirmed. *)
                (* init: value | n "(" value ")" replication [M AppC.14]
                   [PROBE 20: default storage by block nesting,
                   DEFAULT attribute, EXTERNAL linkage naming] *)

(* ---- Expressions (precedence, high→low) [M §7.1.3] ------------------ *)
primary         = constant | special-register? | identifier
                  [ "->" designator ]   (* pointer qualification p->f
                     [M §1.4 l.556, §3.4; EX NETWORK(45), MPMCALLA/B] *)
                  (* special FREE-only form "FREE P->.A" [M AppB.10];
                     "->." in assignment = SYNTAX [EX P024]; deref
                     grammar beyond p->f: bare p->, deref-star style
                     [PROBE 41] *)
                  [ substring | bit-substr | unspec-builtin ]
                | "(" expression ")"
                | function-reference
                | built-in-function ;
unary-op        = "+" | "-" | "**"? ;
exponentiation  = power ;              (* ** right-assoc? base/limit
                     [PROBE 21: ** operand restrictions (integer), assoc] *)
multiplicative  = "*" | "/" ;          (* [PROBE 22: MOD vs REM; 1.4 fix
                     MOD negative args [RN]] *)
additive        = "+" | "-" ;
concatenation   = "||" ;               (* [PROBE 23: LENGTH on concat of
                     VARYING — 1.4 fix [RN]] *)
relational      = "=" | "^=" | "<" | "<=" | ">" | ">=" ;
                (* [PROBE 24: mixed-type compare coercion rules §7.2/7.3] *)
logical         = ( "^" | AND-OPS | OR-OPS | "OR" | "AND" | "NOT" ) ;
                (* actual spellings: /\ = AND, \ = OR, ^ = NOT [M §1.4;
                   samples use &, |, ^ extensively [EX EXPR1/2];
                   single-char & | also observed in corpus [EX];
                   operator table [PROBE 25] *)
conditional-exp = "(" cond ")" "(" then-exp "ELSE" else-exp ")" ;
                     (* PL/I conditional expression [PROBE 26: is it in
                        the /G subset supported by PL/I-80??] *)

(* ---- Built-in functions (§12) -------------------------------------- *)
arith-bi        = "ABS" "CEIL" "DIVIDE" "FLOOR" "MAX" "MIN"
                  "MOD" "ROUND" "SIGN" "TRUNC" ;
                (* DIVIDE(x,y,p[,q]) [M §12.4.6]: 3rd arg INTEGER const, not
                   bit; EX P019A divide(7,2,5)=3 (3.5 -> 3: mode? [PROBE 42]) *)
math-bi         = "ACOS" "ASIN" "ATAN" "ATAND" "COS" "COSD" "COSH" "EXP"
                  "LOG" "LOG2" "LOG10" "SIN" "SIND" "SINH" "SQRT" "TAN"
                  "TAND" "TANH" ;
string-bi       = "BOOL" "COLLATE" "INDEX" "LENGTH" "SUBSTR"
                  "TRANSLATE" "VERIFY" ;          (* BOOL = 12.3.1 [M]:
                     BOOL(x,y,'abcd'b) truth-table 3-arg; bool('1'b,'1'b,
                     '1010'b)='0'b [EX P019A]; 1-arg bool(x) = SYNTAX [P019]
                     LENGTH(x[,unit]) §12.3.4 *)
conv-bi         = "ASCII" "BINARY" "BIT" "CHARACTER" "DECIMAL" "DIVIDE"
                  "FIXED" "FLOAT" "RANK" "UNSPEC" ;
                (* §12.4: FIXED(x[,p[,k]]) — fixed('123')=123 [EX P019A];
                   ASCII/RANK = PL/I-80 additions; DIVIDE also listed 12.4 *)
cond-bi         = "ONCODE" "ONFILE" "ONKEY" ;
misc-bi         = "ADDR" "DIMENSION" "HBOUND(x,n)" "LBOUND(x,n)"
                  "LINENO(file)" "NULL" "PAGENO(file)" ;
                  (* [M §12.6 decoded: HBOUND/LBOUND/LINENO/NULL/PAGENO]
                     EX P019B: lbound(arr,1)=1 hbound(arr,1)=5 (STATIC ok);
                     lineno/pageno take a DECLARED file value — using
                     sysprint undeclared => pass2 NO DCL + TYPES NOT=;
                     after open file(pf) print: lineno(pf)=pageno(pf)=1.
                     undocumented STKSIZ MAXWDS ALLWDS TOTWDS [EX
                     ACKTST/ALLTST compile clean => REAL v1.4 builtins;
                     extract table from binary, PROBE 27] *)
                (* NULL is a BARE VALUE (Format: NULL [M §12.6.6]), not a
                   call: p = null, q ^= null [EX NETWORK/P019A runs] *)
                (* NOT present (Subset-G cuts): ATANH DATE STRING TIME
                   VALID [M intro] *)
                (* condition-info built-ins [M §8.9/§12.5]: ONCODE ONFILE
                   ONKEY; BOOL [M §12.3.1] is the logical-conversion builtin
                   fixed in v1.4 RELNOTES; DIVIDE [§12.4.6] & FIXED [§12.4.7]
                   are CONVERSION built-ins (12.4 list) *)

(* ---- I/O ----------------------------------------------------------- *)
file-names      = "SYSIN" | "SYSPRINT" | "SYSOUT" | "SYSPRINT" ... ;
                     (* [PROBE 28: predefined files table §9.7] *)
file-names      = "SYSIN" | "SYSPRINT" | "SYSOUT" ;  (* + defaults; also
                     user-declared file names with TITLE [EX]
                     [PROBE 28: predefined files table §9.7 — SYSIN/SYSPRINT/
                     SYSOUT/SYSERROR? + $con title + 'A$1$2' naming] *)
open-stmt       = "OPEN" [ "FILE" ] "(" f { "," f } ")"
                  [ [ "INPUT" | "OUTPUT" | "UPDATE" ]
                  | "PRINT" ]                (* PRINT [M AppB.17 + EX LOAN2] *)
                  [ "STREAM" ]                (* DR-observed option [EX COPY/COPYLPT]
                     [PROBE 33: STREAM vs RECORD default; where allowed in DCL; *
                     combination/legality matrix OPEN/ENVIRONMENT/KEYED] *)
                  [ "KEYED" ]                 (* [EX KEYFILE/UPDATE/RETRIEVE] *)
                  [ "DIRECT" ]                (* [EX UPDATE l.31] *)
                  [ "LINESIZE" "(" n ")" ]    (* [EX KEYFILE l.20] *)
                  [ "ENVIRONMENT" "(" env-item { "," env-item } ")" ]
                  | "TITLE" "(" string-exp ")"   (* CP/M filename 'd:x.y';
                     $1/$2 = command-line default names (FCB1/2) [M AppG
                     §TITLE; EX ENTER 'title($1.EMP)' + arg EMPDB ->
                     EMPDB.EMP, no arg -> UNDEFINED FILE (1) — C034];
                     '$con' console device; $LST/$RDR/SPUN stream-only *)
                  [ "PAGESIZE" "(" n ")" ] ;      (* [EX] *)
env-item        = ( "F" | "B" ) "(" n ")" ;
                (* OPEN option ORDER + which appear in DCL vs OPEN is
                   [PROBE 33]; predefined file names [PROBE 28] *)
get-list        = "GET" [ "FILE" "(" f ")" ] [ "SKIP" [ "(" n ")" ] ]
                  "LIST" "(" io-list ")" ;
put-list        = "PUT" [ "FILE" "(" f ")" ] [ "SKIP" [ "(" n ")" ] ]
                  [ "PAGE" [ "(" n ")" ] ] "LIST" "(" io-list ")" ;
get-edit / put-edit : same + "EDIT" "(" data-list ")" "(" format-list ")" ;
format-item     = ( "A" | "B" | "O"? | "F" | "E" | "P" | "X" | "R"
                  | "S" | "K" | "T"? ) [ "(" w [ "," d ] ")" ] ;
                (* §10.6-10.8. PICTURE = OUTPUT format item P'picspec'
                   [M AppD, v1.3+]. Char model [EX P045 + AppD read]:
                   9 = digit slot w/ ZERO fill ('999.99' of 12.34 ->
                   '000.12' — value integer-truncated to slot count, '.'
                   is NOT the decimal anchor); V = decimal-point position
                   ('+++V++' of 12.34 -> '+1234' implied-decimal COBOL
                   style ✓); , / . are insertion chars; duplicated $ +- S
                   = DRIFTING = conditional digit positions (leading-zero
                   suppression: '+++.++' -> '   +12'), single = static.
                   OPEN anomaly (PROBE 40 continues): '++,+++.++' of
                   1234.56 -> '   +12.35' — rounding to 2 places with NO
                   V; '+'-after-'.' behaving as decimal slots. Exact
                   '+'-picture scale formula TBD.
                   Picture item paired ONE data item; extra format items
                   past data are silently skipped [EX P045 round 1].
                 * REMOTE FORMAT: named format referenced as R(label):
                   put edit(x)(r(money)) [M §10.9; EX P020]; bare (money)
                   => SYNTAX [P020 round1]. FORMAT stmt requires a label:
                   "money: FORMAT(list);" [M AppB.9]. 1.4 F(w,d) [RN]. *)
read/write      = stream forms READ FILE(f) INTO(v)/WRITE FILE(f) FROM(v)
                + record forms [KEY|KEYTO|KEYFROM] ;  (* §11 [M AppB.21-31] *)

(* ---- Structure/aggregates (§4) ------------------------------------- *)
array           = designator constant { constant } ;   (* dims are compile-time
                     constants only: undefined name as bound -> SYNTAX at dcl
                     [C013/P005 confirmed]; dim max? [PROBE 30] *)
structure       = level-based nested DCL ;  (* [EX ENTER/CREATE/KEYFILE/RETRIEVE]
                   The ONLY structure mechanism in DR PL/I-80 (ANSI STRUCTURE
                   [PROBE 35] CONFIRMED CUT: "1 s1 structure," silently
                   derails the dcl — subfields never declared (pass2 NO DCL
                   on use) [EX P023]):
                   - fields referenced FLAT (age,wage) or QUALIFIED grp.a —
                     both compile AND run [EX P022: qual= 7]
                   - group->group assignment COPIES the record image
                     [EX P022 runtime a=7 b=WXYZ after grp=grp2; ENTER]
                   - levels 1..n; increment: same or +1 ONLY; skip =>
                     pass1 CONFLICT [EX P047B]
                   - duplicate names across groups allowed; qualified
                     refs disambiguate [EX P047A: g1.dup=5 g2.dup=6 ok];
                     flat ref of ambiguous name untested [PROBE 38b]
                   - frame model [EX P046 $S]: ONE auto frame per
                     procedure — variables declared inside nested DO/BEGIN
                     blocks share it (X@0 Y@2 W@4, AUTO STORAGE 6);
                     nested procedures are ENTRY..CONSTANT items in the
                     parent frame; their own block shows AUTO STORAGE 0
                     and their STATIC vars flag 'e'
                   [PROBE 38: ambiguity flat vs qualified across groups;
                   STATIC layout order; based-group assign] *)
                (* [PROBE 39: ANSI DEFAULT attribute — accepted? need ref dcl] *)
                  (* [PROBE 31: levels must be consecutive? gap errors] *)

(* ---- Conditions & ON-unit rules ([M §8.4-8.9] integrated above) ---- *)
cond-name       = "ERROR" | "FIXEDOVERFLOW" | "OVERFLOW" | "UNDERFLOW"
                | "ZERODIVIDE" | "ENDFILE" | "ENDPAGE" | "UNDEFINEDFILE"
                | "KEY" ;

(* ============ Open global questions (Phase 1 answers these) ========
   Q1 Does the compiler produce an intermediate ".INT" file that a
      second stage consumes? (strings: "EOF ON INT FILE", "BAD INT
      FILE", "RELINTPLI", ".INT/.REL" extension tables)  -> run oracle,
      watch the filesystem.
   Q2 Is there any internal IR beyond the generated 8080 code? The
      PLI2.OVL 3-4 char mnemonic table (LIOB IDCI DDID FIDI ...) is
      either an RTL entry-point name table or a code-gen template table;
      IRL here means *Indexed Relocatable* (LIB/PLILIB.IRL), NOT an IR.
   Q3 Exact symbol/limit table: SYMBOL TABLE OVERFLOW, BLOCK OVERFLOW,
      EXPRESSION OVERFLOW, AUTOMATIC STORAGE OVERFLOW, NESTED REP$...
      -> find the real numeric limits by black-box probes.
   ==================================================================== *)
