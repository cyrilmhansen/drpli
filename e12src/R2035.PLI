lR2035:
 procedure options(main);
   dcl i fixed;
   dcl j fixed;
   dcl k fixed;
   dcl r fixed;
   dcl s fixed;
   i = 6;
   r = f4(i, i, i, i);
   put skip list(r);
   stop;
   f4: procedure (a,b,c,d) returns (fixed);
      declare (a,b,c,d) fixed;
      return (a + b + c + d);
   end f4;

end lR2035;
