a: 
    procedure options(main); 
    declare n fixed, m fixed; 
    n = 7; 
    m = 3; 
    m = g(4); 
    put skip list('W', m); 
    stop; 
    g: procedure(j) returns(fixed); 
    declare j fixed; 
    return (j * 2); 
    end g; 
    f: procedure(j) returns(fixed); 
    declare j fixed; 
    return (j + 1); 
    end f; 
end a; 
