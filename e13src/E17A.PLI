e17a: procedure options(main);
 dcl inf file;
 dcl eoflag bit(1) static initial('0'b);
 dcl x fixed bin(15);
 on endfile(inf) begin;
   eoflag = '1'b;
 end;
 open file(inf) stream title('$1.$1');
 do while(eoflag = '0'b);
   get file(inf) list(x);
   put list('X=', x);
 end;
 put list('DONE');
 end e17a;
