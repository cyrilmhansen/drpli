r3036:
 procedure options(main);
   dcl (a,b,c) float;
   dcl (d1,d2,d3,d4,d5,d6,d7) float;
   dcl i fixed;
   dcl j fixed;
   i = 3;
   d1 = a + i;
   d2 = i + a;
   d3 = i * a;
   d4 = a * i;
   d5 = i / a;
   d6 = a / i;
   d7 = a * 2;
   put skip list(d1,d2,d3);
   stop;
end r3036;
