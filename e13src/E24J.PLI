e24j:
    procedure options(main);
    declare (a, b, c) fixed;
    a = 1;
    call z1;
    b = 2;
    call z2;
    c = z3();
    stop;
    z1: procedure;
       declare t fixed;
       t = 1;
    end z1;
    z2: procedure;
       declare (u, w) fixed;
       u = 2;
       w = 3;
    end z2;
    z3: procedure returns(fixed);
       declare y fixed;
       y = 4;
       return (y);
    end z3;
end e24j;

