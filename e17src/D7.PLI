a:
    procedure options(main);
    declare r fixed, x fixed, y fixed;
    x = 100;
    y = 7;
    r = f(5);
    put skip list('W', r);
    stop;
    f: procedure(n) returns(fixed);
    declare n fixed, t fixed;
    t = g(3);
    return (t + g(t));
    end f;
    g: procedure(n) returns(fixed);
    declare n fixed;
    return (n * 3);
    end g;
end a;
