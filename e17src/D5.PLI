a:
    procedure options(main);
    declare r fixed, x fixed, y fixed;
    x = 100;
    y = 7;
    r = f(5);
    put skip list('W', r);
    stop;
    f: procedure(n) returns(fixed);
    declare n fixed, t fixed, u fixed;
    t = n;
    u = n + 2;
    return (t + g(1, h(2)));
    end f;
    g: procedure(n, m) returns(fixed);
    declare n fixed, m fixed;
    return (n + m);
    end g;
    h: procedure(n) returns(fixed);
    declare n fixed;
    return (n + 1);
    end h;
end a;
