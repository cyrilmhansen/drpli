a:
    procedure options(main);
    declare n fixed, m fixed, q fixed, c char(1);
    n = 7;
    m = 3;
    q = 11;
    put skip list('WW', n);
    put skip list('W', m);
    put skip list('WW', q);
    stop;
    f: procedure(j) returns(fixed);
    declare j fixed;
    return (j + 1);
    end f;
end a;
