e35t7: procedure options(main);
   declare p pointer;
   declare 1 nd based,
   2 w character(20) varying,
   2 w2 character(200) varying,
   2 w3 character(60) varying,
   2 v fixed,
   2 a fixed,
   2 b fixed,
   2 c fixed,
   2 link pointer;
   allocate nd set(p);
   p->v = 32767;
   p->link = null;
  stop;
end e35t7;
