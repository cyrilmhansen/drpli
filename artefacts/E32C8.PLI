c8: procedure options(main);
  declare w fixed;
  w = o(3);
  put list('gt=', w);
  w = o(1);
  put list('lt=', w);
  w = o(2);
  put list('eq=', w);
  stop;
  o: procedure(k) returns(fixed);
  declare k fixed;
  if k > 2 then return(1);
  if k < 2 then return(4);
  return(8);
  end o;
end c8;

