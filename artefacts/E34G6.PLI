e34g6: procedure options(main);
   declare p pointer, jq pointer, s character(6) varying, q fixed;
   declare 1 nd based, 2 nn fixed, 2 w character(6) varying;
   allocate nd set(p);
   s = 'AB';
   p->nn = 5;
   call sub(p, s);
   put list('q=', q);
  stop;
  sub: procedure(base, t);
   declare base pointer, t character(6) varying;
   declare u character(6) varying, r fixed;
   base->w = t;

  end sub;
end e34g6;
