e34d1: procedure options(main);
   declare s character(6) varying, q fixed;
   s = 'AB';
   q = f(s);
   put list('q=', q);
  stop;
   f: procedure(x) returns(fixed);
      declare x character(6) varying, y character(6) varying;
      y = 'CD';
      if x = y then return(7);
      end;
end e34d1;
