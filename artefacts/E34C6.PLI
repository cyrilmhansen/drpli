e34c6: procedure options(main);
   declare s character(6) varying, q fixed, hp pointer;
   declare 1 nd based, 2 w character(6) varying;
   allocate nd set(hp);
   s = 'AB';
   hp->w = s;
   q = f(s);
   put list('q=', q);
   free hp->nd;
  stop;
   f: procedure(x) returns(fixed);
      declare x character(6) varying, p pointer;
      p = hp;
      if x = p->w then return(7);
      else return(9);
      end;
end e34c6;
