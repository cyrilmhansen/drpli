PL/I-80 V1.4 COMPILATION OF: E49F3

   1 a 0000 E49F3:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P3] ordered relation `<= ' between equal-extent
   4 a 0006      members.  A distinct skip byte or helper from F1 is possible
   5 a 0006      -- the four relations are not one mechanism.  Verdict, helper,
   6 a 0006      lengths and branch are each measured independently in the
   7 a 0006      object. */
   8 c 0006   dcl
   9 c 0006     1 rec,
  10 c 0006       2 na char(3),
  11 c 0006       2 nb char(3),
  12 c 0006       2 s2 char(2);
  13 c 0006   dcl k fixed bin(15);
  14 c 0006   if rec.na <= rec.nb then k = 1;
  15 c 001D   put list('K=', k);
  16 c 003F   stop;
  17 a 0042 end E49F3;

CODE SIZE = 0042
DATA AREA = 000C
FREE SYMS = 3888
END  COMPILATION
