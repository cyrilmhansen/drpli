PL/I-80 V1.4 COMPILATION OF: E49E1

   1 a 0000 E49E1:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P3] literal LEFT, longer than the extent: 'ABCD' vs
   4 a 0006      rec.na char(3).  E49A4 measured the INVERSE orientation
   5 a 0006      (member LEFT, literal RIGHT: [C336] ACCEPTED, literal pooled
   6 a 0006      WHOLE, positional `06 03 / 3E 04') and P1 RESULTS s2.6
   7 a 0006      explicitly refuses to extrapolate to this one.  H-CE accepts
   8 a 0006      on E48E7's direct template with positional lengths `06 04 / 3E
   9 a 0006      03' and the full pool; falsifiers: refusal, a TRUNCATED pool
  10 a 0006      literal, or min/max length readings. */
  11 c 0006   dcl
  12 c 0006     1 rec,
  13 c 0006       2 na char(3),
  14 c 0006       2 nb char(3),
  15 c 0006       2 s2 char(2);
  16 c 0006   dcl k fixed bin(15);
  17 c 0006   if 'ABCD' = rec.na then k = 1;
  18 c 001C   put list('K=', k);
  19 c 003E   stop;
  20 a 0041 end E49E1;

CODE SIZE = 0041
DATA AREA = 0010
FREE SYMS = 386C
END  COMPILATION
