PL/I-80 V1.4 COMPILATION OF: E49D4

   1 a 0000 E49D4:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P3] BARE fixed member to the RIGHT of a literal (`'AB'
   4 a 0006      = na') -- the P1 asymmetry: E49A2 admitted bare LEFT-of-
   5 a 0006      literal ([C335]) and P1 RESULTS s2.4 scopes that finding to
   6 a 0006      the left side; E48E7's literal-left route has only ever been
   7 a 0006      sampled QUALIFIED.  If accepted, byte-identical to E48E7 but
   8 a 0006      the module name; if refused, the asymmetry becomes a measured
   9 a 0006      DR law instead of an untested mirror. */
  10 c 0006   dcl
  11 c 0006     1 rec,
  12 c 0006       2 na char(3),
  13 c 0006       2 nb char(3),
  14 c 0006       2 s2 char(2);
  15 c 0006   dcl k fixed bin(15);
  16 c 0006   if 'AB' = na then k = 1;
  17 c 001C   put list('K=', k);
  18 c 003E   stop;
  19 a 0041 end E49D4;

CODE SIZE = 0041
DATA AREA = 000E
FREE SYMS = 3870
END  COMPILATION
