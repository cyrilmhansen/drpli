PL/I-80 V1.4 COMPILATION OF: E49C2

   1 a 0000 E49C2:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P3] the INVERSION of E49C1: literal LEFT, member
   4 a 0006      RIGHT, lengths EQUAL.  E48E7 (2/3) carried `21 *D(member) / 11
   5 a 0006      *D(pool) / 06 02 / 3E 03' -- direct, no EB, CODE 65.  No
   6 a 0006      shared rule is presupposed with E49C1: H-AK-L keeps `06 03 /
   7 a 0006      3E 03' (CODE 65); H-AC-L collapses to `06 03 / 78' (CODE 64).
   8 a 0006      A split verdict between the two orientations is a first-class
   9 a 0006      outcome. */
  10 c 0006   dcl
  11 c 0006     1 rec,
  12 c 0006       2 na char(3),
  13 c 0006       2 nb char(3),
  14 c 0006       2 s2 char(2);
  15 c 0006   dcl k fixed bin(15);
  16 c 0006   if 'ABC' = rec.na then k = 1;
  17 c 001B   put list('K=', k);
  18 c 003D   stop;
  19 a 0040 end E49C2;

CODE SIZE = 0040
DATA AREA = 000F
FREE SYMS = 386E
END  COMPILATION
