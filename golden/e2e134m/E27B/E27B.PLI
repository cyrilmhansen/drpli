e27b:
    procedure options(main);
    declare (a, b) fixed;
    a = 1;
    b = 2;
    call s(a);
    call t(b);
    stop;
    s: procedure (x);
       declare x fixed;
       x = x + 1;
    end s;
    t: procedure (y);
       declare y fixed;
       call s(y);
    end t;
end e27b;

