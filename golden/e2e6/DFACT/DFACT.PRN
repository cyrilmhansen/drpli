PL/I-80 V1.4 COMPILATION OF: DFACT

   1   0000 /******************************************************/
   2   0000 /* This program evaluates the Factorial function (n!) */
   3   0000 /* using recursion and FIXED DECIMAL data.            */
   4   0000 /******************************************************/
   5 a 0000 dfact:
       0000       LXI  B,0200
       0003       CALL ?START
   6 a 0006      procedure options(main);
   7 c 0006      declare 
   8 c 0006         i fixed;
   9 c 0006      do i = 0 repeat(i+1);
       0006       LXI  H,0000
       0009       SHLD I A(0014)
  10 c 000C         put skip list('Factorial(',i,')=',factorial(i));
       000C       LXI  D,0252
       000F       LXI  B,0000
       0012       CALL ?SYSPR
       0015       MVI  A,01
       0017       CALL ?SKPOP
       001A       LXI  H,* S(0000)
       001D       MVI  A,0A
       001F       CALL ?SLCTS
       0022       CALL ?PNCOP
       0025       LHLD I A(0014)
       0028       MVI  A,09
       002A       CALL ?QICOP
       002D       CALL ?PNVOP
       0030       LXI  H,* S(000A)
       0033       MVI  A,02
       0035       CALL ?SLCTS
       0038       CALL ?PNCOP
       003B       LXI  H,* A(0016)
       003E       CALL 0000
       0041       MVI  A,12
       0043       MVI  B,00
       0045       CALL ?QDCOP
       0048       CALL ?PNVOP
       004B       CALL ?QIOOP
       0010       ==== 004E
       004E       LHLD I A(0014)
       0051       INX  H
       0052       SHLD I A(0014)
       0055       JMP  000C
  11 c 0058      end;
  12 c 0058      stop;
  13 c 0058 
  14 c 0058      factorial:
  15 c 0058           procedure(i) returns(fixed decimal(15,0)) 
  16 c 0058                        recursive;
  17 e 0058           declare 
       0058       LXI  B,0008
       005B       LXI  D,0018
       005E       CALL ?SVBLK
       0061       MOV  E,M
       0062       INX  H
       0063       MOV  D,M
       0064       XCHG 
       0065       SHLD I A(0018)
       0068       LHLD I A(0018)
       006B       MOV  E,M
       006C       INX  H
       006D       MOV  D,M
       006E       XCHG 
       006F       SHLD I A(001A)
  18 e 0072              i fixed;
  19 e 0072 
  20 e 0072           if i = 0 then return (1);
       0072       LXI  H,I A(001A)
       0075       MOV  A,M
       0076       INX  H
       0077       ORA  M
       0078       JNZ  0000
       007B       LXI  H,* S(000C)
       007E       MVI  A,0F
       0080       CALL ?DLDOP
       0083       CALL ?RSBLK
       0086       JMP  ?DCRET
       0079       ==== 0089
  21 e 0089           return (decimal(i,15) * factorial(i-1));
       0089       LHLD I A(001A)
       008C       DCX  H
       008D       SHLD * A(001E)
       0090       LXI  H,* A(001C)
       0093       CALL FACTORIAL
       0096       LHLD I A(001A)
       0099       CALL ?QI15D
       009C       CALL ?DMUOP
       009F       CALL ?RSBLK
       00A2       JMP  ?DCRET
  22 c 00A5      end factorial;
  23 c 00A5 
  24 a 00A5 end dfact;
  25 a 00A5 

