       0044       LXI  B,0000
       0047       CALL ?SYSPR
       004A       LXI  H,* S(000A)
       004D       MVI  A,0A
       004F       CALL ?SLCTS
       0052       CALL ?PNCOP
       0055       CALL ?QIOOP
       0045       ==== 0058
  20 c 0058        get list(i);
       0058       LXI  D,0290
       005B       LXI  B,0000
       005E       CALL ?SYSIN
       0061       CALL ?GNVOP
       0064       JP   0000
       0067       MVI  B,02
       0069       CALL ?QCDOP
       006C       LXI  H,I A(0039)
       006F       MVI  A,04
       0071       CALL ?DSTOP
       0065       ==== 0074
       0074       CALL ?QIOOP
       005C       ==== 0077
  21 c 0077        put list('Payment   ');
       0077       LXI  D,0252
       007A       LXI  B,0000
       007D       CALL ?SYSPR
       0080       LXI  H,* S(0014)
       0083       MVI  A,0A
       0085       CALL ?SLCTS
       0088       CALL ?PNCOP
       008B       CALL ?QIOOP
       007B       ==== 008E
  22 c 008E        get list(PMT);
       008E       LXI  D,0290
       0091       LXI  B,0000
