  30 c 010D              end;
  31 c 010D           m = m + 1;
       010D       LHLD M A(002B)
       0110       INX  H
       0111       SHLD M A(002B)
  32 c 0114           put skip list(m,P);
       0114       LXI  D,0252
       0117       LXI  B,0000
       011A       CALL ?SYSPR
       011D       MVI  A,01
       011F       CALL ?SKPOP
       0122       LHLD M A(002B)
