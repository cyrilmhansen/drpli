       0135       MVI  A,0E
       0137       MVI  B,02
       0139       CALL ?QDCOP
       013C       CALL ?PNVOP
       013F       CALL ?QIOOP
       0118       ==== 0142
  33 c 0142           P = P + round( i * P / 1200, 2);
       0142       LXI  H,I A(0039)
       0145       MVI  A,04
       0147       CALL ?DLDOP
       014A       LXI  H,P A(002F)
       014D       MVI  A,0B
       014F       CALL ?DLDOP
       0152       CALL ?DMUOP
       0155       LXI  H,* S(0028)
       0158       MVI  A,04
