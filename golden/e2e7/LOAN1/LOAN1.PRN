       018A       LXI  H,PMT A(0035)
       018D       MVI  A,06
       018F       CALL ?DLDOP
       0192       CALL ?DCMOP
       0195       JP   0000
  35 c 0198              then PMT = P;
       0198       LXI  H,P A(002F)
       019B       MVI  A,0B
       019D       CALL ?DLDOP
       01A0       LXI  H,PMT A(0035)
       01A3       MVI  A,06
       01A5       CALL ?DSTOP
       0196       ==== 01A8
  36 c 01A8           put list(PMT);
       01A8       LXI  D,0252
       01AB       LXI  B,0000
       01AE       CALL ?SYSPR
       01B1       LXI  H,PMT A(0035)
       01B4       MVI  A,06
       01B6       CALL ?DLDOP
       01B9       MVI  A,09
       01BB       MVI  B,02
       01BD       CALL ?QDCOP
       01C0       CALL ?PNVOP
       01C3       CALL ?QIOOP
       01AC       ==== 01C6
  37 c 01C6           P = P - PMT;
       01C6       LXI  H,P A(002F)
       01C9       MVI  A,0B
       01CB       CALL ?DLDOP
       01CE       LXI  H,PMT A(0035)
       01D1       MVI  A,06
       01D3       CALL ?DLDOP
       01D6       CALL ?DSUOP
       01D9       LXI  H,P A(002F)
       01DC       MVI  A,0B
       01DE       CALL ?DSTOP
       01E1       JMP  00B6
       00CA       ==== 01E4
       01E4       JMP  0006
  38 c 01E7        end;
  39 c 01E7     end;
  40 c 01E7   
  41 a 01E7 end loan1;

