       0097       CALL ?GNVOP
       009A       JP   0000
       009D       MVI  B,02
       009F       CALL ?QCDOP
       00A2       LXI  H,PMT A(0035)
       00A5       MVI  A,06
       00A7       CALL ?DSTOP
       009B       ==== 00AA
       00AA       CALL ?QIOOP
       0092       ==== 00AD
  23 c 00AD        m = 0;
       00AD       LXI  H,0000
       00B0       SHLD M A(002B)
  24 c 00B3        y = 0;
       00B3       SHLD Y A(002D)
  25 c 00B6        do while (P > 0);
       00B6       LXI  H,* S(001E)
       00B9       MVI  A,0B
       00BB       CALL ?DLDOP
       00BE       LXI  H,P A(002F)
       00C1       MVI  A,0B
       00C3       CALL ?DLDOP
       00C6       CALL ?DCMOP
       00C9       JP   0000
  26 c 00CC           if mod(m,12) = 0 then
       00CC       LHLD M A(002B)
       00CF       MVI  A,0C
       00D1       PUSH H
       00D2       MOV  L,A
       00D3       ADD  A
       00D4       SBB  A
       00D5       MOV  H,A
       00D6       POP  D
       00D7       CALL ?IMDOP
       00DA       MOV  A,H
       00DB       ORA  L
       00DC       JNZ  0000
  27 c 00DF              do;
  28 c 00DF                y = y + 1;
       00DF       LHLD Y A(002D)
       00E2       INX  H
       00E3       SHLD Y A(002D)
  29 c 00E6                put skip list('Year',y);
       00E6       LXI  D,0252
       00E9       LXI  B,0000
       00EC       CALL ?SYSPR
       00EF       MVI  A,01
       00F1       CALL ?SKPOP
       00F4       LXI  H,* S(0024)
