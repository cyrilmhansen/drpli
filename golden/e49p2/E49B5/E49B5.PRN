PL/I-80 V1.4 COMPILATION OF: E49B5

   1 a 0000 E49B5:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P2] the member-vs-member compare with ^=.  [C333]
   4 a 0006      measured the CA skip byte in the ?SCCCM family only member-vs-
   5 a 0006      LITERAL (E49A3); [C072] says CA everywhere.  This measures the
   6 a 0006      skip byte on a member-vs-member head -- same head as E49B1's
   7 a 0006      winner, skip 0xca, fill = the next statement ([C309]). */
   8 c 0006   dcl
   9 c 0006     1 rec,
  10 c 0006       2 na char(3),
  11 c 0006       2 nb char(3),
  12 c 0006       2 s2 char(2);
  13 c 0006   dcl k fixed bin(15);
  14 c 0006   if rec.na ^= rec.nb then k = 1;
  15 c 001D   put list('K=', k);
  16 c 003F   stop;
  17 a 0042 end E49B5;

CODE SIZE = 0042
DATA AREA = 000C
FREE SYMS = 3888
END  COMPILATION
