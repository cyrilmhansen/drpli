PL/I-80 V1.4 COMPILATION OF: E521B

   1 a 0000 E521B: procedure options(main);
   2 a 0006    /* E2E-52/P3-15 probe B (PLAN H-A): the TARGET */
   3 a 0006    /* class - file EDIT item is a deref'd FIXED */
   4 a 0006    /* DEC FORMAL; LHLD prep at the descriptor cell */
   5 a 0006    /* written by the block-copy prologue. */
   6 c 0006    dcl pf file;
   7 c 0006    dcl v fixed dec(10,2);
   8 c 0006    dcl w fixed dec(10,2);
   9 c 0006 
  10 c 0006    open file(pf) print;
  11 c 001B    call show(v,w);
  12 c 0021    put skip list(v);
  13 c 0044 
  14 c 0044 show: procedure(x,y);
  15 e 0044    dcl x fixed dec(10,2);
  16 e 0054    dcl y fixed dec(10,2);
  17 e 0054    put file(pf) edit('|',x)(a,p'$zzz,zz9.v99');
  18 e 0086    put skip list(x);
  19 c 00AA    end show;
  20 a 00AA end E521B;

CODE SIZE = 00AD
