  14 e 003D    dcl yp fixed binary;
  15 e 0047    dcl i fixed decimal(10,2);
  16 e 0047    yp = y;
  17 e 004D    put skip file(pf) edit
  18 e 00C6       ('|','Interest Paid During ''',yp,'-''',y,' is ',i,'|')
  19 e 00C6       (a,x(15),2(a,p'99'),a,p'$$$,$$$,$$9V.99',x(16),a);
  20 e 00C6    put skip list(yp);
  21 c 00E3    end cy;
  22 a 00E3 end E523B;

