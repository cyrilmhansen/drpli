PL/I-80 V1.4 COMPILATION OF: E523B

   1 a 0000 E523B: procedure options(main);
   2 a 0006    /* E2E-52/P3-17 probe B (PLAN H-B): the exact */
   3 a 0006    /* LOAN2 177-178 statement class - put skip   */
   4 a 0006    /* file EDIT list with a LOCAL fixed-bin auto,*/
   5 a 0006    /* a MAIN fixed-bin auto and a deref'd DEC    */
   6 a 0006    /* formal in ONE list; LOAN2 format verbatim. */
   7 c 0006    dcl pf file;
   8 c 0006    dcl y fixed binary;
   9 c 0006    dcl q fixed decimal(10,2);
  10 c 0006    open file(pf) print;
  11 c 001B    call cy(q);
  12 c 0021    put skip list(y);
