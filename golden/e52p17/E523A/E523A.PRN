PL/I-80 V1.4 COMPILATION OF: E523A

   1 a 0000 E523A: procedure options(main);
   2 a 0006    /* E2E-52/P3-17 probe A (PLAN H-A): FILE PUT  */
   3 a 0006    /* EDIT whose item is a MAIN-AUTO fixed-bin   */
   4 a 0006    /* variable; literal twins and the LOAN2      */
   5 a 0006    /* 2(a,p'99') nested-rep format kept.         */
   6 c 0006    dcl pf file;
   7 c 0006    dcl a fixed binary;
   8 c 0006    open file(pf) print;
   9 c 001B    a = 7;
  10 c 0021    put file(pf) edit('|','XX',a,'|')(a,x(15),2(a,p'99'),a);
  11 c 0062    put skip list(a);
  12 a 007E end E523A;

CODE SIZE = 0081
DATA AREA = 0019
FREE SYMS = 388F
END  COMPILATION
