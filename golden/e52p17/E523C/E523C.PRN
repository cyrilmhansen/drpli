PL/I-80 V1.4 COMPILATION OF: E523C

   1 a 0000 E523C: procedure options(main);
   2 a 0006    /* E2E-52/P3-17 probe C (PLAN H-C boundary):  */
   3 a 0006    /* the EDIT item is a STATIC fixed-bin        */
   4 a 0006    /* variable -- the storage class the authentic*/
   5 a 0006    /* LOAN2 object does NOT answer (its fixed-   */
   6 a 0006    /* bin items are autos). Verdict as measured. */
   7 c 0006    dcl pf file;
   8 c 0006    dcl s fixed binary static;
   9 c 0006    open file(pf) print;
  10 c 001B    put file(pf) edit('|',s)(a,2(a,p'99'));
  11 c 0046    put skip list(s);
  12 a 0062 end E523C;

CODE SIZE = 0065
