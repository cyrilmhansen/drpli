PL/I-80 V1.4 COMPILATION OF: E46L17

   1 a 0000 E46L17:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2a] runtime 6: the file route AND the console route in one program.  A PUT FILE
   4 a 0006      must not disturb SYSIN/SYSOUT's control blocks (E16D's note: DR's file runtime uses
   5 a 0006      FCB#0 for the console and attaches user files at 0x005C).  If the file PUT clobbered the
   6 a 0006      console the second line would not appear. */
   7 c 0006   dcl outf file, v char(20) varying;
   8 c 0006   v = 'FILE';
   9 c 0013   put list('CON');
  10 c 002A   open file(outf) stream output title('L17OUT DAT');
  11 c 0047   put file(outf) list(v);
  12 c 005F   close file(outf);
  13 c 0065   put list('AGAIN');
  14 c 007C   stop;
  15 a 007F end E46L17;

CODE SIZE = 007F
DATA AREA = 002B
FREE SYMS = 3851
END  COMPILATION
