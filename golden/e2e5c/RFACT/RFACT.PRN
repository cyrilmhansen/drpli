       001F       CALL ?SLCTS
       0022       CALL ?PNCOP
       0025       LHLD I A(000C)
       0028       MVI  A,09
       002A       CALL ?QICOP
       002D       CALL ?PNVOP
       0030       LXI  H,* S(000A)
       0033       MVI  A,02
       0035       CALL ?SLCTS
       0038       CALL ?PNCOP
       003B       LXI  H,* A(000E)
       003E       CALL 0000
       0041       MVI  A,09
       0043       CALL ?QICOP
       0046       CALL ?PNVOP
       0049       CALL ?QIOOP
       0010       ==== 004C
       004C       LHLD I A(000C)
       004F       INX  H
       0050       SHLD I A(000C)
       0053       JMP  000C
  11 c 0056      end;
  12 c 0056      stop;
  13 c 0056 
  14 c 0056      factorial:
  15 c 0056           procedure(i) returns(fixed) recursive;
  16 e 0056           declare 
       0056       LXI  B,0008
       0059       LXI  D,0010
       005C       CALL ?SVBLK
       005F       MOV  E,M
       0060       INX  H
       0061       MOV  D,M
       0062       XCHG 
       0063       SHLD I A(0010)
       0066       LHLD I A(0010)
       0069       MOV  E,M
       006A       INX  H
       006B       MOV  D,M
       006C       XCHG 
       006D       SHLD I A(0012)
  17 e 0070              i fixed;
  18 e 0070           if i = 0 then return (1);
       0070       LXI  H,I A(0012)
       0073       MOV  A,M
       0074       INX  H
       0075       ORA  M
       0076       JNZ  0000
       0079       LXI  H,0001
       007C       CALL ?RSBLK
       007F       RET  
       0077       ==== 0080
  19 e 0080           return (i * factorial(i-1));
       0080       LHLD I A(0012)
