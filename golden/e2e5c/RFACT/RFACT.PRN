   1   0000 /******************************************************/
   2   0000 /* This program evaluates the Factorial function (n!) */
   3   0000 /* using recursion.                                   */
   4   0000 /******************************************************/
   5 a 0000 rfact:
       0000       LXI  B,0200
       0003       CALL ?START
   6 a 0006      procedure options(main);
   7 c 0006      declare 
   8 c 0006         i fixed;
   9 c 0006      do i = 0 repeat(i+1);
       0006       LXI  H,0000
       0009       SHLD I A(000C)
  10 c 000C         put skip list('factorial(',i,')=',factorial(i));
       000C       LXI  D,0252
       000F       LXI  B,0000
       0012       CALL ?SYSPR
       0015       MVI  A,01
       0017       CALL ?SKPOP
       001A       LXI  H,* S(0000)
