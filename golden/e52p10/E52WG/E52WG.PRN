PL/I-80 V1.4 COMPILATION OF: E52WG

   1 a 0000 E52WG: procedure options(main);
   2 a 0006 
   3 a 0006    /* E52WG probe (PLAN sec P3-10 panel D): SIGNAL
   4 a 0006       ERROR(n) with n a declared FIXED BINARY variable --
   5 a 0006       a dynamic operand. No historical witness decides
   6 a 0006       acceptance. VERDICT UNKNOWN; if accepted, decode the
   7 a 0006       evaluation order, operand register and storage
   8 a 0006       interaction from the object. Do not generalize. */
   9 a 0006 
  10 c 0006    dcl n fixed binary;
  11 c 0006    dcl x fixed bin;
  12 c 0006 
  13 c 0006    n = 1;
  14 c 000C    signal error(n);
  15 c 0013    x = 2;
  16 c 0019 
  17 a 0019 end E52WG;

CODE SIZE = 001C
DATA AREA = 0004
FREE SYMS = 38BB
END  COMPILATION
