   1   0000 /******************************************************/
   2   0000 /* This program evaluates the Factorial function (n!) */
   3   0000 /* using iteration.                                   */
   4   0000 /******************************************************/
   5 a 0000 ifact:
       0000       LXI  B,0200
       0003       CALL ?START
   6 a 0006      procedure options(main);
   7 c 0006      declare 
   8 c 0006         (i, n, F) fixed;
   9 c 0006 
  10 c 0006      do i = 0 by 1;
       0006       LXI  H,0000
       0009       SHLD I A(001B)
  11 c 000C         F = 1;
       000C       LXI  H,0001
       000F       SHLD F A(001F)
  12 c 0012         do n = i to 1 by -1;
       0012       LHLD I A(001B)
       0015       SHLD N A(001D)
       0018       LHLD N A(001D)
       001B       DCX  H
       001C       MOV  A,H
       001D       ORA  A
       001E       JM   0000
  13 c 0021            F = n * F;
       0021       LHLD N A(001D)
       0024       PUSH H
       0025       LHLD F A(001F)
       0028       POP  D
       0029       CALL ?IM22N
       002C       SHLD F A(001F)
       002F       LHLD N A(001D)
       0032       DCX  H
       0033       SHLD N A(001D)
       0036       JMP  0018
       001F       ==== 0039
  14 c 0039         end;
  15 c 0039         put edit('factorial(',i,')=',F)
       0039       LXI  D,0252
       003C       LXI  B,0000
       003F       CALL ?SYSPR
       0042       LXI  H,* S(0000)
       0045       CALL ?EDITF
       0048       LXI  H,* S(000F)
       004B       MVI  A,0A
       004D       CALL ?SLCTS
       0050       CALL ?EDTOV
       0053       LHLD I A(001B)
       0056       MVI  A,09
       0058       CALL ?QICOP
       005B       CALL ?EDTOV
       005E       LXI  H,* S(0019)
       0061       MVI  A,02
       0063       CALL ?SLCTS
       0066       CALL ?EDTOV
       0069       LHLD F A(001F)
       006C       MVI  A,09
       006E       CALL ?QICOP
       0071       CALL ?EDTOV
       0074       CALL ?QIOOP
       003D       ==== 0077
       0077       LHLD I A(001B)
       007A       INX  H
       007B       SHLD I A(001B)
       007E       JMP  000C
