   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: E48A1

   1 a 0000 E48A1:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P1] THE NEGATED BIT TEST IN A LOOP HEAD.  CREATE:31
   4 a 0006      spells exactly this and DR carries it at 0052-0058 as
   5 a 0006      LDA/ORA/FA plus the 5-byte skip chain whose tail is
   6 a 0006      JMP-back.  Mine refuses it: `condition form not in
   7 a 0006      E2E-3b subset [TBD]: (^ eofile)'. */
   8 c 0006   dcl b bit(1) static initial('0'b);
   9 c 0006   dcl n fixed bin(15);
  10 c 0006   n = 0;
  11 c 000C   do while(^b);
  12 c 0013      n = n + 1;
  13 c 001A      put list('.');
  14 c 0031      if n = 3 then b = '1'b;
  15 c 0044   end;
  16 c 0044   put list('N=', n);
  17 c 0066   stop;
  18 a 0069 end E48A1;

CODE SIZE = 0069
DATA AREA = 0006
FREE SYMS = 3877
END  COMPILATION
