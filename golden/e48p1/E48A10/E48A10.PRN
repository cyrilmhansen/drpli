PL/I-80 V1.4 COMPILATION OF: E48A10

   1 a 0000 E48A10:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P1] `f = (b = '1'b)'.  The ANI 80 / SUI 80 ladder
   4 a 0006      ([C112], E11D) has never been materialised into a byte; if
   5 a 0006      DR accepts, the boolean comes from SUI/SBB on the ladder's
   6 a 0006      result. */
   7 c 0006   dcl b bit(1) static initial('0'b);
   8 c 0006   dcl f bit(1);
   9 c 0006   f = (b = '1'b);
  10 c 0013   put list('U=', f);
  11 c 0035   stop;
  12 a 0038 end E48A10;

CODE SIZE = 0038
DATA AREA = 0004
FREE SYMS = 38AD
END  COMPILATION
