PL/I-80 V1.4 COMPILATION OF: E48B7

   1 a 0000 E48B7:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P1 r2] TWO STATIC BITS and a STATIC FILE-like order:
   4 a 0006      static cell adjacency (b at 0000, c at 0001) with a literal
   5 a 0006      ABOVE them, i.e. the [C114] block order with two statics. */
   6 c 0006   dcl b bit(1) static initial('1'b);
   7 c 0006   dcl c bit(1) static initial('0'b);
   8 c 0006   if ^b then
   9 c 000D      put list('N');
  10 c 0024   if c then
  11 c 002B      put list('P');
  12 c 0045   else
  13 c 0045      put list('Q');
  14 c 005C   stop;
  15 a 005F end E48B7;

CODE SIZE = 005F
DATA AREA = 0005
FREE SYMS = 388F
END  COMPILATION
