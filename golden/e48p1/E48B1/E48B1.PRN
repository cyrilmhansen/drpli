COMPILATION OF: E48B1

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: E48B1

   1 a 0000 E48B1:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P1 r2] `if ^b then do; ... end;' with NO ELSE, which
   4 a 0006      is CREATE:35 exactly.  E48A2 measured the WITH-else form;
   5 a 0006      CREATE needs this one. */
   6 c 0006   dcl b bit(1) static initial('0'b);
   7 c 0006   dcl n fixed bin(15);
   8 c 0006   n = 0;
   9 c 000C   do while(^b);
  10 c 0013      n = n + 1;
  11 c 001A      if ^b then
  12 c 0021         do;
  13 c 0021         n = n + 1;
  14 c 0028         end;
  15 c 0028      if n = 4 then b = '1'b;
  16 c 003C   end;
  17 c 003C   put list('N=', n);
  18 c 005E   stop;
  19 a 0061 end E48B1;

CODE SIZE = 0061
DATA AREA = 0005
FREE SYMS = 388D
END  COMPILATION
