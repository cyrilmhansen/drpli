   7 c 0006   dcl c bit(1) static initial('1'b);
   8 c 0006   if b then
   9 c 000D      put list('B');
  10 c 0024   if c then
  11 c 002B      put list('C');
  12 c 0042   stop;
  13 a 0045 end E48B5;

