PL/I-80 V1.4 COMPILATION OF: E48B6

   1 a 0000 E48B6:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P1 r2] A STATIC CHARACTER: my codegen refuses every
   4 a 0006      STATIC except BIT(1) ("unsampled [TBD]"), and EXPR2, FSCAN,
   5 a 0006      LOAN2, MPMCALLB and REPORT all stop there.  This measures
   6 a 0006      DR's cell for the simplest one -- the evidence the next phase
   7 a 0006      needs, whether or not this phase uses it. */
   8 c 0006   dcl s char(3) static initial('AB');
   9 c 0006   put list(s);
  10 c 001D   stop;
  11 a 0020 end E48B6;

CODE SIZE = 0020
DATA AREA = 0003
FREE SYMS = 38DC
END  COMPILATION
