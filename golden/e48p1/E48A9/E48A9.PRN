PL/I-80 V1.4 COMPILATION OF: E48A9

   1 a 0000 E48A9:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P1] `b = (k > 0)'.  [C095] records `>' only as the
   4 a 0006      FIRST operand of a FLOAT conjunction, where DR uses the raw
   5 a 0006      signed-comparison byte AS the boolean and materialises
   6 a 0006      nothing.  Predicted UNMEASURED here, and a refusal
   7 a 0006      (`COMP REQ ?') is as informative as a lowering. */
   8 c 0006   dcl b bit(1) static initial('0'b);
   9 c 0006   dcl k fixed bin(15);
  10 c 0006   k = 3;
  11 c 000C   b = (k > 0);
  12 c 0016   put list('S=', b);
  13 c 0038   stop;
  14 a 003B end E48A9;

CODE SIZE = 003B
DATA AREA = 0005
FREE SYMS = 38A3
END  COMPILATION
