PL/I-80 V1.4 COMPILATION OF: E48B2

   1 a 0000 E48B2:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P1 r2] a bare `if b then do; ... end;' (positive,
   4 a 0006      no else) on a STATIC bit: the control for E48B1, and the
   5 a 0006      FLTPOLY2 shape spelled directly. */
   6 c 0006   dcl b bit(1) static initial('1'b);
   7 c 0006   if b then
   8 c 000D      do;
   9 c 000D      put list('Y');
  10 c 0024      end;
  11 c 0024   put list('E');
  12 c 003B   stop;
  13 a 003E end E48B2;

