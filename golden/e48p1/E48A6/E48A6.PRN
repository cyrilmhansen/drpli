PL/I-80 V1.4 COMPILATION OF: E48A6

   1 a 0000 E48A6:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P1] THE STORE OF A CONDITION INTO A BIT(1), exactly
   4 a 0006      CREATE:34: `eofile = (name = 'EOF')'.  DR at 008F-00A0, 16
   5 a 0006      bytes: LXI H,varying / XCHG / LXI H,literal / MVI A,n /
   6 a 0006      CALL ?SCVCM / SUI 01 / SBB A / STA cell.  The last three are
   7 a 0006      [C095]'s flag trick, then [C079]'s 32-with-inline-reloc
   8 a 0006      store; the store form (not the comparison) is the question. */
   9 c 0006   dcl b bit(1) static initial('0'b);
  10 c 0006   dcl name char(30) varying;
  11 c 0006   name = 'AB';
  12 c 0013   b = (name = 'EOF');
  13 c 0024   put list('B=', b);
  14 c 0046   stop;
  15 a 0049 end E48A6;

CODE SIZE = 0049
DATA AREA = 0027
FREE SYMS = 3884
END  COMPILATION
