PL/I-80 V1.4 COMPILATION OF: E48A5

   1 a 0000 E48A5:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P1] THE SAME NEGATED TEST ON AN AUTOMATIC BIT(1).
   4 a 0006      RETRIEVE:17/34 and DIOCOPY:40/109 declare `eofile bit(1)'
   5 a 0006      with NO static and test `^eofile'; their objects are in
   6 a 0006      golden/first8080u but neither compiles in this compiler for
   7 a 0006      OPEN/BASED reasons, so the automatic bit cell's test is
   8 a 0006      UNMEASURED here.  Prediction: identical 3A/B7/FA, one-byte
   9 a 0006      cell, AUTO STORAGE +1 ([C114]). */
  10 c 0006   dcl b bit(1);
  11 c 0006   dcl n fixed bin(15);
  12 c 0006   b = '0'b;
  13 c 000B   n = 0;
  14 c 0011   do while(^b);
  15 c 0018      n = n + 1;
  16 c 001F      if n = 2 then b = '1'b;
  17 c 0031   end;
  18 c 0031   put list('N=', n);
  19 c 0053   stop;
  20 a 0056 end E48A5;

CODE SIZE = 0056
DATA AREA = 0005
FREE SYMS = 3882
END  COMPILATION
