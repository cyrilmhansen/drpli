COMPILATION OF: E36H8

C: Code Trace Only
D: Disk Print
L: List Source Program
S: Symbol Table List

  SYMBOLS:

BLOCK AT LINE 1, AUTO STORAGE 0 BYTES
a 0000 H8 ENTRY PARAMETERS(0) EXTERNAL CONSTANT
BLOCK AT LINE 2, AUTO STORAGE 4 BYTES
c 0000 N FIXED BINARY(15,0) AUTOMATIC
c 0002 M FIXED BINARY(15,0) AUTOMATIC
   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: E36H8

   1 a 0000 h8: procedure options(main);
       0000       LXI  B,0200
       0003       CALL ?START
   2 c 0006    declare n fixed, m fixed;
   3 c 0006    n = 5;
       0006       LXI  H,0005
       0009       SHLD N A(0000)
   4 c 000C    if m = 0 then m = 1;
       000C       LXI  H,M A(0002)
       000F       MOV  A,M
       0010       INX  H
       0011       ORA  M
       0012       JNZ  0000
       0015       LXI  H,0001
       0018       SHLD M A(0002)
       0013       ==== 001B
   5 c 001B    n = 6;
       001B       LXI  H,0006
       001E       SHLD N A(0000)
   6 c 0021    stop;
       0021       CALL ?STOPX
   7 a 0024 end h8;

CODE SIZE = 0024
DATA AREA = 0004
FREE SYMS = 38A8
END  COMPILATION
