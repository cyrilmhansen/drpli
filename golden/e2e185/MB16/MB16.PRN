PL/I-80 V1.4 COMPILATION OF: MB16

   1   0000     program mulprobe-return;   [E2E-15 MB16: n*2 inside a RETURN expression -- the exact shape that blocks D3/D4/D5/D9]
TRUNC                                                                                                                            ?
   2 a 0000         fixed n, m;
   3 a 0000         procedure f returns fixed;   fixed j;
   4 a 0000             begin f = j + 1; end;
   5 a 0000         procedure g returns fixed;   fixed p;
   6 a 0000             begin p = 4; return (p * 2); end;
   7 a 0000         begin
   8 a 0000             n = 7;
   9 a 0000             m = g;
  10 a 0000             put fixed(6) (m);
  11 a 0000         end.

