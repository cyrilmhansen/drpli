COMPILATION OF: ACK

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: ACK

   1   0000 /******************************************************/
   2   0000 /* This program evaluates the Ackermann function      */
   3   0000 /* A(m,n), and increases the size of the stack        */
   4   0000 /* because of the large number of recursive calls.    */
   5   0000 /******************************************************/
   6 a 0000 ack:
   7 a 0006     procedure options(main,stack(2000));
   8 c 0006     declare 
   9 c 0006         (m,maxm,n,maxn) fixed;
  10 c 0006     put skip list('Type max m,n: ');
  11 c 0022     get list(maxm,maxn);
  12 c 0046     put skip
  13 c 0095         list('         ',(decimal(n,4) do n=0 to maxn));
  14 c 0095     do m = 0 to maxm;
  15 c 00AE        put skip list(decimal(m,4),':');
  16 c 00DA        do n = 0 to maxn;
  17 c 00F3           put list(decimal(ackermann(m,n),4));
  18 c 0126        end;
  19 c 0126     end;
  20 c 0126     stop;
  21 c 0129 
  22 c 0129     ackermann:
  23 c 0129              procedure(m,n) returns(fixed) recursive;
  24 e 0129              declare (m,n) fixed;
  25 e 0153              if m = 0 then
  26 e 015C                 return(n+1);
  27 e 0164              if n = 0 then
  28 e 016D                 return(ackermann(m-1,1));
  29 e 0184              return(ackermann(m-1,ackermann(m,n-1)));
  30 c 01AB     end ackermann;
  31 c 01AB 
  32 a 01AB end ack;
  33 a 01AB 

CODE SIZE = 01AB
DATA AREA = 004A
FREE SYMS = 3719
END  COMPILATION
