COMPILATION OF: EXPR1

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: EXPR1

   1   0000 /******************************************************/
   2   0000 /* This program evaluates an arithmetic expression    */
   3   0000 /* using recursion.  It contains two procedures. GNT  */
   4   0000 /* obtains the input expression consisting of separate*/
   5   0000 /* tokens, and EXP which performs the recursive       */
   6   0000 /* evaluation of the tokens in the input line.        */
   7   0000 /******************************************************/
   8 a 0000 expression:
   9 a 0006     procedure options(main);
  10 c 0006     declare 
  11 c 000D        sysin file,
  12 c 000D        value float,
  13 c 000D        token character(10) varying;
  14 c 000D 
  15 c 000D     on endfile(sysin)
  16 d 0015        stop;
  17 d 001B 
  18 c 001B     on error(1) /* conversion or signal */
  19 d 0022        begin;
  20 e 0025          put skip list('Invalid Input at ',token);
  21 e 004A          get skip;
  22 e 005B          goto restart;
  23 d 005E        end;
  24 d 005E 
  25 c 005E     restart:
  26 c 0065 
  27 c 0065         do while('1'b);
  28 c 0065            put skip(3) list('Type expression: ');
  29 c 0081            value = exp();
  30 c 008A            put skip list('Value is:',value);
  31 c 00B4         end;
  32 c 00B4 
  33 c 00B4     gnt:
  34 c 00B4        procedure; 
  35 e 00B4        get list(token);
  36 c 00CF     end gnt;
  37 c 00CF 
  38 c 00CF     exp:
  39 c 00CF        procedure returns(float binary) recursive;
  40 e 00CF        declare x float binary;
  41 e 00D8        call gnt();
  42 e 00DB        if token = '(' then
  43 e 00E9           do;
  44 e 00E9             x  = exp();
  45 e 00F2             call gnt();
  46 e 00F5             if token = '+' then
  47 e 0103                x = x + exp();
  48 e 0115             else
  49 e 0115             if token = '-' then
  50 e 0123                x = x - exp();
  51 e 0135             else
  52 e 0135             if token = '*' then
  53 e 0143                x = x * exp();
  54 e 0155             else
  55 e 0155             if token = '/' then
  56 e 0163                x = x / exp();
  57 e 0175             else
  58 e 0175             signal error(1);
  59 e 017C             call gnt();
  60 e 017F             if token ^= ')' then
  61 e 018D                signal error(1);
  62 e 0197           end;
  63 e 0197        else
  64 e 0197           x = token;
  65 e 01A9        return(x);
  66 c 01B5     end exp;
  67 c 01B5 
  68 a 01B5 end expression;
  69 a 01B5 

CODE SIZE = 01B5
DATA AREA = 0046
FREE SYMS = 370B
END  COMPILATION
