COMPILATION OF: KEYFILE

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: KEYFILE

   1   0000 /******************************************************/
   2   0000 /* This program reads an employee record file and     */
   3   0000 /* creates another file of keys to access the records.*/
   4   0000 /******************************************************/
   5   0000 
   6 a 0000 keyfile:
   7 a 0006     procedure options(main);
   8 c 0006     declare
   9 c 0006        1 employee static,
  10 c 0006          2 name character(30) varying;
  11 c 0006 
  12 c 0006     declare
  13 c 0006        (input, keys) file,
  14 c 0006        k fixed;
  15 c 0006 
  16 c 0006     open file(input) keyed environment(f(128),b(10000)) 
  17 c 002A          title('$1.emp'); 
  18 c 002A 
  19 c 002A     open file(keys) stream output
  20 c 0049          linesize (60) title('$1.key');
  21 c 0049 
  22 c 0049     do while('1');
  23 c 0049        read file(input) into(employee) keyto(k);
  24 c 0067        put skip list(k,name);
  25 c 008C        put file(keys) list(name,k);
  26 c 00AF        if name = 'EOF' then
  27 c 00BE           stop;
  28 c 00C4     end;
  29 c 00C4 
  30 a 00C4 end keyfile;
  31 a 00C4 
  32 a 00C4  

CODE SIZE = 00C4
DATA AREA = 0030
FREE SYMS = 3810
END  COMPILATION
