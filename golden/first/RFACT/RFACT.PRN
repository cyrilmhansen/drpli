PL/I-80 V1.4 COMPILATION OF: RFACT

   1   0000 /******************************************************/
   2   0000 /* This program evaluates the Factorial function (n!) */
   3   0000 /* using recursion.                                   */
   4   0000 /******************************************************/
   5 a 0000 rfact:
   6 a 0006      procedure options(main);
   7 c 0006      declare 
   8 c 0006         i fixed;
   9 c 0006      do i = 0 repeat(i+1);
  10 c 000C         put skip list('factorial(',i,')=',factorial(i));
  11 c 0056      end;
  12 c 0056      stop;
  13 c 0056 
  14 c 0056      factorial:
  15 c 0056           procedure(i) returns(fixed) recursive;
  16 e 0056           declare 
  17 e 0070              i fixed;
  18 e 0070           if i = 0 then return (1);
  19 e 0080           return (i * factorial(i-1));
  20 c 0099      end factorial;
  21 c 0099 
  22 a 0099 end rfact;
  23 a 0099 

CODE SIZE = 0099
DATA AREA = 0018
FREE SYMS = 3827
