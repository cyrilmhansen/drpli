PL/I-80 V1.4 COMPILATION OF: DTEST

   1   0000 /******************************************************/
   2   0000 /* This program tests an assembly language routine to */ 
   3   0000 /* do floating point division.                        */
   4   0000 /******************************************************/
   5 a 0000 dtest:
   6 a 0006      procedure options(main);
   7 c 0006      declare 
   8 c 0006        div2 entry(fixed(7),float),
   9 c 0006        i fixed(7),
  10 c 0006        f float;
  11 c 0006 
  12 c 0006      do i = 0 by 1;
  13 c 000A         f = 100;
  14 c 0015         call div2(i,f);
  15 c 001B         put skip list('100 / 2 **',i,'=',f);
  16 c 0063      end;
  17 c 0063 
  18 a 0063 end dtest;
  19 a 0063 

CODE SIZE = 0063
DATA AREA = 0018
FREE SYMS = 3830
END  COMPILATION
