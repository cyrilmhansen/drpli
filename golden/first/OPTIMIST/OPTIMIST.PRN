COMPILATION OF: OPTIMIST

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: OPTIMIST

   1   0000 /******************************************************/
   2   0000 /* This program demonstrates PL/I character string    */
   3   0000 /* processing by turning a negative sentence into a   */
   4   0000 /* positive one.                                      */
   5   0000 /******************************************************/
   6 a 0000 optimist:
   7 a 0006     procedure options(main);
   8 c 0006     %replace
   9 c 0006         true   by '1'b,
  10 c 0006         false  by '0'b,
  11 c 0006         nwords by 5;
  12 c 0006     declare
  13 c 0006         negative (1:nwords) character(8) varying static initial
  14 c 0006             (' never',' none',' nothing',' not',' no'),
  15 c 0006         positive (1:nwords) character(10) varying static initial
  16 c 0006             (' always',' all',' something','',' some'),
  17 c 0006         upper character(28) static initial
  18 c 0006             ('ABCDEFGHIJKLMNOPQRSTUVWXYZ. '),
  19 c 0006         lower character(28) static initial
  20 c 0006             ('abcdefghijklmnopqrstuvwxyz. '),
  21 c 0006         sent character(254) varying,
  22 c 0006         word character(32)  varying,
  23 c 0006         (i,j) fixed;
  24 c 0006 
  25 c 0006     do while(true);
  26 c 0006        put skip list('What''s up? ');
  27 c 0022        sent = ' ';
  28 c 002F        do while
  29 c 004B           (substr(sent,length(sent)) ^= '.');
  30 c 004B           get list (word);
  31 c 0065           sent = sent !! ' ' !! word;
  32 c 0088        end;
  33 c 0088        sent = translate(sent,lower,upper);
  34 c 00AB        if verify(sent,lower) ^= 0 then
  35 c 00C2           sent = ' that''s an interesting idea.';
  36 c 00CF        do i = 1 to nwords;
  37 c 00E1           j = index(sent,negative(i));
  38 c 00F9           if j ^= 0 then
  39 c 0102              sent = substr(sent,1,j-1) !!
  40 c 0162           positive(i) !!
  41 c 0162           substr(sent,j+length(negative(i)));
  42 c 0162        end;
  43 c 0162        put list('Actually,'!!sent);
DISK FULL