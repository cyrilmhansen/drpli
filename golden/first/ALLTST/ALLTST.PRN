COMPILATION OF: ALLTST

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: ALLTST

   1   0000 /*****************************************************/
   2   0000 /* This program tests the TOTWDS, MAXWDS, and ALLWDS */
   3   0000 /* functions from the Run-time Subroutine Library.   */
   4   0000 /*****************************************************/
   5 a 0000 alltst:
   6 a 0006     procedure options(main);
   7 c 0006     declare 
   8 c 0006        totwds returns(fixed(15)),
   9 c 0006        maxwds returns(fixed(15)),
  10 c 0006        allwds entry(fixed(15)) returns(pointer);
  11 c 0006 
  12 c 0006     declare 
  13 c 0006        allreq fixed(15),
  14 c 0006        memptr ptr,
  15 c 0006        meminx fixed(15),
  16 c 0006        memory (0:0) bit(16) based(memptr);
  17 c 0006 
  18 c 0006     do while('1'b);
  19 c 0006        put edit (totwds(),' Total Words Available',
  20 c 004F                  maxwds(),' Maximum Segment Size',
  21 c 004F                  'Allocation Size? ') (2(skip,f(6),a),skip,a);
  22 c 004F        get list(allreq);
  23 c 0067        memptr = allwds(allreq);
  24 c 0070        put edit('Allocated',allreq,' Words at ',unspec(memptr))
  25 c 00B2                (skip,a,f(6),a,b4);
  26 c 00B2 
  27 c 00B2        /* clear memory as example */
  28 c 00B2        do meminx = 0 to allreq-1;
  29 c 00CC           memory(meminx) = '0000'b4;
  30 c 00E7        end;
  31 c 00E7     end;
  32 c 00E7 
  33 a 00E7 end alltst;
  34 a 00E7 

CODE SIZE = 00E7
DATA AREA = 0078
FREE SYMS = 36E1
END  COMPILATION
