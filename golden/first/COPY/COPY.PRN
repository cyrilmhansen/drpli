COMPILATION OF: COPY

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: COPY

   1   0000 /*****************************************************/
   2   0000 /* This program copies one file to another using     */
   3   0000 /* buffered I/O.                                     */
   4   0000 /*****************************************************/
   5 a 0000 copy:
   6 a 0006     procedure options(main);
   7 c 0006     declare
   8 c 0006        (input_file,output_file) file;
   9 c 0006 
  10 c 0006     open file (input_file) stream 
  11 c 002A          environment(b(8192)) title('$1.$1');
  12 c 002A 
  13 c 002A     open file (output_file) stream output 
  14 c 004E          environment(b(8192)) title('$2.$2');
  15 c 004E     declare
  16 c 004E        buff character(254) varying;
  17 c 004E 
  18 c 004E     do while('1'b);
  19 c 004E        read  file (input_file)  into (buff);
  20 c 0066        write file (output_file) from (buff);
  21 c 0081     end;
  22 a 0081 end copy;
  23 a 0081 

CODE SIZE = 0081
DATA AREA = 0109
FREE SYMS = 385C
END  COMPILATION
