COMPILATION OF: ACKTST

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: ACKTST

   1   0000 /************************************************/ 
   2   0000 /* This program tests the STKSIZ function while */
   3   0000 /* evaluating a RECURSIVE procedure.            */
   4   0000 /************************************************/
   5 a 0000 ack:
   6 a 0006     procedure options(main,stack(2000));
   7 c 0006     declare 
   8 c 0006        (m,n) fixed,
   9 c 0006        (maxm,maxn) fixed,
  10 c 0006        ncalls decimal(6),
  11 c 0006        (curstack, stacksize) fixed,
  12 c 0006        stksiz entry returns(fixed);
  13 c 0006 
  14 c 0006     put skip list('Type max m,n: ');
  15 c 0022     get list(maxm,maxn);
  16 c 0046     do m = 0 to maxm;
  17 c 005F        do n = 0 to maxn;
  18 c 0078           ncalls    = 0;
  19 c 0088           curstack  = 0;
  20 c 008E           stacksize = 0;
  21 c 0091           put edit('Ack(',m,',',n,')=',ackermann(m,n),
  22 c 012F               ncalls,' Calls,',stacksize,' Stack Bytes')
  23 c 012F               (skip,a,2(f(2),a),f(6),f(7),a,f(4),a);
  24 c 012F        end;
  25 c 012F     end;
  26 c 012F     stop;
  27 c 0132 
  28 c 0132     ackermann:
  29 c 0132        procedure(m,n) returns(fixed) recursive;
  30 c 0132 
  31 e 0132        declare 
  32 e 015C          (m,n) fixed;
  33 e 015C        ncalls = ncalls + 1;
  34 e 0177        curstack = stksiz();
  35 e 017D        if curstack > stacksize then
  36 e 018A           stacksize = curstack;
  37 e 0190        if m = 0 then
  38 e 0199           return(n+1);
  39 e 01A1        if n = 0 then
  40 e 01AA           return(ackermann(m-1,1));
  41 e 01C1        return(ackermann(m-1,ackermann(m,n-1)));
  42 c 01E8     end ackermann;
  43 c 01E8 
  44 a 01E8     end ack;

CODE SIZE = 01E8
DATA AREA = 0084
FREE SYMS = 3667
END  COMPILATION
