 316 c 0695 
 317 c 0695 /**********************************
 318 c 0695 *                                 *
 319 c 0695 *  Allocate Vector ALLVEC Test    *
 320 c 0695 *                                 *
 321 c 0695 *  Note: This test contains two   *
 322 c 0695 *  different versions; one for    *
 323 c 0695 *  8080 code, and another for     *
 324 c 0695 *  8086 code.  Before compiling   *
 325 c 0695 *  you must comment out the       *
 326 c 0695 *  version you don't want to use. *
 327 c 0695 *                                 *
 328 c 0695 **********************************/
 329 c 0695 
 330 c 0695 /*  8080 version  
 331 c 0695     
 332 c 0695 declare 
 333 c 0695    alloc (0:30) bit(8) based (allvec()),
 334 c 0695    allvecp pointer;
 335 c 0695 
 336 c 0695 allvecp = allvec();
 337 c 0695 put edit('Alloc Vector at ',unspec(allvecp),':',
 338 c 0695         (alloc(i) do i=0 to 30))
 339 c 0695         (skip,a,b4,a,254(skip,4(b,x(1))));       */
 340 c 0695 
 341 c 0695 
 342 c 0695 /*  8086 version
 343 c 0695 
 344 c 0695 declare
 345 c 0695    alloc (0:30) bit(8),
 346 c 0695    allvecp(2) pointer;
 347 c 0695 
 348 c 0695 call allvec(allvecp);
 349 c 0695 call movgtl(31,allvecp,addr(alloc));
 350 c 0695 put edit('Alloc Vector at offset ', unspec(allvecp(1)),
 351 c 0695          ', segment ',unspec(allvecp(2)),':',
 352 c 0695         (alloc(i) do i=0 to 30))
 353 c 0695         (skip,a,b4,a,b4,a,254(skip,4(b,x(1))));     */
 354 c 0695 
 355 c 0695 
 356 c 0695 /**********************************
 357 c 0695 *                                 *
 358 c 0695 *  Note:  the following functions *
 359 c 0695 *  apply to version 2.0 or newer. *
