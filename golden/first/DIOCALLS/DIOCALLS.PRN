 364 c 0695 *                                 *
 365 c 0695 *           WPDISK Test           *
 366 c 0695 *                                 *
 367 c 0695 **********************************/
 368 c 0695 put skip list('Write Protect Disk?(Y/N)');
 369 c 06B1 get list(c);
 370 c 06CB if translate(c,'Y','y') = 'Y' then
 371 c 06F3    call wpdisk();
 372 c 06F6 
 373 c 06F6 /**********************************
 374 c 06F6 *                                 *
 375 c 06F6 *          ROVEC Test             *
 376 c 06F6 *                                 *
 377 c 06F6 **********************************/
 378 c 06F6 put skip list('Read/Only Vector is',rovec());
 379 c 071D 
 380 c 071D /**********************************
 381 c 071D *                                 *
 382 c 071D *  Disk Parameter Block Decoding  *
 383 c 071D *          Using GETDPB           *
 384 c 071D *                                 *
 385 c 071D *  Note: This test contains two   *
 386 c 071D *  different versions; one for    *
 387 c 071D *  8080 code, and another for     *
 388 c 071D *  8086 code.  Before compiling   *
 389 c 071D *  you must comment out the       *
 390 c 071D *  version you don't want to use. *
 391 c 071D *                                 *
 392 c 071D **********************************/
 393 c 071D 
 394 c 071D /*  8080 version
 395 c 071D 
 396 c 071D declare 
 397 c 071D    dpbp pointer,
 398 c 071D    1 dpb based (dpbp),
 399 c 071D      2 spt fixed(15),
 400 c 071D      2 bsh fixed(7),
 401 c 071D      2 blm bit(8),
 402 c 071D      2 exm bit(8),
 403 c 071D      2 dsm bit(16),
 404 c 071D      2 drm bit(16),
 405 c 071D      2 al0 bit(8),
 406 c 071D      2 al1 bit(8),
 407 c 071D      2 cks bit(16),
 408 c 071D      2 off fixed(15);
 409 c 071D 
 410 c 071D dpbp = getdpb();
 411 c 071D put edit('Disk Parameter Block:',
 412 c 071D          'spt',spt,'bsh',bsh,'blm',blm,
 413 c 071D          'exm',exm,'dsm',dsm,'drm',drm,
 414 c 071D          'al0',al0,'al1',al1,'cks',cks,
 415 c 071D          'off',off)
 416 c 071D         (skip,a,2(skip,a(4),f(6)),4(skip,a(4),b4),
 417 c 071D          skip,2(a(4),b,x(1)),skip,a(4),b4,
 418 c 071D          skip,a(4),f(6));                          */
 419 c 071D 
 420 c 071D 
 421 c 071D /*  8086 version
 422 c 071D 
 423 c 071D declare 
 424 c 071D    dpbp(2) pointer, 
 425 c 071D    1 dpb,
 426 c 071D      2 spt fixed(15),
 427 c 071D      2 bsh fixed(7),
 428 c 071D      2 blm bit(8),
 429 c 071D      2 exm bit(8),
 430 c 071D      2 dsm bit(16),
 431 c 071D      2 drm bit(16),
 432 c 071D      2 al0 bit(8),
 433 c 071D      2 al1 bit(8),
 434 c 071D      2 cks bit(16),
 435 c 071D      2 off fixed(15);
 436 c 071D 
 437 c 071D call getdpb(dpbp);
 438 c 071D call movgtl(15,dpbp,addr(dpb));
 439 c 071D put edit('Disk Parameter Block:',
 440 c 071D         'spt',spt,'bsh',bsh,'blm',blm,
 441 c 071D         'exm',exm,'dsm',dsm,'drm',drm,
 442 c 071D         'al0',al0,'al1',al1,'cks',cks,
 443 c 071D         'off',off)
 444 c 071D         (skip,a,2(skip,a(4),f(6)),
 445 c 071D         4(skip,a(4),b4),
 446 c 071D         skip,2(a(4),b,x(1)),
 447 c 071D         skip,a(4),b4,
 448 c 071D         skip,a(4),f(6));                  */
 449 c 071D 
 450 c 071D             
 451 c 071D /**********************************
