PL/I-80 V1.4 COMPILATION OF: IFACT

   1   0000 /******************************************************/
   2   0000 /* This program evaluates the Factorial function (n!) */
   3   0000 /* using iteration.                                   */
   4   0000 /******************************************************/
   5 a 0000 ifact:
   6 a 0006      procedure options(main);
   7 c 0006      declare 
   8 c 0006         (i, n, F) fixed;
   9 c 0006 
  10 c 0006      do i = 0 by 1;
  11 c 000C         F = 1;
  12 c 0012         do n = i to 1 by -1;
  13 c 0021            F = n * F;
  14 c 0039         end;
  15 c 0039         put edit('factorial(',i,')=',F)
  16 c 0081             (skip, a,f(2), a, f(7));
  17 c 0081      end;
  18 a 0081 end ifact;
  19 a 0081 

CODE SIZE = 0081
