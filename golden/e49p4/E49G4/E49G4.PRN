PL/I-80 V1.4 COMPILATION OF: E49G4

   1 a 0000 E49G4:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P4] G3's INVERSION: `> ' with literal LEFT, member
   4 a 0006      RIGHT, 2/3 written.  H-A-sw: the swap lowers member-FIRST --
   5 a 0006      the STAGED `EB' head with positionals `06 03 / 3E 02'; H-A-or:
   6 a 0006      direct literal-left head with `06 02 / 3E 03'.  Together with
   7 a 0006      G3 this row tests whether the swap REKEYS the template choice
   8 a 0006      or only the operand order. */
   9 c 0006   dcl
  10 c 0006     1 rec,
  11 c 0006       2 na char(3),
  12 c 0006       2 nb char(3),
  13 c 0006       2 s2 char(2);
  14 c 0006   dcl k fixed bin(15);
  15 c 0006   if 'AB' > rec.na then k = 1;
  16 c 001D   put list('K=', k);
  17 c 003F   stop;
  18 a 0042 end E49G4;

CODE SIZE = 0042
DATA AREA = 000E
FREE SYMS = 3870
END  COMPILATION
