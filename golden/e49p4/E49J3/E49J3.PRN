PL/I-80 V1.4 COMPILATION OF: E49J3

   1 a 0000 E49J3:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P4] `^('ABC' = rec.na)' -- negated equality on the
   4 a 0006      LITERAL-LEFT DIRECT template, equal attributes.  H-D-inv: C2's
   5 a 0006      direct head with C2-skip inverted to CA -- byte-equal to the
   6 a 0006      E49C4 golden (`'ABC' ^= rec.na') but names; tests the collapse
   7 a 0006      too (06 03 / 78, [C342] in the negated form).  Refusal here
   8 a 0006      with acceptance in J1/J2 would name a literal-specific
   9 a 0006      boundary on the composition. */
  10 c 0006   dcl
  11 c 0006     1 rec,
  12 c 0006       2 na char(3),
  13 c 0006       2 nb char(3),
  14 c 0006       2 s2 char(2);
  15 c 0006   dcl k fixed bin(15);
  16 c 0006   if ^('ABC' = rec.na) then k = 1;
  17 c 001B   put list('K=', k);
  18 c 003D   stop;
  19 a 0040 end E49J3;

CODE SIZE = 0040
DATA AREA = 000F
FREE SYMS = 386E
END  COMPILATION
