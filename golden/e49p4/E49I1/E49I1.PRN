PL/I-80 V1.4 COMPILATION OF: E49I1

   1 a 0000 E49I1:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P4] `rec.na < rec.s2' -- unequal extents 3/2, WRITTEN
   4 a 0006      order (strict).  [C346]'s F2/F4 pair sampled `>' and `>= '
   5 a 0006      only; `< ' unequal and the weak relations unequal have NO
   6 a 0006      object.  Primary: DR accepts and the laws transfer -- stacked
   7 a 0006      head `21 *D(na) / E5 / 21 *D(s2) / D1 / 06 03 / 3E 02 / CD
   8 a 0006      ?SCCCM', JNC d2, CODE 67, DATA 000C -- EQUAL to my arm-c
   9 a 0006      baseline; falsified by refusal or any byte drift. */
  10 c 0006   dcl
  11 c 0006     1 rec,
  12 c 0006       2 na char(3),
  13 c 0006       2 nb char(3),
  14 c 0006       2 s2 char(2);
  15 c 0006   dcl k fixed bin(15);
  16 c 0006   if rec.na < rec.s2 then k = 1;
  17 c 001E   put list('K=', k);
  18 c 0040   stop;
  19 a 0043 end E49I1;

CODE SIZE = 0043
DATA AREA = 000C
FREE SYMS = 3888
END  COMPILATION
