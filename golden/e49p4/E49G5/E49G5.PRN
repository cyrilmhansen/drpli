PL/I-80 V1.4 COMPILATION OF: E49G5

   1 a 0000 E49G5:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P4] `<= ' -- a SWAPPED weak relation -- member LEFT,
   4 a 0006      literal RIGHT, literal OVER-EXTENT (char(3) vs 'ABCD').
   5 a 0006      Combines TWO unmeasured boundaries: the relation-with-literal
   6 a 0006      family and over-extent under a relation ([C345] measured over-
   7 a 0006      extent WHOLE-POOL for = only, in the written orientation).
   8 a 0006      H-A-sw: lowered literal-FIRST, direct head, `06 04 / 3E 03';
   9 a 0006      H-A-or: staged head, `06 03 / 3E 04'.  Weak skips JC da.
  10 a 0006      Refusal of the over-extent spelling here would be a relation-
  11 a 0006      specific [C336]/[C345] boundary. */
  12 c 0006   dcl
  13 c 0006     1 rec,
  14 c 0006       2 na char(3),
  15 c 0006       2 nb char(3),
  16 c 0006       2 s2 char(2);
  17 c 0006   dcl k fixed bin(15);
  18 c 0006   if rec.na <= 'ABCD' then k = 1;
  19 c 001C   put list('K=', k);
  20 c 003E   stop;
  21 a 0041 end E49G5;

CODE SIZE = 0041
DATA AREA = 0010
FREE SYMS = 386C
END  COMPILATION
