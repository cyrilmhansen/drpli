PL/I-80 V1.4 COMPILATION OF: E49G2

   1 a 0000 E49G2:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P4] G1's INVERSION: literal LEFT, member RIGHT, `<',
   4 a 0006      equal attributes.  H-A-or keeps the DIRECT literal-left head
   5 a 0006      `21 *D(member) / 11 *D(pool)' (E48E7/C2's template, CODE 65);
   6 a 0006      H-A-sw says `< ' is written-order too, so the same direct head
   7 a 0006      is predicted HERE as well -- this row separates the hypotheses
   8 a 0006      only where a swap would occur (G3..G6); refusal of any row is
   9 a 0006      H-A-refuse, DR's boundary. */
  10 c 0006   dcl
  11 c 0006     1 rec,
  12 c 0006       2 na char(3),
  13 c 0006       2 nb char(3),
  14 c 0006       2 s2 char(2);
  15 c 0006   dcl k fixed bin(15);
  16 c 0006   if 'ABC' < rec.na then k = 1;
  17 c 001B   put list('K=', k);
  18 c 003D   stop;
  19 a 0040 end E49G2;

CODE SIZE = 0040
DATA AREA = 000F
FREE SYMS = 386E
END  COMPILATION
