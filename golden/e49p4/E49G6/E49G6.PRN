PL/I-80 V1.4 COMPILATION OF: E49G6

   1 a 0000 E49G6:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P4] G5's INVERSION: `<= ' with the OVER-EXTENT literal
   4 a 0006      LEFT, member RIGHT.  H-A-sw: lowered member-FIRST -- staged
   5 a 0006      `EB' head, positionals `06 03 / 3E 04'; H-A-or: direct head,
   6 a 0006      `06 04 / 3E 03'.  The pool must hold 'ABCD' whole iff [C345]
   7 a 0006      transfers to relations -- a TRUNCATED pool literal or a
   8 a 0006      min/max length reading falsifies it. */
   9 c 0006   dcl
  10 c 0006     1 rec,
  11 c 0006       2 na char(3),
  12 c 0006       2 nb char(3),
  13 c 0006       2 s2 char(2);
  14 c 0006   dcl k fixed bin(15);
  15 c 0006   if 'ABCD' <= rec.na then k = 1;
  16 c 001D   put list('K=', k);
  17 c 003F   stop;
  18 a 0042 end E49G6;

CODE SIZE = 0042
DATA AREA = 0010
FREE SYMS = 386C
END  COMPILATION
