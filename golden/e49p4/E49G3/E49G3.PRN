PL/I-80 V1.4 COMPILATION OF: E49G3

   1 a 0000 E49G3:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P4] ORDERED relation `> ' -- a SWAPPED relation per
   4 a 0006      [C346] -- member LEFT, literal RIGHT, UNEQUAL attributes 3/2.
   5 a 0006      H-A-sw: the swap lowers `'AB' < rec.na'-style pair order,
   6 a 0006      literal FIRST, so the head becomes the DIRECT template and the
   7 a 0006      position immediates are `06 02 / 3E 03' read off the LOWERED
   8 a 0006      operands; H-A-or: member-written-left keeps the STAGED `EB'
   9 a 0006      head with `06 03 / 3E 02' written-order positionals.  The byte
  10 a 0006      pair at 000D..0012 decides.  Strict: JNC d2. */
  11 c 0006   dcl
  12 c 0006     1 rec,
  13 c 0006       2 na char(3),
  14 c 0006       2 nb char(3),
  15 c 0006       2 s2 char(2);
  16 c 0006   dcl k fixed bin(15);
  17 c 0006   if rec.na > 'AB' then k = 1;
  18 c 001C   put list('K=', k);
  19 c 003E   stop;
  20 a 0041 end E49G3;

CODE SIZE = 0041
DATA AREA = 000E
FREE SYMS = 3870
END  COMPILATION
