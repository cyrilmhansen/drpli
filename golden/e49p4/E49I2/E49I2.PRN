PL/I-80 V1.4 COMPILATION OF: E49I2

   1 a 0000 E49I2:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-49/P4] `rec.s2 < rec.na' -- shorter member written LEFT,
   4 a 0006      written order.  Positional law on lowered operands: `06 02 /
   5 a 0006      3E 03'; strict JNC d2.  The orientation completion of the `< '
   6 a 0006      cell. */
   7 c 0006   dcl
   8 c 0006     1 rec,
   9 c 0006       2 na char(3),
  10 c 0006       2 nb char(3),
  11 c 0006       2 s2 char(2);
  12 c 0006   dcl k fixed bin(15);
  13 c 0006   if rec.s2 < rec.na then k = 1;
  14 c 001E   put list('K=', k);
  15 c 0040   stop;
  16 a 0043 end E49I2;

CODE SIZE = 0043
DATA AREA = 000C
FREE SYMS = 3888
END  COMPILATION
