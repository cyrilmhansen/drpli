PL/I-80 V1.4 COMPILATION OF: FFACT

   1   0000 /******************************************************/
   2   0000 /* This program evaluates the Factorial function (n!) */
   3   0000 /* using recursion and FLOAT BINARY data.             */
   4   0000 /******************************************************/
   5 a 0000 ffact:
       0000       LXI  B,0200
       0003       CALL ?START
   6 a 0006      procedure options(main);
   7 c 0006      declare 
   8 c 0006         i fixed;
   9 c 0006      do i = 0 repeat(i+1);
       0006       LXI  H,0000
       0009       SHLD I A(0010)
  10 c 000C         put skip list('Factorial(',i,')=',factorial(i));
       000C       LXI  D,0252
       000F       LXI  B,0000
       0012       CALL ?SYSPR
       0015       MVI  A,01
       0017       CALL ?SKPOP
       001A       LXI  H,* S(0000)
       001D       MVI  A,0A
       001F       CALL ?SLCTS
       0022       CALL ?PNCOP
       0025       LHLD I A(0010)
       0028       MVI  A,09
       002A       CALL ?QICOP
       002D       CALL ?PNVOP
       0030       LXI  H,* S(000A)
       0033       MVI  A,02
       0035       CALL ?SLCTS
       0038       CALL ?PNCOP
       003B       LXI  H,* A(0012)
       003E       CALL 0000
       0041       MVI  A,0E
       0043       CALL ?QFCSS
       0046       CALL ?PNVOP
       0049       CALL ?QIOOP
       0010       ==== 004C
       004C       LHLD I A(0010)
       004F       INX  H
       0050       SHLD I A(0010)
       0053       JMP  000C
  11 c 0056      end;
  12 c 0056      stop;
  13 c 0056 
  14 c 0056      factorial:
  15 c 0056           procedure(i) returns(float) recursive;
  16 e 0056           declare 
       0056       LXI  B,0008
       0059       LXI  D,0014
       005C       CALL ?SVBLK
       005F       MOV  E,M
       0060       INX  H
       0061       MOV  D,M
       0062       XCHG 
       0063       SHLD I A(0014)
       0066       LHLD I A(0014)
       0069       MOV  E,M
       006A       INX  H
       006B       MOV  D,M
       006C       XCHG 
       006D       SHLD I A(0016)
  17 e 0070              i fixed;
  18 e 0070           if i = 0 then return (1);
       0070       LXI  H,I A(0016)
       0073       MOV  A,M
       0074       INX  H
       0075       ORA  M
       0076       JNZ  0000
       0079       LXI  H,* S(000C)
       007C       CALL ?FL40M
       007F       CALL ?RSBLK
       0082       JMP  ?FPRET
       0077       ==== 0085
  19 e 0085           return (i * factorial(i-1));
       0085       LHLD I A(0016)
       0088       DCX  H
       0089       SHLD * A(001A)
       008C       LXI  H,* A(0018)
       008F       CALL FACTORIAL
       0092       LHLD I A(0016)
       0095       CALL ?QI15F
       0098       CALL ?FM44S
       009B       CALL ?RSBLK
       009E       JMP  ?FPRET
  20 c 00A1      end factorial;
  21 c 00A1 
  22 a 00A1 end ffact;
  23 a 00A1 

