PL/I-80 V1.4 COMPILATION OF: E48C2

   1 a 0000 E48C2:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P2c] THE DISCRIMINATOR, member side: `b = (rec.name = 'EOF')' on an
   4 a 0006 INTERNAL automatic record.  CREATE 008F spells its member store 18
   5 a 0006 bytes `LXI H,var / XCHG / LXI H,lit'; E48A6/A12 spell the flat
   6 a 0006 cell 17 bytes `LXI H,lit / LXI D,var'.  If operand class (member
   7 a 0006 vs flat) is the discriminator, this object carries CREATE's form. */
   8 c 0006   dcl
   9 c 0006     1 rec,
  10 c 0006       2 name character(30) varying;
  11 c 0006   dcl b bit(1) static initial('0'b);
  12 c 0006   rec.name = 'AB';
  13 c 0013   b = (rec.name = 'EOF');
  14 c 0025   put list('B=', b);
  15 c 0047   stop;
  16 a 004A end E48C2;

CODE SIZE = 004A
DATA AREA = 0027
FREE SYMS = 3877
END  COMPILATION
