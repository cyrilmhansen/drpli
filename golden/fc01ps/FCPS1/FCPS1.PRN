PL/I-80 V1.4 COMPILATION OF: FCPS1

   1 a 0000 FCPS1:
   2 a 0006   procedure options(main);
   3 a 0006   /* [FC-01] trailing-framing probe. The last executed output
   4 a 0006      statement is a bare PUT SKIP; does the linked program then
   5 a 0006      still emit a final line at exit?  H1 (unconditional exit
   6 a 0006      CRLF) predicts one blank line after 'X= 1'; H2 (flush only
   7 a 0006      on an unterminated line) predicts none.  See
   8 a 0006      spec/lab-evidence/fc01-framing/HYPOTHESES.md */
   9 c 0006   dcl x fixed;
  10 c 0006   x = 1;
  11 c 000C   put list('X=', x);
  12 c 002E   put skip;
  13 c 003F   stop;
  14 a 0042 end FCPS1;

CODE SIZE = 0042
DATA AREA = 0004
FREE SYMS = 38B9
END  COMPILATION
