PL/I-80 V1.4 COMPILATION OF: FCPS2

   1 a 0000 FCPS2:
   2 a 0006   procedure options(main);
   3 a 0006   /* [FC-01] control for the trailing-framing pair: program
   4 a 0006      text ends UNTERMINATED (no explicit SKIP).  Both H1 and
   5 a 0006      H2 predict exactly one final newline here -- the measured
   6 a 0006      E32B1 exit behaviour (README section 4).  A deviation on
   7 a 0006      either side invalidates the session capture law, not the
   8 a 0006      hypotheses. */
   9 c 0006   dcl y fixed;
  10 c 0006   y = 2;
  11 c 000C   put list('Y=', y);
  12 c 002E   stop;
  13 a 0031 end FCPS2;

