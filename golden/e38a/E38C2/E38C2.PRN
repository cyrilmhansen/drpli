PL/I-80 V1.4 COMPILATION OF: E38C2

   1 a 0000 E38C2: procedure options(main);
   2 c 0006    declare n fixed;
   3 c 0006       n = 1;
   4 c 000C       if 3 > n then n = 100;
   5 c 001D       put list('n=', n);
   6 c 003F    stop;
   7 a 0042 end E38C2;

