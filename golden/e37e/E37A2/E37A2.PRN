PL/I-80 V1.4 COMPILATION OF: E37A2

   1 a 0000 e37a2: procedure options(main);
   2 c 0006    declare p pointer, z fixed, m fixed;
   3 c 0006    declare 1 s based(p), 2 a fixed, 2 nx pointer;
   4 c 0006    allocate s set(p);
   5 c 000F    z = 12;
   6 c 0015    nx = addr(z);
   7 c 0020    m = 0;
   8 c 0026    if nx = addr(z) then m = 1;
   9 c 0040    put list('match=', m);
  10 c 0062    free s;
  11 c 0068    stop;
  12 a 006B end e37a2;

