PL/I-80 V1.4 COMPILATION OF: E527B

   1 a 0000 E527B: procedure options(main);
   2 a 0006    /* [E2E-53/P3] H-A2/H-A3: SCALAR ENTRY variable, no VARIABLE */
   3 a 0006    /* attribute, FORWARD entry reference.  Goldens pin only the */
   4 a 0006    /* subscripted `entry variable` form (DEPREC 000C-0014).     */
   5 a 0006    /* Predicted: either the SHLD/CHAIN-ADDR form or the         */
   6 a 0006    /* LXI H,*D / LXI D,*D / MOV M,E / INX / MOV M,D self-word   */
   7 a 0006    /* form; whichever it is fixes the variant rule.             */
   8 c 0006    dcl e entry;
   9 c 000D    e = et;
  10 c 0013    stop;
  11 c 001D et:;
