   1 a 0000 E527E: procedure options(main);
   2 a 0006    /* [E2E-53/P3] H-C: computed GOTO from a label-variable      */
   3 a 0006    /* ELEMENT with a dynamic subscript.  LABELS pins            */
   4 a 0006    /* ladder + LHLD + PCHL (006F-007D) inside a DO context;     */
