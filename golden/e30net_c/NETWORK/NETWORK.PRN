 210 c 044D /******************************************************/
 211 c 044D /* This procedure displays the best route from the    */
 212 c 044D /* input city to the destination.                     */
 213 c 044D /******************************************************/
 214 c 044D     print_route:
 215 c 044D         procedure(city);
 216 e 044D         declare
       044D       MOV  E,M
       044E       INX  H
       044F       MOV  D,M
       0450       XCHG 
       0451       SHLD CITY A(00DB)
 217 e 0454             city character(citysize) varying;
 218 e 0454         declare
 219 e 0454             (p,q) pointer,
 220 e 0454             (t,d) fixed;
 221 e 0454         p = find(city);
