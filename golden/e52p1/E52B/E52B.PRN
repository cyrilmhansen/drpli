PL/I-80 V1.4 COMPILATION OF: E52B

   1 a 0000 E52B:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-52/P1] CONFLICTING-KINDS CLASS IN MINIATURE (LOAN2):
   4 a 0006      outer i fixed dec(4,2), inner i fixed dec(9,2), both store 3.
   5 a 0006      MINE refuses TODAY at the prescan map. A scope-aware (lexical,
   6 a 0006      innermost-wins) type map predicts TWO pool cells -- 3 B for
   7 a 0006      the outer target-precision image and 5 B for the inner -- pool
   8 a 0006      8, plus cells 3 + 5, DATA 16. A global outer-wins type map
   9 a 0006      would type BOTH stores at dec(4,2): ONE 3-byte cell, pool 3,
  10 a 0006      DATA 11. DATA-SIZE discriminates. */
  11 c 0006   dcl i fixed dec(4,2);
  12 c 0006   i = 3;
  13 c 0016   call q;
  14 c 0019   q: procedure;
  15 e 0019      dcl i fixed dec(9,2);
  16 e 001C      i = 3;
  17 c 002D      end q;
  18 a 002D end E52B;

CODE SIZE = 0030
DATA AREA = 0010
FREE SYMS = 389A
END  COMPILATION
