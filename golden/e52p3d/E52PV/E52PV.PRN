PL/I-80 V1.4 COMPILATION OF: E52PV

   1 a 0000 E52PV: procedure options(main);
   2 a 0006 
   3 a 0006    /* E52PV (P3-4 x width boundaries, console, three tables: */
   4 a 0006    /* x(128), x(255), x(0); H4a plain 0B w for all three; H4b a */
   5 a 0006    /* REFUSAL above the measured max 19 -- which width first) */
   6 a 0006 
   7 c 0006    put edit('|')(x(128),a);
   8 c 0023    put edit('|')(x(255),a);
   9 c 0040    put edit('|')(x(0),a);
  10 c 005D 
  11 a 005D end E52PV;

CODE SIZE = 0060
