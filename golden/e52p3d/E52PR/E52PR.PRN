PL/I-80 V1.4 COMPILATION OF: E52PR

   1 a 0000 E52PR: procedure options(main);
   2 a 0006 
   3 a 0006    /* E52PR (P3-4 rep-group on the CONSOLE route with skip */
   4 a 0006    /* and a picture INSIDE the group; predicts table */
   5 a 0006    /* 80 00 80 02 0C FF 03 FF 81 02 02 00 02 39 39 81) */
   6 a 0006 
   7 c 0006    dcl m fixed binary, y fixed binary;
   8 c 0006 
   9 c 0006    put edit('|',100*m+y)(2(skip,a),p'99');
  10 c 0039 
  11 a 0039 end E52PR;

