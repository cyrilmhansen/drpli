PL/I-80 V1.4 COMPILATION OF: E52PX

   1 a 0000 E52PX: procedure options(main);
   2 a 0006 
   3 a 0006    /* E52PX (P3-4 FILE-route EXPRESSION item, MULTIPLY ONLY: */
   4 a 0006    /* 100*m; H6a IM22N leaves DE and DR emits XCHG; */
   5 a 0006    /* H6b IM22N returns HL directly -- this settles which) */
   6 a 0006 
   7 c 0006    dcl f file, m fixed binary;
   8 c 0006 
   9 c 0006    put file(f) edit(100*m)(a);
  10 c 002C 
  11 a 002C end E52PX;

