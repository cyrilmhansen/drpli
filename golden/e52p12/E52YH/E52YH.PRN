PL/I-80 V1.4 COMPILATION OF: E52YH

   1 a 0000 E52YH: procedure options(main);
   2 a 0006    /* E2E-52/P3-12 probe H: CONTROL - computed quotient
   3 a 0006       into a lower-scale target (the armed L5 path). */
   4 c 0006    dcl a fixed dec(9,2);
   5 c 0006    dcl b fixed dec(9,2);
   6 c 0006    dcl c fixed dec(9,2);
   7 c 0006    c = a / b;
   8 c 002B    put skip list(c);
   9 c 004E    
  10 a 004E end E52YH;

CODE SIZE = 0051
