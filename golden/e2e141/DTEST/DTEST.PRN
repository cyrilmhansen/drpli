PL/I-80 V1.4 COMPILATION OF: DTEST

   1   0000 /******************************************************/
   2   0000 /* This program tests an assembly language routine to */ 
   3   0000 /* do floating point division.                        */
   4   0000 /******************************************************/
   5 a 0000 dtest:
       0000       LXI  B,0200
       0003       CALL ?START
   6 a 0006      procedure options(main);
   7 c 0006      declare 
   8 c 0006        div2 entry(fixed(7),float),
   9 c 0006        i fixed(7),
  10 c 0006        f float;
  11 c 0006 
  12 c 0006      do i = 0 by 1;
       0006       XRA  A
       0007       STA  I A(000F)
  13 c 000A         f = 100;
       000A       LXI  H,* S(0000)
       000D       PUSH H
       000E       LXI  H,F A(0010)
       0011       POP  D
       0012       CALL ?FX44M
  14 c 0015         call div2(i,f);
       0015       LXI  H,* A(0014)
       0018       CALL DIV2
  15 c 001B         put skip list('100 / 2 **',i,'=',f);
       001B       LXI  D,0252
       001E       LXI  B,0000
       0021       CALL ?SYSPR
       0024       MVI  A,01
       0026       CALL ?SKPOP
       0029       LXI  H,* S(0004)
       002C       MVI  A,0A
       002E       CALL ?SLCTS
       0031       CALL ?PNCOP
       0034       LDA  I A(000F)
       0037       MOV  L,A
       0038       ADD  A
       0039       SBB  A
       003A       MOV  H,A
       003B       MVI  A,07
       003D       CALL ?QICOP
       0040       CALL ?PNVOP
       0043       LXI  H,* S(000E)
       0046       MVI  A,01
       0048       CALL ?SLCTS
       004B       CALL ?PNCOP
       004E       LXI  H,F A(0010)
       0051       MVI  A,0E
       0053       CALL ?QFCMS
       0056       CALL ?PNVOP
       0059       CALL ?QIOOP
       001F       ==== 005C
       005C       LXI  H,I A(000F)
       005F       INR  M
       0060       JMP  000A
  16 c 0063      end;
  17 c 0063 
  18 a 0063 end dtest;
  19 a 0063 

