PL/I-80 V1.4 COMPILATION OF: FDTEST

   1   0000 /****************************************************/ 
   2   0000 /* This program tests the assembly-language routine */
   3   0000 /* called FDIV2 which returns a FLOAT BINARY value. */
   4   0000 /****************************************************/
   5 a 0000 fdtest:
       0000       LXI  B,0200
       0003       CALL ?START
   6 a 0006     procedure options(main);
   7 c 0006     declare 
   8 c 0006       fdiv2 entry(fixed(7),float) returns(float),
   9 c 0006       i fixed(7),
  10 c 0006       f float;
  11 c 0006 
  12 c 0006     do i = 0 by 1;
       0006       XRA  A
       0007       STA  I A(000F)
  13 c 000A        put skip list('100 / 2 **',i,'=',fdiv2(i,100));
       000A       LXI  D,0252
       000D       LXI  B,0000
       0010       CALL ?SYSPR
       0013       MVI  A,01
       0015       CALL ?SKPOP
       0018       LXI  H,* S(0000)
       001B       MVI  A,0A
       001D       CALL ?SLCTS
       0020       CALL ?PNCOP
       0023       LDA  I A(000F)
       0026       MOV  L,A
       0027       ADD  A
       0028       SBB  A
       0029       MOV  H,A
       002A       MVI  A,07
       002C       CALL ?QICOP
       002F       CALL ?PNVOP
       0032       LXI  H,* S(000A)
       0035       MVI  A,01
       0037       CALL ?SLCTS
       003A       CALL ?PNCOP
       003D       LXI  H,* A(0014)
       0040       CALL FDIV2
       0043       MVI  A,0E
       0045       CALL ?QFCSS
       0048       CALL ?PNVOP
       004B       CALL ?QIOOP
       000E       ==== 004E
       004E       LXI  H,I A(000F)
       0051       INR  M
       0052       JMP  000A
  14 c 0055     end;
  15 c 0055 
  16 a 0055 end fdtest;
  17 a 0055 

