PL/I-80 V1.4 COMPILATION OF: E52XI

   1 a 0000 E52XI: procedure options(main);
   2 a 0006    /* E2E-52/P3-11 probe XI (PLAN H-I): PRINT open +
   3 a 0006       skip then literal.  E46N2 measures 31 B with the
   4 a 0006       skip BETWEEN attach and chain and ?PNCOP only
   5 a 0006       because an item chain follows. */
   6 c 0006    dcl pf file;
   7 c 0006    dcl x fixed bin;
   8 c 0006    open file(pf) print;
   9 c 001B    put file(pf) skip list('A');
  10 c 003A    x = 2;
  11 a 0040 end E52XI;

