PL/I-80 V1.4 COMPILATION OF: E52XB

   1 a 0000 E52XB: procedure options(main);
   2 a 0006    /* E2E-52/P3-11 probe XB (PLAN H-B): LITERAL title
   3 a 0006       + print with NO pagesize/linesize -- a combination
   4 a 0006       absent from TA..TJ.  w1 predict 0E52; attach of
   5 a 0006       the PAGE predict 0652 (direction, not open word). */
   6 c 0006    dcl pf file;
   7 c 0006    dcl x fixed bin;
   8 c 0006    open file(pf) title('TEST') print;
   9 c 0023    put file(pf) page;
  10 c 0035    x = 2;
  11 a 003B end E52XB;

