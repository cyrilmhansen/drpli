PL/I-80 V1.4 COMPILATION OF: E51I

   1 a 0000 E51I:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-51/P1] QUOTIENT inside a condition: if a / b = c then z =
   4 a 0006      1.  Equality is [C072]: the IS22N sub then MOV A,H / ORA L
   5 a 0006      with the CA/JNZ skip family.  H-I-eq predicts <div> / PUSH H /
   6 a 0006      LHLD c / POP D / CALL ?IS22N / 7C / B5 / skip-CA-then-0000-LAD
   7 a 0006      / LXI H,1 / SHLD z.  H-I-refuse: an E2E-3b-style condition-
   8 a 0006      subset boundary in DR itself.  This is the FIRST binary
   9 a 0006      witness for a helper result as a compare operand; DEC compare
  10 a 0006      claims do not transfer. */
  11 c 0006   dcl a fixed, b fixed, c fixed, z fixed;
  12 c 0006   if a / b = c then z = 1;
  13 a 0024 end E51I;

CODE SIZE = 0027
DATA AREA = 0008
FREE SYMS = 38B1
END  COMPILATION
