PL/I-80 V1.4 COMPILATION OF: E51K

   1 a 0000 E51K:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-51/P1] SMALLER-PRECISION divisor: d is fixed bin(7), ONE
   4 a 0006      storage byte (binder sizing per [C079] p<=7).  [N303] shows
   5 a 0006      the MUL 1-byte RHS interleave: raw LDA / PUSH H / sign-extend
   6 a 0006      ladder MOV L,A / ADD A / SBB A / MOV H,A / POP D.  H-K-ld
   7 a 0006      predicts the identical interleave with CALL ?ID22N; H-K-lhld a
   8 a 0006      plain LHLD (which would READ c TOO -- falsified instantly by
   9 a 0006      the reloc count); H-K-conv a conversion call; H-K-refuse. */
  10 c 0006   dcl a fixed, b fixed, c fixed, z fixed;
  11 c 0006   dcl d fixed bin(7);
  12 c 0006   z = a / d;
  13 a 0018 end E51K;

CODE SIZE = 001B
DATA AREA = 0009
FREE SYMS = 38B1
END  COMPILATION
