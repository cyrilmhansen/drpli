PL/I-80 V1.4 COMPILATION OF: E46L18

   1 a 0000 E46L18:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2a] runtime 7: the SAME variable on BOTH routes.  E46L12's file holds `'HELLO'`
   4 a 0006      WITH apostrophes while E46L17's console holds `CON` without them, which leaves two
   5 a 0006      explanations and this object separates them: either the ASSIGNMENT stores the delimiters
   6 a 0006      into the cell (then the console line shows them too), or the file's output edit adds them
   7 a 0006      (then the console line shows HELLO and the file still shows 'HELLO'). */
   8 c 0006   dcl outf file, v char(20) varying;
   9 c 0006   v = 'HELLO';
  10 c 0013   put list(v);
  11 c 0028   open file(outf) stream output title('L18OUT DAT');
  12 c 0045   put file(outf) list(v);
  13 c 005D   close file(outf);
  14 c 0063   stop;
  15 a 0066 end E46L18;

CODE SIZE = 0066
DATA AREA = 0024
FREE SYMS = 3887
END  COMPILATION
