PL/I-80 V1.4 COMPILATION OF: E46N4

   1 a 0000 E46N4:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2c] FILE SKIP WITH A TWO-ITEM LIST.  P2b's H1
   4 a 0006      was confirmed: one attach and one close per PUT
   5 a 0006      STATEMENT.  This asks whether a control item changes
   6 a 0006      that -- three chains under one attach would say no,
   7 a 0006      two attaches would say yes. */
   8 c 0006   dcl outf file;
   9 c 0006   open file(outf) stream output title('N4OUT DAT');
  10 c 0023   put file(outf) skip list('A','B');
  11 c 004D   close file(outf);
  12 a 0053 end E46N4;

CODE SIZE = 0056
DATA AREA = 000B
FREE SYMS = 3887
END  COMPILATION
