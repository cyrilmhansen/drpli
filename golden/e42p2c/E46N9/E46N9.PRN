PL/I-80 V1.4 COMPILATION OF: E46N9

   1 a 0000 E46N9:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2c] COUNTED FILE SKIP, literal count.  DR
   4 a 0006      carries this behind a PRINT open this compiler
   5 a 0006      refuses: COPYLPT:67 is 0295-02A6 = attach, MVI A,04,
   6 a 0006      ?SKPOP, ?QIOOP, 20 bytes -- the BARE length with a
   7 a 0006      different count byte.  Asked here behind a stream
   8 a 0006      OUTPUT open. */
   9 c 0006   dcl outf file;
  10 c 0006   open file(outf) stream output title('N9OUT DAT');
  11 c 0023   put file(outf) skip(2);
  12 c 0037   close file(outf);
  13 a 003D end E46N9;

