a 0000 E46L5 ENTRY PARAMETERS(0) EXTERNAL CONSTANT
BLOCK AT LINE 3, AUTO STORAGE 21 BYTES
c 0000 OUTF FILE EXTERNAL STATIC
c 0000 V CHAR(20) VARYING AUTOMATIC
   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: E46L5

   1 a 0000 E46L5:
   2 a 0006   procedure options(main);
   3 c 0006   dcl outf file, v char(20) varying;
   4 c 0006   open file(outf) stream output title('L5OUT DAT');
