COMPILATION OF: DECPOLY

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: DECPOLY

   1   0000 /*****************************************************/
   2   0000 /* This program evaluates a polynomial expression    */
   3   0000 /* using FIXED DECIMAL data.                         */
   4   0000 /*****************************************************/
   5 a 0000 decpoly:
   6 a 0006     procedure options(main);
   7 a 0006 
   8 c 0006     %replace
   9 c 0006         true  by '1'b;
  10 c 0006     declare 
  11 c 0006         (x,y,z) fixed decimal(15,4);
  12 c 0006 
  13 c 0006     do while(true);
  14 c 0006        put skip(2) list('Type x,y,z: ');
  15 c 0022        get list(x,y,z);
  16 c 0067 
  17 c 0067        if x=0 & y=0 & z=0 then
  18 c 00B2           stop;
  19 c 00B5 
  20 c 00B5        put skip list('       2');
  21 c 00D1        put skip list('      x  + 2y + z =',P(x,y,z));
  22 c 0100     end;
  23 c 0100 
  24 c 0100     P:
  25 c 0100       procedure (x,y,z) returns (fixed decimal(15,4));
  26 e 0100       declare 
  27 e 010D             (x,y,z) fixed decimal(15,4);
  28 e 010D       return (x * x + 2 * y + z);
  29 c 0153     end P;
  30 c 0153 
  31 a 0153 end decpoly;
  32 a 0153 

CODE SIZE = 0153
DATA AREA = 0054
FREE SYMS = 377C
END  COMPILATION
