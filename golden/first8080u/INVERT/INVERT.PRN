COMPILATION OF: INVERT

D: Disk Print
L: List Source Program

%include 'matsize.lib';
  10 b              (d, a(maxrow,maxcol)) float binary(24),
SYNTAX                      ?
  11 b              (i,j,k,l,r,c) fixed binary(6);
BALANCE                                          ?
    2 ERROR(S) IN PASS 1

  13 d             d = a(i,1);
ARG COUNT                    ?
  15 e                a(i,j) = a(i,j+1)/d;
ARG COUNT                    ?         ?
COMP REQ                                 ?
  17 d             a(i,c) = 1/d;
ARG COUNT                 ?
TYPES NOT=                     ?
  21 f                     d = a(k,1);
ARG COUNT                            ?
  23 g                        a(k,l) = a(k,l+1) - a(i,l) * d;
ARG COUNT                            ?          ?        ?
COMP REQ                                                    ?
  25 f                     a(k,c) = - a(i,c) * d;
ARG COUNT                         ?          ?
TYPES NOT=                                      ?
   10 ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: INVERT

   1   0000 /******************************************************/
   2   0000 /* This is an external procedure called by MAININVT.  */
   3   0000 /******************************************************/
   4 a 0000 invert:
   5 a 0000     procedure (a,r,c);
   6+c 0000     %replace
   7+c 000D    true  by '1'b,
   8+c 000D    false by '0'b;
   9 c 000D     declare 
  10 c 000D         (d, a(maxrow,maxcol)) float binary(24),
  11 c 000D         (i,j,k,l,r,c) fixed binary(6);
  12 c 000D     do i = 1 to r;
  13 c 001F        d = a(i,1);
  14 c 0042        do j = 1 to c - 1;
  15 c 0054           a(i,j) = a(i,j+1)/d;
  16 c 00A9        end;
  17 c 00A9        a(i,c) = 1/d;
  18 c 00D3        do k = 1 to r;
  19 c 00E5           if k ^= i then
  20 c 00EF              do;
  21 c 00EF                d = a(k,1);
  22 c 0112                do l = 1 to c - 1;
  23 c 0124                   a(k,l) = a(k,l+1) - a(i,l) * d;
  24 c 019F                end;
  25 c 019F                a(k,c) = - a(i,c) * d;
  26 c 0204              end;
  27 c 0204        end;
  28 c 0204     end;
  29 c 0204 
  30 a 0204 end invert;
  31 a 0204 

CODE SIZE = 0204
DATA AREA = 0010
FREE SYMS = 381C
END  COMPILATION
