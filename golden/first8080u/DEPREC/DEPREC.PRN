COMPILATION OF: DEPREC

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: DEPREC

   1   0000 /*******************************************************/
   2   0000 /* This program calculates three kinds of depreciation */
   3   0000 /* schedules: straight_line, sum_of_the_years, and     */
   4   0000 /* double_declining.                                   */
   5   0000 /*******************************************************/
   6 a 0000 depreciate:
   7 a 0006     procedure options(main);
   8 c 0006     %replace
   9 c 0006        clear_screen by '^z',
  10 c 0006        indent   by 15,
  11 c 0006        ITC_rate by .1,
  12 c 0006        bonus_rate by .1,
  13 c 0006        bonus_max  by 2000;
  14 c 0006 
  15 c 0006     declare
  16 c 0006        selling_price  decimal(8,2),
  17 c 0006        adjusted_price decimal(8,2),
  18 c 0006        residual_value decimal(8,2),
  19 c 0006        year_value decimal(8,2),
  20 c 0006        depreciation_value decimal(8,2),
  21 c 0006        total_depreciation decimal(8,2),
  22 c 0006        book_value decimal(8,2),
  23 c 0006        tax_rate decimal(3,2),
  24 c 0006        sales_tax decimal(8,2),
  25 c 0006        tax_bracket decimal(2),
  26 c 0006        FYD decimal(8,2),
  27 c 0006        ITC decimal(8,2),
  28 c 0006        bonus_dep decimal(8,2),
  29 c 0006        months_remaining decimal(2),
  30 c 0006        new character(4),
  31 c 0006        factor decimal(2,1),
  32 c 0006        years decimal(2),
  33 c 0006        year_sum decimal(3),
  34 c 0006        current_year decimal(2),
  35 c 0006        select_sched character(1);
  36 c 0006 
  37 c 0006     declare
  38 c 0006        copy_to_list character(4),
  39 c 0006        output file variable,
  40 c 0006        (sysprint, list) file;
  41 c 0006 
  42 c 0006     declare
  43 c 0006        schedules character(3) static initial ('syd'),
  44 c 0006        schedule (0:3) entry variable;
  45 c 0006 
  46 c 0006     schedule (0) = error;
  47 c 000C     schedule (1) = straight_line;
  48 c 0015     schedule (2) = sum_of_years;
  49 c 001E     schedule (3) = double_declining;
  50 c 0027 
  51 c 0027     open file (sysprint) stream print pagesize(0)
  52 c 0044               title ('$con');
  53 c 0044 
  54 c 0044     do while('1'b);
  55 c 0044        put list(clear_screen,'^i^i^iDepreciation Schedule');
  56 c 0066        put skip(3) list('^i^iSelling  Price? ');
  57 c 0082        get list(selling_price);
  58 c 00A1        put list('^i^iResidual Value? ');
  59 c 00B8        get list(residual_value);
  60 c 00D7        put list('^i^iSales Tax (%)?  ');
  61 c 00EE        get list(tax_rate);
  62 c 010D        put list('^i^iTax Bracket(%)? ');
  63 c 0124        get list(tax_bracket);
  64 c 0143        put list('^i^iProRate Months? ');
  65 c 015A        get list(months_remaining);
  66 c 0179        put list('^i^iHow Many Years? ');
  67 c 0190        get list(years);
  68 c 01AF        put list('^i^iNew? (yes/no)   ');
  69 c 01C6        get list(new);
  70 c 01E0        put edit('^i^iSchedule:',
  71 c 021E                 '^i^iStraight   (s)',
  72 c 021E                 '^i^iSum-of-Yrs (y)',
  73 c 021E                 '^i^iDouble Dec (d)? ') (a,skip);
  74 c 021E        get list(select_sched);
  75 c 0238        put list('^i^iList? (yes/no)  ');
  76 c 024F        get list(copy_to_list);
  77 c 0269        if copy_to_list = 'yes' then
  78 c 0279           open file(list) stream print title('$lst');
  79 c 0296        factor = 1.5;
  80 c 02A6        if new = 'yes' then
  81 c 02B6           factor = 2.0;
  82 c 02C6        sales_tax = decimal(selling_price*tax_rate,12,2)/100+.005;
  83 c 0306        if new = 'yes' | selling_price <= 100000.00 then
  84 c 0330           ITC = selling_price * ITC_rate;
  85 c 0353        else
  86 c 0353           ITC = 100000 * ITC_rate;
  87 c 0373        bonus_dep = selling_price * bonus_rate;
  88 c 0393        if bonus_dep > bonus_max then
  89 c 03A9           bonus_dep = bonus_max;
  90 c 03B9        put list(clear_screen);
  91 c 03D0        call display(sysprint);
  92 c 03DC        if copy_to_list = 'yes' then
  93 c 03EC           call display(list);
  94 c 03F8        put skip list('^i^i^i   Type RETURN to Continue');
  95 c 0414        get skip(2);
  96 c 0428     end;
  97 c 0428 
  98 c 0428 /******************************************************/
  99 c 0428 /* This procedure displays the various depreciation   */
 100 c 0428 /* schedules.  It calls the appropriate schedule with */
 101 c 0428 /* an index into an array of entry  constants.        */
 102 c 0428 /******************************************************/
 103 c 0428 display:
 104 c 0428     procedure(f);
 105 e 0428     declare
 106 e 042F       f file;
 107 e 042F     output = f;
 108 e 0439     call schedule (index (schedules,select_sched));
 109 c 0455 end display;
 110 c 0455 
 111 c 0455 /********************************************/
 112 c 0455 /* This is a global error recovery routine. */
 113 c 0455 /********************************************/
 114 c 0455 error:
 115 c 0455     procedure;
 116 e 0455     put file (output) edit('Invalid Schedule - Enter s, y, or d')
 117 e 0475              (page,column(indent),x(8),a);
 118 e 0475     call line();
 119 c 0479 end error;
 120 c 0479 
 121 c 0479 /*******************************************************/
 122 c 0479 /* This procedure computes straight_line depreciation. */
 123 c 0479 /*******************************************************/
 124 c 0479 straight_line:
 125 c 0479     procedure;
 126 e 0479     adjusted_price = selling_price - bonus_dep;
 127 e 0494     put file (output) edit('S T R A I G H T   L I N E')
 128 e 04B4              (page,column(indent),x(14),a);
 129 e 04B4     call header();
 130 e 04B7     depreciation_value = adjusted_price - residual_value;
 131 e 04D2     book_value = adjusted_price;
 132 e 04E2     total_depreciation = 0;
 133 e 04F2     do current_year = 1 to years;
 134 e 0528        year_value = decimal(depreciation_value/years,8,2) + .005;
 135 e 0562        if current_year = 1 then
 136 e 0578           do;
 137 e 0578             year_value = year_value * months_remaining / 12;
 138 e 05A8             FYD = year_value;
 139 e 05B8           end;
 140 e 05B8        depreciation_value = depreciation_value - year_value;
 141 e 05D3        total_depreciation = total_depreciation + year_value;
 142 e 05EE        book_value = adjusted_price - total_depreciation;
 143 e 0609        call print_line();
 144 e 0626     end;
 145 e 0626     call summary();
 146 c 062A end straight_line;
 147 c 062A 
 148 c 062A /*************************************************/ 
 149 c 062A /* This procedure computes depreciation based on */
 150 c 062A /* the sum_of_the_years.                         */
 151 c 062A /*************************************************/
 152 c 062A sum_of_years:
 153 c 062A     procedure;
 154 e 062A     adjusted_price = selling_price - bonus_dep;
 155 e 0645     put file (output) edit('S U M   O F   T H E   Y E A R S')
 156 e 0665              (page,column(indent),x(11),a);
 157 e 0665     call header();
 158 e 0668     depreciation_value = adjusted_price - residual_value;
 159 e 0683     book_value = adjusted_price;
 160 e 0693     total_depreciation = 0;
 161 e 06A3     year_sum = 0;
 162 e 06B3     do current_year = 1 to years;
 163 e 06E9        year_sum = year_sum + current_year;
 164 e 071E     end;
 165 e 071E 
 166 e 071E     do current_year = 1 to years;
 167 e 0754        year_value = decimal(depreciation_value *
 168 e 07A5        (years - current_year + 1),12,2)/ year_sum + .005;
 169 e 07A5        if current_year = 1 then
 170 e 07BB           do;
 171 e 07BB             year_value = year_value * months_remaining / 12;
 172 e 07EB             FYD = year_value;
 173 e 07FB           end;
 174 e 07FB        depreciation_value = depreciation_value - year_value;
 175 e 0816        total_depreciation = total_depreciation + year_value;
 176 e 0831        book_value = adjusted_price - total_depreciation;
 177 e 084C        call print_line();
 178 e 0869     end;
 179 e 0869     call summary();
 180 c 086D end sum_of_years;
 181 c 086D 
 182 c 086D /********************************************/ 
 183 c 086D /* This procedure computes double_declining */
 184 c 086D /* depreciation.                            */
 185 c 086D /********************************************/
 186 c 086D double_declining:
 187 c 086D     procedure;
 188 e 086D     adjusted_price = selling_price - bonus_dep;
 189 e 0888     put file (output) edit('D O U B L E    D E C L I N I N G')
 190 e 08A8              (page,column(indent),x(10),a);
 191 e 08A8     call header();
 192 e 08AB     depreciation_value = adjusted_price - residual_value;
 193 e 08C6     book_value = adjusted_price;
 194 e 08D6     total_depreciation = 0;
 195 e 08E6     do current_year = 1 to years
 196 e 0933        while (depreciation_value > 0);
 197 e 0933        year_value = decimal(book_value/years,8,2) * factor+.005;
 198 e 0973        if current_year = 1 then
 199 e 0989           do;
 200 e 0989             year_value = year_value * months_remaining / 12;
 201 e 09B9             FYD = year_value;
 202 e 09C9           end;
 203 e 09C9        if year_value > depreciation_value then
 204 e 09DF           year_value = depreciation_value;
 205 e 09EF        depreciation_value = depreciation_value - year_value;
 206 e 0A0A        total_depreciation = total_depreciation + year_value;
 207 e 0A25        book_value = adjusted_price - total_depreciation;
 208 e 0A40        call print_line();
 209 e 0A5D     end;
 210 e 0A5D     call summary();
 211 c 0A61 end double_declining;
 212 c 0A61 
 213 c 0A61 /**************************************************/
 214 c 0A61 /* This procedure prints an output header record. */
 215 c 0A61 /**************************************************/
 216 c 0A61 header:
 217 c 0A61     procedure;
 218 e 0A61     declare 
 219 e 0A61        new_or_used character(5);
 220 e 0A61 
 221 e 0A61     if new = 'yes' then
 222 e 0A71        new_or_used = ' New';
 223 e 0A81     else
 224 e 0A81        new_or_used = ' Used';
 225 e 0A8D     put file (output) edit(
 226 e 0B5F     '--------------------------------------------------',
 227 e 0B5F     '|',selling_price+sales_tax,new_or_used,
 228 e 0B5F      residual_value,' Residual Value|',
 229 e 0B5F     '|',months_remaining,' Months Left ',
 230 e 0B5F         tax_rate,'% Tax',tax_bracket,'% Tax Bracket|')
 231 e 0B5F     (2(skip,column(indent),a),
 232 e 0B5F     2(p'B$$,$$$,$$9.V99',a),
 233 e 0B5F     skip,column(indent),a,x(5),f(2),a,2(x(2),p'B99',a));
 234 e 0B5F 
 235 e 0B5F     put file (output) edit(
 236 e 0BA1     '--------------------------------------------------',
 237 e 0BA1     '| Y | Depreciation | Depreciation |  Book Value  |',
 238 e 0BA1     '| r |   For Year   |  Remaining   |              |',
 239 e 0BA1     '--------------------------------------------------')
 240 e 0BA1     (skip,column(indent),a);
 241 c 0BA1 end header;
 242 c 0BA1 
 243 c 0BA1 /*******************************************/ 
 244 c 0BA1 /* This procedure prints the current line. */
 245 c 0BA1 /*******************************************/
 246 c 0BA1 print_line:
 247 c 0BA1     procedure;
 248 e 0BA1     put file (output) edit(
 249 e 0C36         '|',current_year,
 250 e 0C36         ' |',year_value,
 251 e 0C36         ' |',depreciation_value,
 252 e 0C36         ' |',book_value,' |')
 253 e 0C36         (skip,column(indent),a,f(2),4(a,p'$z,zzz,zz9v.99'));
 254 c 0C36 end print_line;
 255 c 0C36 
 256 c 0C36 /***************************************************/ 
 257 c 0C36 /* This procedure prints the summary of values for */
 258 c 0C36 /* each type of depreciation schedule.             */
 259 c 0C36 /***************************************************/
 260 c 0C36 summary:
 261 c 0C36     procedure;
 262 e 0C36     declare
 263 e 0C36        adj_ITC decimal(8,2),
 264 e 0C36        total decimal(8,2),
 265 e 0C36        direct decimal(8,2);
 266 e 0C36 
 267 e 0C36     call line();
 268 e 0C39     adj_ITC = ITC * 100 / tax_bracket;
 269 e 0C69     total = FYD + sales_tax + adj_ITC + bonus_dep;
 270 e 0C9A     direct = total * tax_bracket / 100;
 271 e 0CCA     put file (output) edit(
 272 e 0DF0     '|      First Year Reduction in Taxable Income    |',
 273 e 0DF0     '--------------------------------------------------',
 274 e 0DF0     '|      Depreciation              ' ,FYD,        '|',
 275 e 0DF0     '|      Sales Tax                 ' ,sales_tax,  '|',
 276 e 0DF0     '|      ITC (Adjusted)            ' ,adj_ITC,    '|',
 277 e 0DF0     '|      Bonus Depreciation        ' ,bonus_dep,  '|',
 278 e 0DF0     '|                                -------------   |',
 279 e 0DF0     '|      Total for First Year      ' ,total,      '|',
 280 e 0DF0     '|      Direct Reduction in Tax   ' ,direct,     '|')
 281 e 0DF0     (2(skip,column(indent),a),2(4(skip,column(indent),a,
 282 e 0DF0     p'$z,zzz,zz9v.99',x(3),a),skip,column(indent),a));
 283 e 0DF0     call line();
 284 c 0DF4 end summary;
 285 c 0DF4 
 286 c 0DF4 /*******************************************/ 
 287 c 0DF4 /* This procedure prints a line of dashes. */
 288 c 0DF4 /*******************************************/
 289 c 0DF4 line:
 290 c 0DF4     procedure;
 291 e 0DF4     put file (output) edit(
 292 e 0E15     '--------------------------------------------------')
 293 e 0E15     (skip,column(indent),a);
 294 c 0E15 end line;
 295 c 0E15 
 296 c 0E15 
 297 a 0E15 end depreciate;

CODE SIZE = 0E15
DATA AREA = 0514
FREE SYMS = 28E2
END  COMPILATION
