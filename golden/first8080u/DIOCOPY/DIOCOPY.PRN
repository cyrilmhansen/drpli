PL/I-80 V1.4 COMPILATION OF: DIOCOPY

   1   0000 /*********************************************************
   2   0000 * This PL/I program demonstrates direct operating system *
   3   0000 * calls by performing a file-to-file copy.               *
   4   0000 *********************************************************/
   5 a 0000 diocopy:
   6 a 0006     procedure options(main);
   7 a 0006 
   8 c 0006     %replace
   9 c 0006        bufwds by 64,   /* words per buffer */
  10 c 0006        quest  by 63,   /* ASCII '?' */
  11 c 0006        true   by '1'b,
  12 c 0006        false  by '0'b;
  13 c 0006 
  14 c 0006     
  15 c 0006 
  16+c 0006     declare 
  17+c 0006         memptr entry returns (pointer),
  18+c 0006         memsiz entry returns (fixed(15)),
  19+c 0006         memwds entry returns (fixed(15)),
  20+c 0006         dfcb0  entry returns (pointer),
  21+c 0006         dfcb1  entry returns (pointer),
  22+c 0006         dbuff  entry returns (pointer),
  23+c 0006         reboot entry,
  24+c 0006         rdcon  entry returns (character(1)),
  25+c 0006         wrcon  entry (character(1)),
  26+c 0006         rdrdr  entry returns (character(1)),
  27+c 0006         wrpun  entry (character(1)),
  28+c 0006         wrlst  entry (character(1)),
  29+c 0006         coninp entry returns (character(1)),
  30+c 0006         conout entry (character(1)),
  31+c 0006         rdstat entry returns (bit(1)),
  32+c 0006         getio  entry returns (bit(8)),
  33+c 0006         setio  entry (bit(8)),
  34+c 0006         wrstr  entry (pointer),
  35+c 0006         rdbuf  entry (pointer),
  36+c 0006         break  entry returns (bit(1)),
  37+c 0006         vers   entry returns (bit(16)),
  38+c 0006         reset  entry,
  39+c 0006         select entry (fixed(7)),
  40+c 0006         open   entry (pointer) returns (fixed(7)),
  41+c 0006         close  entry (pointer) returns (fixed(7)),
  42+c 0006         sear   entry (pointer) returns (fixed(7)),
  43+c 0006         searn  entry returns (fixed(7)),
  44+c 0006         delete entry (pointer),
  45+c 0006         rdseq  entry (pointer) returns (fixed(7)),
  46+c 0006         wrseq  entry (pointer) returns (fixed(7)),
  47+c 0006         make   entry (pointer) returns (fixed(7)),
  48+c 0006         rename entry (pointer),
  49+c 0006         logvec entry returns (bit(16)),
  50+c 0006         curdsk entry returns (fixed(7)),
  51+c 0006         setdma entry (pointer),
  52+c 0006         wpdisk entry,
  53+c 0006         rovec  entry returns (bit(16)),
  54+c 0006         filatt entry (pointer),
  55+c 0006         getusr entry returns (fixed(7)),
  56+c 0006         setusr entry (fixed(7)),
  57+c 0006         rdran  entry (pointer) returns (fixed(7)),
  58+c 0006         wrran  entry (pointer) returns (fixed(7)),
  59+c 0006         filsiz entry (pointer),
  60+c 0006         setrec entry (pointer),
  61+c 0006         resdrv entry (bit(16)),
  62+c 0006         wrranz entry (pointer) returns (fixed(7));
  63 c 0006 
  64 c 0006     declare 
  65 c 0006        1 destfile,
  66+c 0006               2 name1,
  67+c 0006             3 drive fixed(7),       /* drive number */
  68+c 0006             3 fname character(8),   /* file name */
  69+c 0006             3 ftype character(3),   /* file type */
  70+c 0006             3 fext  fixed(7),       /* file extent */
  71+c 0006             3 space (3) bit(8),     /* filler */
  72+c 0006           2 name2,                  /* used in rename */
  73+c 0006             3 drive2 fixed(7),
  74+c 0006             3 fname2 character(8),
  75+c 0006             3 ftype2 character(3),
  76+c 0006             3 fext2  fixed(7),
  77+c 0006             3 space2 (3) bit(8),
  78+c 0006           2 crec  fixed(7),    /* current record */
  79+c 0006           2 rrec  fixed(15),   /* random record */
  80+c 0006           2 rovf  fixed(7);    /* random rec overflow */
  81 c 0006 
  82 c 0006     declare 
  83 c 0006        dfcb0p ptr,
  84 c 0006        1 sourcefile based(dfcb0p),
  85+c 0006               2 name1,
  86+c 0006             3 drive fixed(7),       /* drive number */
  87+c 0006             3 fname character(8),   /* file name */
  88+c 0006             3 ftype character(3),   /* file type */
  89+c 0006             3 fext  fixed(7),       /* file extent */
  90+c 0006             3 space (3) bit(8),     /* filler */
  91+c 0006           2 name2,                  /* used in rename */
  92+c 0006             3 drive2 fixed(7),
  93+c 0006             3 fname2 character(8),
  94+c 0006             3 ftype2 character(3),
  95+c 0006             3 fext2  fixed(7),
  96+c 0006             3 space2 (3) bit(8),
  97+c 0006           2 crec  fixed(7),    /* current record */
  98+c 0006           2 rrec  fixed(15),   /* random record */
  99+c 0006           2 rovf  fixed(7);    /* random rec overflow */
 100 c 0006 
 101 c 0006     declare 
 102 c 0006        1 dfcb1file based(dfcb1()),
 103+c 0006               2 name1,
 104+c 0006             3 drive fixed(7),       /* drive number */
 105+c 0006             3 fname character(8),   /* file name */
 106+c 0006             3 ftype character(3),   /* file type */
 107+c 0006             3 fext  fixed(7),       /* file extent */
 108+c 0006             3 space (3) bit(8),     /* filler */
 109+c 0006           2 name2,                  /* used in rename */
 110+c 0006             3 drive2 fixed(7),
 111+c 0006             3 fname2 character(8),
 112+c 0006             3 ftype2 character(3),
 113+c 0006             3 fext2  fixed(7),
 114+c 0006             3 space2 (3) bit(8),
 115+c 0006           2 crec  fixed(7),    /* current record */
 116+c 0006           2 rrec  fixed(15),   /* random record */
 117+c 0006           2 rovf  fixed(7);    /* random rec overflow */
 118 c 0006 
 119 c 0006     declare 
 120 c 0006        1 renfile,
 121+c 0006               2 name1,
 122+c 0006             3 drive fixed(7),       /* drive number */
 123+c 0006             3 fname character(8),   /* file name */
 124+c 0006             3 ftype character(3),   /* file type */
 125+c 0006             3 fext  fixed(7),       /* file extent */
 126+c 0006             3 space (3) bit(8),     /* filler */
 127+c 0006           2 name2,                  /* used in rename */
 128+c 0006             3 drive2 fixed(7),
 129+c 0006             3 fname2 character(8),
 130+c 0006             3 ftype2 character(3),
 131+c 0006             3 fext2  fixed(7),
 132+c 0006             3 space2 (3) bit(8),
 133+c 0006           2 crec  fixed(7),    /* current record */
 134+c 0006           2 rrec  fixed(15),   /* random record */
 135+c 0006           2 rovf  fixed(7);    /* random rec overflow */
 136 c 0006 
 137 c 0006     declare 
 138 c 0006        answer char(1),
 139 c 0006        extcnt fixed(7);
 140 c 0006 
 141 c 0006 /* buffer management */
 142 c 0006 
 143 c 0006     declare 
 144 c 0006        eofile bit(1),
 145 c 0006        i      fixed(15),
 146 c 0006        m      fixed(15),
 147 c 0006        nbuffs fixed(15),
 148 c 0006        memory (0:0) bit(16) based(memptr());
 149 c 0006 
 150 c 0006 /* compute number of buffs, 64 words each */
 151 c 0006 
 152 c 0006     nbuffs = divide(memwds(),bufwds,15);
 153 c 0017     if nbuffs = 0 then
 154 c 0020        do;
 155 c 0020          put skip list('No Buffer Space');
 156 c 003C          call reboot();
 157 c 003F        end;
 158 c 003F 
 159 c 003F /* initialize fcb's */
 160 c 003F 
 161 c 003F     dfcb0p = dfcb0();
 162 c 0045     destfile = dfcb1file;
 163 c 0054 
 164 c 0054 /* copy fcb to rename file, count extents */
 165 c 0054 
 166 c 0054     renfile = destfile;
 167 c 0060 
 168 c 0060 /* search all extents by inserting '?' */
 169 c 0060 
 170 c 0060     renfile.fext = quest;
 171 c 0065     if sear(addr(renfile)) ^= -1 then
 172 c 0076        do;
 173 c 0076          extcnt = 1;
 174 c 007B          do while(searn() ^= -1);
 175 c 0083             extcnt = extcnt + 1;
 176 c 008A          end;
 177 c 008A          put edit ('OK to Delete ',extcnt,' Extent(s)?(Y/N)')
 178 c 00C1                   (skip,a,f(3),a);
 179 c 00C1          get list(answer);
 180 c 00DB          if ^ (answer = 'Y' ! answer = 'y') then
 181 c 00FF             call reboot();
 182 c 0102        end;
 183 c 0102 
 184 c 0102 /* destination file will be deleted later */
 185 c 0102 
 186 c 0102     destfile.ftype = '$$$';
 187 c 010E 
 188 c 010E /* delete any existing x.$$$ file */
 189 c 010E 
 190 c 010E     call delete(addr(destfile));
 191 c 011A 
 192 c 011A /* open the source file, if possible */
 193 c 011A 
 194 c 011A     if open(addr(sourcefile)) = -1 then
 195 c 012B        do;
 196 c 012B          put skip list('No Source File');
 197 c 0147          call reboot();
 198 c 014A        end;
 199 c 014A 
 200 c 014A /* source file opened, create $$$ file */
 201 c 014A 
 202 c 014A     destfile.fext = 0;
 203 c 014F     destfile.crec = 0;
 204 c 0154     if make(addr(destfile)) = -1 then
 205 c 0165        do;
 206 c 0165          put skip list('No Directory Space');
 207 c 0181          call reboot();
 208 c 0184        end;
 209 c 0184 
 210 c 0184 /* $$$ temp file created, now copy from source */
 211 c 0184 
 212 c 0184     eofile = false;
 213 c 0189     do while (^eofile);
 214 c 0190        m = 0;
 215 c 0196        /* fill buffers */
 216 c 0196        do i = 0 repeat (i+1) while (i<nbuffs);
 217 c 01A6           call setdma(addr(memory(m)));
 218 c 01B9           m = m + bufwds;
 219 c 01C3           if rdseq(addr(sourcefile)) ^= 0 then
 220 c 01D4              do;
 221 c 01D4                eofile = true;
 222 c 01D9                /* truncate buffer */
 223 c 01D9                nbuffs = i;
 224 c 01E9              end;
 225 c 01E9        end;
 226 c 01E9        m = 0;
 227 c 01EF        /* write buffers */
 228 c 01EF        do i = 0 to nbuffs-1;
 229 c 0206           call setdma(addr(memory(m)));
 230 c 0219           m = m + bufwds;
 231 c 0223           if wrseq(addr(destfile)) ^= 0 then
 232 c 0234              do;
 233 c 0234                put skip list('Disk Full');
 234 c 0250                call reboot();
 235 c 0260              end;
 236 c 0260        end;
 237 c 0260     end;
 238 c 0260 
 239 c 0260 /* close destination file and rename */
 240 c 0260 
 241 c 0260     if close(addr(destfile)) = -1 then
 242 c 0271        do;
 243 c 0271          put skip list('Disk R/O');
 244 c 028D          call reboot();
 245 c 0290        end;
 246 c 0290 
 247 c 0290 /* destination file closed, erase old file */
 248 c 0290 
 249 c 0290     call delete(addr(renfile));
 250 c 029C 
 251 c 029C /* now rename $$$ file to old file name */
 252 c 029C 
 253 c 029C     destfile.name2 = renfile.name1;
 254 c 02AB     call rename(addr(destfile));
 255 c 02B7     call reboot();
 256 c 02BA 
 257 a 02BA end diocopy;
 258 a 02BD 

CODE SIZE = 02BD
DATA AREA = 00EF
FREE SYMS = 2CD5
END  COMPILATION
