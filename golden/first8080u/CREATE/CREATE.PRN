COMPILATION OF: CREATE

D: Disk Print
L: List Source Program

%include 'record.dcl';
   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: CREATE

   1   0000 /*****************************************************/
   2   0000 /* This program creates a name and address file. The */
   3   0000 /* data structure for each record is in the %INCLUDE */
   4   0000 /* file RECORD.DCL.                                  */
   5   0000 /*****************************************************/
   6 a 0000 create:
   7 a 0006       procedure options(main);
   8 a 0006 
   9+c 0006     dcl
  10+c 0006         1 record,
  11+c 0006           2 name  character(30) varying,
  12+c 0006           2 addr  character(30) varying,
  13+c 0006           2 city  character(20) varying,
  14+c 0006           2 state character(10) varying,
  15+c 0006           2 zip   fixed decimal(6),
  16+c 0006           2 phone character(12) varying;
  17 c 0006 %replace
  18 c 0006   true by '1'b,
  19 c 0006   false by '0'b;
  20 c 0006 
  21 c 0006     declare 
  22 c 0006        output file,
  23 c 0006        filename character(14) varying,
  24 c 0006        eofile bit(1) static initial(false);
  25 c 0006 
  26 c 0006     put list ('Name and Address Creation Program, File Name: ');
  27 c 001D     get list (filename);
  28 c 0037 
  29 c 0037     open file(output) stream output title(filename);
  30 c 0052 
  31 c 0052     do while (^eofile);
  32 c 0059        put skip(3) list('Name: ');
  33 c 0075        get list(name);
  34 c 008F        eofile = (name = 'EOF');
  35 c 00A1        if ^eofile then
  36 c 00A8           do;
  37 c 00A8        /* write prompt strings to console */
  38 c 00A8             put list('Address: ');
  39 c 00BF             get list(addr);
  40 c 00D9             put list('City, State, Zip: ');
  41 c 00F0             get list(city, state, zip);
  42 c 012B             put list('Phone: ');
  43 c 0142             get list(phone);
  44 c 015C 
  45 c 015C        /* data in memory, write to output file */
  46 c 015C             put file(output)
  47 c 01AA                 list(name,addr,city,state,zip,phone);
  48 c 01AA             put file(output) skip;
  49 c 01C1           end;
  50 c 01C1     end;
  51 c 01C1     put file(output) skip list('EOF');
  52 c 01E0     put file(output) skip;
  53 c 01F4 
  54 a 01F4 end create;
  55 a 01F7 

CODE SIZE = 01F7
DATA AREA = 00D8
FREE SYMS = 36F7
END  COMPILATION
