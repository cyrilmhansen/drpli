COMPILATION OF: FSCAN

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: FSCAN

   1   0000 /******************************************************/
   2   0000 /* This program tests the procedure called GNT, which */
   3   0000 /* is a free-field scanner (parser) that reads a line */
   4   0000 /* of input and breaks it into individual parts.      */
   5   0000 /******************************************************/
   6 a 0000 fscan:
   7 a 0006     procedure options(main);
   8 c 0006     %replace
   9 c 0006         true by '1'b;
  10 c 0006     declare 
  11 c 0006         token character(80) varying
  12 c 0006         static initial('');
  13 c 0006 
  14 c 0006     gnt:
  15 c 0006         procedure;
  16 e 0006         declare 
  17 e 0009             i fixed,
  18 e 0009             line character(80) varying
  19 e 0009             static initial('');
  20 e 0009 
  21 e 0009         line = substr(line,length(token)+1);
  22 e 0023         do while(true);
  23 e 0023            if line = '' then
  24 e 0031               get edit(line) (a);
  25 e 004E            i = verify(line,' ');
  26 e 0063            if i = 0 then
  27 e 006C               line = '';
  28 e 0074            else
  29 e 0074            do;
  30 e 0074              line = substr(line,i);
  31 e 008A              i = verify(line,'0123456789.');
  32 e 009F              if i = 0 then
  33 e 00A8                 token = line;
  34 e 00B6              else
  35 e 00B6              if i = 1 then
  36 e 00BF                 token = substr(line,1,1);
  37 e 00D5              else
  38 e 00D5                 token = substr(line,1,i-1);
  39 e 00EE              return;
  40 e 00F2            end;
  41 e 00F2         end;
  42 c 00F2     end gnt;
  43 c 00F2 
  44 c 00F2     do while(true);
  45 c 00F2        call gnt;
  46 c 00F5        put edit(''''!!token!!'''') (x(1),a);
  47 c 0127     end;
  48 c 0127 
  49 a 0127 end fscan;
  50 a 0127 

CODE SIZE = 0127
DATA AREA = 00BD
FREE SYMS = 37C3
END  COMPILATION
