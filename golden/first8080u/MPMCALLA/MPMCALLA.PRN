 348 c 052D polltst:
 349 c 052D 
 350 c 052D get edit (v) (a);  /* clear input buffer */
 351 c 054A 
 352 c 054A /*  The following code is "commented out"
 353 c 054A 
 354 c 054A call poll (devicenumber);
 355 c 054A put edit ('Device ',devicenumber,'is ready.')
 356 c 054A          (skip,a,f,a);
 357 c 054A 
 358 c 054A End of comment-deleted code  */
 359 c 054A 
 360 c 054A put skip(2) list ('Poll call not tested.');
 361 c 0566 
 362 c 0566 /**********************************
 363 c 0566 *                                 *
 364 c 0566 * Flag Tests:                     *
 365 c 0566 *       FLGWT, FLGSET             *
 366 c 0566 *                                 *
 367 c 0566 *    Note: this test assumes that *
 368 c 0566 *    flags 30 & 31 are unused.    *
 369 c 0566 *                                 *
 370 c 0566 **********************************/
 371 c 0566 declare
 372 c 0566    flagover bit(1),
 373 c 0566    flagunder bit(1);
 374 c 0566 
 375 c 0566 unspec (localpd.link) = '0000'b4;
 376 c 056D localpd.priority = 100;
 377 c 0572 localpd.stkptr = addr (localstk(255));
 378 c 057E localpd.console = pd.console;
 379 c 058A localpd.memseg = pd.memseg;
 380 c 0594 localstk(255) = flagtest;
 381 c 059D call crproc (addr (localpd));
 382 c 05A9 put skip(2) list ('Flag Tests:');
 383 c 05C5 call setpri (101);
 384 c 05CB call detcon();
 385 c 05CE flagover = ~flgset (30);
 386 c 05D8 call attcon();
 387 c 05DB call setpri (oldpriority);
 388 c 05E1 flagunder = ~flgwt (31);
 389 c 05EB if flagover then
 390 c 05F2    put skip list ('-> flag over-run.');
 391 c 060E if flagunder then
 392 c 0615    put skip list ('-> flag under-run.');
 393 c 0631 put skip list ('-> flag tests successful.');
 394 c 064D 
 395 c 064D /**********************************
 396 c 064D *                                 *
 397 c 064D * Queue Management Tests:         *
 398 c 064D *    MAKQUE,OPNQUE,DELQUE         *
 399 c 064D *    RDQUE,CRDQUE,WRQUE,CWRQUE    *
 400 c 064D *                                 *
 401 c 064D **********************************/
 402 c 064D declare
 403 c 064D    1 qcbA static,
 404 c 064D      2 link fixed(15),
 405 c 064D      2 name character(8) initial ('QueueA  '),
 406 c 064D      2 msglen fixed(15) initial (10),
 407 c 064D      2 nmbmsgs fixed(15) initial (2),
 408 c 064D      2 dqph pointer,
 409 c 064D      2 nqph pointer,
 410 c 064D      2 msgin pointer,
 411 c 064D      2 msgout pointer,
 412 c 064D      2 msgcnt fixed(15),
 413 c 064D      2 buffer (2),
 414 c 064D        3 lnk pointer,
 415 c 064D        3 character(10);
 416 c 064D 
 417 c 064D declare
 418 c 064D    1 uqcbA,
 419 c 064D      2 pointer pointer,
 420 c 064D      2 msgadr pointer;
 421 c 064D 
 422 c 064D declare
 423 c 064D    1 uqcbB static,
 424 c 064D      2 pointer pointer,
 425 c 064D      2 msgadr pointer,
 426 c 064D      2 name character(8) initial ('QueueB  ');
 427 c 064D 
 428 c 064D declare
 429 c 064D    msgA character(10),
 430 c 064D    msgB character(10);
 431 c 064D 
 432 c 064D put skip(2) list ('Queue Tests:');
 433 c 0669 on endfile (sysin)
 434 d 0671    goto abtsprtest;
 435 d 0677 
 436 c 0677 uqcbA.pointer = addr (qcbA);
 437 c 0680 uqcbA.msgadr = addr (msgA);
 438 c 0689 uqcbB.msgadr = addr (msgB);
 439 c 0692 call makque (addr (qcbA));
 440 c 069E 
 441 c 069E put skip(2) list ('  Testing Conditional Write Queue');
 442 c 06BA do i = 1 to 10 while (cwrque (addr (uqcbA)));
 443 c 06DA    put edit ('    Message #',i) (skip,a,f(2));
 444 c 070C end;
 445 c 070C put skip list ('  Queue is full.');
 446 c 0728 
 447 c 0728 put skip(2) list ('  Testing Conditional Read Queue');
 448 c 0744 do i = 1 to 10 while (crdque (addr (uqcbA)));
 449 c 0764    put edit ('    Message #',i) (skip,a,f(2));
 450 c 0796 end;
 451 c 0796 put skip list ('  Queue is empty.');
 452 c 07B2 
 453 c 07B2 unspec (localpd.link) = '0000'b4;
 454 c 07B9 localpd.priority = 100;
 455 c 07BE localpd.stkptr = addr (localstk(255));
 456 c 07CA localpd.console = pd.console;
 457 c 07D6 localpd.memseg = pd.memseg;
 458 c 07E0 localstk(255) = queuetest;
 459 c 07E9 call crproc (addr (localpd));
 460 c 07F5 
 461 c 07F5 do while (~opnque (addr (uqcbB)));
 462 c 0805    call delay (1); /* until qcbB created */
 463 c 080E end;
 464 c 080E put skip list ('  Enter character(10) message:');
 465 c 082A do while (true);
 466 c 082A    put skip list ('->');
 467 c 0846    get edit (msgA) (a);
 468 c 0863    call wrque (addr (uqcbA));
 469 c 086F    call rdque (addr (uqcbB));
 470 c 087B    put edit ('<-',msgB) (skip,a,a(10));
 471 c 08AD end;
 472 c 08AD 
 473 c 08AD /**********************************
 474 c 08AD *                                 *
 475 c 08AD * Abort Specified Process Test:   *
 476 c 08AD *                                 *
 477 c 08AD **********************************/
 478 c 08AD declare
 479 c 08AD    1 abtpb static,
 480 c 08AD      2 pda bit(16) initial ('0000'b4),
 481 c 08AD      2 termcode bit(16) initial ('ffff'b4),
 482 c 08AD      2 name character(8) initial ('LocalPD '),
 483 c 08AD      2 console fixed(7);
 484 c 08AD 
 485 c 08AD abtsprtest:
 486 c 08AD 
