 181 c 004B 
 182 c 004B queuetest:
 183 c 004B procedure;
 184 e 004B declare
 185 e 004E    1 qcbB static,
 186 e 004E      2 link fixed(15),
 187 e 004E      2 name character(8) initial ('QueueB  '),
 188 e 004E      2 msglen fixed(15) initial (10),
