 504 c 0988      call term('0000'b4);
 505 c 098E    end;
 506 c 098E if ~delque (uqcbB.pointer) then
 507 c 099E    do;
 508 c 099E      put skip list ('*** Unable to delete QueueB ***');
 509 c 09BA      call term('0000'b4);
 510 c 09C0    end;
