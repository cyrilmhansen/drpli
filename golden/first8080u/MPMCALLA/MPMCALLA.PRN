 212 e 004E    msgB character(10);
 213 e 004E 
 214 e 004E uqcbA.msgadr = addr (msgA);
 215 e 0057 uqcbB.pointer = addr (qcbB);
 216 e 0060 uqcbB.msgadr = addr (msgB);
 217 e 0069 call makque (addr (qcbB));
 218 e 0075 do while (~opnque (addr (uqcbA)));
 219 e 0085    call delay (1); /* until qcbA created */
 220 e 008E end;
 221 e 008E do while (true);
 222 e 008E    call rdque (addr (uqcbA));
 223 e 009A    msgB = translate (msgA,upper,lower);
 224 e 00BF    call wrque (addr (uqcbB));
 225 e 00CE end;
