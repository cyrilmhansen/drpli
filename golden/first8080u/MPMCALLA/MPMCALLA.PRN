 238 c 00CE /**********************************
 239 c 00CE *                                 *
 240 c 00CE * Verify Operation Under MP/M     *
 241 c 00CE *   Without Banked Memory.        *
 242 c 00CE *                                 *
 243 c 00CE **********************************/
 244 c 00CE 
 245 c 00CE version = vers();
 246 c 00D4 if substr (version,1,8) = '00'b4 then
 247 c 00DD do;
 248 c 00DD   put skip list ('Tests cannot run under CP/M.');
 249 c 00F9   call term('0000'b4);
 250 c 00FF end;
 251 c 00FF sysdatpgadr = sysdat ();
 252 c 0105 if sysdatpg.bankswitched = 'FF'b4 then
 253 c 0112 do;
 254 c 0112   put skip list ('Tests cannot run under MP/M');
 255 c 012E   put list ('with bank switched memory.');
 256 c 0145   call term('0000'b4);
 257 c 014B end;
 258 c 014B if sysdatpg.syscallstks = 'FF'b4 then
 259 c 0157 do;
 260 c 0157   put skip list ('Tests cannot run under MP/M');
 261 c 0173   put list ('with system call user stacks.');
 262 c 018A   call term('0000'b4);
 263 c 0190 end;
 264 c 0190 pdadr = rpdadr();   /* get current running pd adr */
 265 c 0196 oldpriority = pd.priority;
 266 c 01A0 
 267 c 01A0 /**********************************
 268 c 01A0 *                                 *
 269 c 01A0 * Memory Management Tests:        *
 270 c 01A0 *       AMEMRQ, RMEMRQ, MEMFR     *
 271 c 01A0 *                                 *
 272 c 01A0 **********************************/
 273 c 01A0 declare
 274 c 01A0    1 memdscr,
 275 c 01A0      2 base fixed (7),     /* base page */
 276 c 01A0      2 size fixed (7),     /* # of pages */
 277 c 01A0      2 attrib fixed (7),   /* attributes */
 278 c 01A0      2 bank fixed (7);     /* bank byte */
 279 c 01A0 
 280 c 01A0 on endfile (sysin)
 281 d 01A8    goto rmemrqtst;
 282 c 01AE put skip list ('Memory Management Tests:');
 283 c 01CA do while (true);
 284 c 01CA    put skip(2) list ('    Absolute Request');
 285 c 01E6    put skip list ('        Base (xx in hex) = ');
 286 c 0202    i = pd.memseg;  /* save old memseg index */
 287 c 0211    get edit (unspec (memdscr.base)) (b4(2));
 288 c 022E    if amemrq (addr (memdscr)) then
 289 c 023E       do;
 290 c 023E         put skip list ('    Absolute Request satisfied.');
 291 c 025A         put edit ('      Base = ',unspec (memdscr.base),'H')
 292 c 028D                  (skip,a,b4,a);
 293 c 028D         put edit ('      Size = ',unspec (memdscr.size),'H')
 294 c 02C0                  (skip,a,b4,a);
 295 c 02C0         put edit ('      Attr = ',unspec (memdscr.attrib),'H')
 296 c 02F3                  (skip,a,b4,a);
 297 c 02F3         put edit ('      Bank = ',unspec (memdscr.bank),'H')
 298 c 0326                  (skip,a,b4,a);
 299 c 0326         call memfr (addr (memdscr));
 300 c 0332         pd.memseg = i;  /* restore former memseg index */
 301 c 0340       end;
 302 c 0340    else
 303 c 0340       do;
 304 c 0340         put skip list ('    Absolute Request failed.');
 305 c 0366       end;
 306 c 0366 end;
 307 c 0366 
 308 c 0366 rmemrqtst:
 309 c 0366 
 310 c 0366 get edit (v) (a);  /* clear input buffer */
 311 c 0383 
 312 c 0383 on endfile (sysin)
 313 d 038B    goto polltst;
 314 c 0391 do while (true);
 315 c 0391    put skip(2) list ('    Relocatable Request');
 316 c 03AD    put skip list ('        Size (xxh) = ');
 317 c 03C9    i = pd.memseg;  /* save old memseg index */
 318 c 03D8    get edit (unspec (memdscr.size)) (b4(2));
 319 c 03F5    if rmemrq (addr (memdscr)) then
 320 c 0405       do;
 321 c 0405         put skip list ('    Relocatable Request satisfied.');
 322 c 0421         put edit ('      Base = ',unspec (memdscr.base),'H')
 323 c 0454                  (skip,a,b4,a);
 324 c 0454         put edit ('      Size = ',unspec (memdscr.size),'H')
 325 c 0487                  (skip,a,b4,a);
 326 c 0487         put edit ('      Attr = ',unspec (memdscr.attrib),'H')
 327 c 04BA                  (skip,a,b4,a);
 328 c 04BA         put edit ('      Bank = ',unspec (memdscr.bank),'H')
 329 c 04ED                  (skip,a,b4,a);
 330 c 04ED         call memfr (addr (memdscr));
 331 c 04F9         pd.memseg = i;  /* restore former memseg index */
 332 c 0507       end;
 333 c 0507    else
 334 c 0507      do;
 335 c 0507        put skip list ('    Relocatable Request failed.');
 336 c 052D      end;
 337 c 052D end;
 338 c 052D 
 339 c 052D /**********************************
 340 c 052D *                                 *
 341 c 052D * Poll Tests:                     *
 342 c 052D *  The poll call cannot be tested *
 343 c 052D *  unless the poll device table   *
 344 c 052D *  in the XIOS is known.          *
