COMPILATION OF: EXPR2

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: EXPR2

   1   0000 /******************************************************/
   2   0000 /* This program evaluates an arithmetic expression    */
   3   0000 /* using recursion.  It contains an expanded version  */
   4   0000 /* of the GNT procedure that obtains an expression    */
   5   0000 /* containing separate tokens. EXP then recursively   */
   6   0000 /* evaluates the tokens in the input line.            */
   7   0000 /******************************************************/
   8   0000 
   9 a 0000 expression:
  10 a 0006     procedure options(main);
  11 a 0006 
  12 c 0006     %replace
  13 c 000D         true by '1'b;
  14 c 000D 
  15 c 000D     declare 
  16 c 000D        sysin file,
  17 c 000D        value float,
  18 c 000D        (token character(10), line character(80)) varying
  19 c 000D        static initial('');
  20 c 000D 
  21 c 000D     on endfile(sysin)
  22 d 0015        stop;
  23 d 001B 
  24 c 001B     on error(1) /* conversion or signal */
  25 d 0022        begin;
  26 e 0025          put skip list('Invalid Input at ',token);
  27 e 004A          token = ''; line = '';
  28 e 0054          goto restart;
  29 d 0057        end;
  30 d 0057 
  31 c 0057     restart:
  32 c 005E 
  33 c 005E         do while('1'b);
  34 c 005E            put skip(3) list('Type expression: ');
  35 c 007A            value = exp();
  36 c 0083            put edit('Value is: ',value) (skip,a,f(10,4));
  37 c 00AE         end;
  38 c 00AE 
  39 c 00AE     gnt:
  40 c 00AE        procedure; 
  41 e 00AE        declare 
  42 e 00AE           i fixed;
  43 e 00AE 
  44 e 00AE         line = substr(line,length(token)+1);
  45 e 00C8         do while(true);
  46 e 00C8            if line = '' then
  47 e 00D6               get edit(line) (a);
  48 e 00F3               i = verify(line,' ');
  49 e 0108            if i = 0 then
  50 e 0111               line = '';
  51 e 0119            else
  52 e 0119               do;
  53 e 0119                 line = substr(line,i);
  54 e 012F                 i = verify(line,'0123456789.');
  55 e 0144                 if i = 0 then
  56 e 014D                    token = line;
  57 e 015B                 else
  58 e 015B                 if i = 1 then
  59 e 0164                    token = substr(line,1,1);
  60 e 017A                 else
  61 e 017A                    token = substr(line,1,i-1);
  62 e 0193                 return;
  63 e 0197               end;
  64 e 0197         end;
  65 c 0197     end gnt;
  66 c 0197 
  67 c 0197     exp:
  68 c 0197         procedure returns(float binary) recursive;
  69 e 0197         declare x float binary;
  70 e 01A0         call gnt();
  71 e 01A3         if token = '(' then
  72 e 01B1            do;
  73 e 01B1              x  = exp();
  74 e 01BA              call gnt();
  75 e 01BD              if token = '+' then
  76 e 01CB                 x = x + exp();
  77 e 01DD              else
  78 e 01DD              if token = '-' then
  79 e 01EB                 x = x - exp();
  80 e 01FD              else
  81 e 01FD              if token = '*' then
  82 e 020B                 x = x * exp();
  83 e 021D              else
  84 e 021D              if token = '/' then
  85 e 022B                 x = x / exp();
  86 e 023D              else
  87 e 023D              signal error(1);
  88 e 0244              call gnt();
  89 e 0247              if token ^= ')' then
  90 e 0255                 signal error(1);
  91 e 025F            end;
  92 e 025F         else
  93 e 025F             x = token;
  94 e 0271         return(x);
  95 c 027D     end exp;
  96 c 027D 
  97 a 027D end expression;
  98 a 027D 

CODE SIZE = 027D
DATA AREA = 00B5
FREE SYMS = 360B
END  COMPILATION
