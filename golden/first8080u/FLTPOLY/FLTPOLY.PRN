COMPILATION OF: FLTPOLY

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: FLTPOLY

   1   0000 /*****************************************************/
   2   0000 /* This program evaluates a polynomial expression    */
   3   0000 /* using FLOAT BINARY data.                          */
   4   0000 /*****************************************************/
   5 a 0000 fltpoly: 
   6 a 0006     procedure options(main);
   7 a 0006 
   8 c 0006     %replace
   9 c 0006         true  by '1'b;
  10 c 0006     declare 
  11 c 0006         (x,y,z) float binary(24);
  12 c 0006 
  13 c 0006     do while(true);
  14 c 0006        put skip(2) list('Type x,y,z: ');
  15 c 0022        get list(x,y,z);
  16 c 0064 
  17 c 0064        if x=0 & y=0 & z=0 then
  18 c 0097           stop;
  19 c 009A 
  20 c 009A        put skip list('       2');
  21 c 00B6        put skip list('      x  + 2y + z =',P(x,y,z));
  22 c 00E3     end;
  23 c 00E3 
  24 c 00E3     P:
  25 c 00E3       procedure (x,y,z) returns (float binary(24));
  26 e 00E3       declare 
  27 e 00F0             (x,y,z) float binary;
  28 e 00F0       return (x * x + 2 * y + z);
  29 c 0112     end P;
  30 c 0112 
  31 a 0112 end fltpoly;
  32 a 0112 

CODE SIZE = 0112
DATA AREA = 0047
FREE SYMS = 377D
END  COMPILATION
