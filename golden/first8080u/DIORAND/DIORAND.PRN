 163 c 0280          put skip list('File Size:',rrec,' Records');
 164 c 02B2        end;
 165 c 02B2 
 166 c 02B2 /* main processing loop */
 167 c 02B2 
 168 c 02B2     do while('1'b);
 169 c 02B2        call setrec(addr(database));
 170 c 02BE        put skip list('Current Record',rrec);
 171 c 02E5        put skip list('Read(0),Write(1),Quit(2)? ');
 172 c 0301        get list(mode);
