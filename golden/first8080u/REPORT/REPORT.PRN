COMPILATION OF: REPORT

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: REPORT

   1   0000 /******************************************************/
   2   0000 /* This program reads an employee data base and       */
   3   0000 /* prints a list of paychecks.                        */
   4   0000 /******************************************************/
   5 a 0000 report:
   6 a 0006     procedure options(main);
   7 c 0006     declare
   8 c 0006        1 employee static,
   9 c 0006          2 name     character(30) varying,
  10 c 0006          2 address,
  11 c 0006            3 street character(30) varying,
  12 c 0006            3 city   character(10) varying,
  13 c 0006            3 state  character(12) varying,
  14 c 0006            3 zip    fixed decimal(5),
  15 c 0006          2 age      fixed decimal(3),
  16 c 0006          2 wage     fixed decimal(5,2),
  17 c 0006          2 hours    fixed decimal(5,1);
  18 c 0006 
  19 c 0006     declare
  20 c 0006        i fixed,
  21 c 0006        dashes character(15) static initial
  22 c 0006               ('$--------------'),
  23 c 0006        buff character(20) varying, 
  24 c 0006        (grosspay, withhold) fixed decimal(7,2),
  25 c 0006        (repfile, empfile) file;
  26 c 0006 
  27 c 0006     open file(empfile) keyed environment(f(128),b(4000))
  28 c 002A          title ('$1.EMP');
  29 c 002A     open file(repfile) stream print environment(b(2000)) 
  30 c 004E          title('$2.$2');
  31 c 004E 
  32 c 004E     put list('Set Top of Forms, Press Return');
  33 c 0065     get skip;
  34 c 0076 
  35 c 0076     do while('1'b);
  36 c 0076        read file(empfile) into(employee);
  37 c 008E        if name = 'EOF' then
  38 c 009D           stop;
  39 c 00A0        put file(repfile) skip(2);
  40 c 00B4        buff = '[' !! name !! ']^m^j';
  41 c 00D6        write file(repfile) from (buff);
  42 c 00EE        grosspay = wage * hours;
  43 c 010E        withhold = grosspay * .15;
  44 c 012E        buff = grosspay - withhold;
  45 c 0150        do i = 1 to 15
  46 c 0189           while (substr(buff,i,1) = ' ');
  47 c 0189        end;
  48 c 0189        i = i - 1;
  49 c 0190        substr(buff,1,i) = substr(dashes,1,i);
  50 c 01B5        write file (repfile) from(buff);
  51 c 01D0     end;
  52 c 01D0 
  53 a 01D0 end report;
  54 a 01D0 

CODE SIZE = 01D0
DATA AREA = 00C2
FREE SYMS = 3675
END  COMPILATION
