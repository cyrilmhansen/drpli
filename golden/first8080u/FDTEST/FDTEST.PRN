PL/I-80 V1.4 COMPILATION OF: FDTEST

   1   0000 /****************************************************/ 
   2   0000 /* This program tests the assembly-language routine */
   3   0000 /* called FDIV2 which returns a FLOAT BINARY value. */
   4   0000 /****************************************************/
   5 a 0000 fdtest:
   6 a 0006     procedure options(main);
   7 c 0006     declare 
   8 c 0006       fdiv2 entry(fixed(7),float) returns(float),
   9 c 0006       i fixed(7),
  10 c 0006       f float;
  11 c 0006 
  12 c 0006     do i = 0 by 1;
  13 c 000A        put skip list('100 / 2 **',i,'=',fdiv2(i,100));
  14 c 0055     end;
  15 c 0055 
  16 a 0055 end fdtest;
  17 a 0055 

CODE SIZE = 0055
DATA AREA = 0018
FREE SYMS = 3826
END  COMPILATION
