PL/I-80 V1.4 COMPILATION OF: REVERSE

   1   0000 /******************************************************/
   2   0000 /* This program reads a sentence and reverses it.     */
   3   0000 /******************************************************/
   4 a 0000 reverse:
   5 a 0006     procedure options(main);
   6 c 0006     declare 
   7 c 0006         sentence pointer,
   8 c 0006         1 wordnode based (sentence),
   9 c 0006           2 word character(30) varying,
  10 c 0006           2 next pointer;
  11 c 0006 
  12 c 0006     do while('1'b);
  13 c 0006        call read_it();
  14 c 0009        if sentence = null then
  15 c 0011           stop;
  16 c 0014        call write_it();
  17 c 001A     end;
  18 c 001A 
  19 c 001A     read_it:
  20 c 001A         procedure; 
  21 e 001A         declare 
  22 e 001A           newword character(30) varying,
  23 e 001A           newnode pointer; 
  24 e 001A         sentence = null;
  25 e 0020         put skip list('What''s up? ');
  26 e 003C         do while('1'b);
  27 e 003C            get list(newword);
  28 e 0056            if newword = '.' then
  29 e 0064               return;
  30 e 0065            allocate wordnode set (newnode);
  31 e 006E            newnode->next = sentence;
  32 e 007D            sentence      = newnode;
  33 e 0083            word          = newword;
  34 e 0091         end;
  35 c 0091     end read_it;
  36 c 0091 
  37 c 0091     write_it:
  38 c 0091         procedure;
  39 e 0091         declare 
  40 e 0091           p pointer; 
  41 e 0091         put skip list('Actually, ');
  42 e 00AD         do while (sentence ^= null);
  43 e 00B5            put list(word);
  44 e 00CA            p = sentence;
  45 e 00D0            sentence = next;
  46 e 00DE            free p->wordnode;
  47 e 00E7         end;
  48 e 00E7         put list('.');
  49 e 00FE         put skip;
  50 c 0110     end write_it;
  51 c 0110 
  52 a 0110 end reverse;
  53 a 0110 

CODE SIZE = 0110
DATA AREA = 003B
FREE SYMS = 37BC
END  COMPILATION
