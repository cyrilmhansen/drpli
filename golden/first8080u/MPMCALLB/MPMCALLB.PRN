 292 d 038D 
 293 c 038D put skip list ('  Enter string of filenames to be parsed,');
 294 c 03A9 put list ('separated by commas:');
 295 c 03C0 do while (true);
 296 c 03C0    put skip list ('->');
 297 c 03DC    get edit (line) (a);
 298 c 03F9    line = substr (line,1,index (line,' ')-1) || ascii (13);
 299 c 0426    pfcb.flname = addr (line);
