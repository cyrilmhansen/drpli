 145 c 0162 /**********************************
 146 c 0162 *                                 *
 147 c 0162 * Send CLI Command Test:          *
 148 c 0162 *   This example shows how to run *
 149 c 0162 *   a program in another memory   *
 150 c 0162 *   segment and then get the con- *
 151 c 0162 *   sole back to the main program.*
 152 c 0162 *   E.G. as in a menu-driven      *
 153 c 0162 *   application.                  *
 154 c 0162 *                                 *
 155 c 0162 **********************************/
 156 c 0162 declare
 157 c 0162    1 clicmd,
 158 c 0162      2 dslct bit(8),  /* default disk / user code */
 159 c 0162      2 console fixed(7),  /* console number */
 160 c 0162      2 line character(128);
 161 c 0162 
 162 c 0162 declare
 163 c 0162    1 apb static,
 164 c 0162      2 console fixed(7),
 165 c 0162      2 name character(8) initial ('cli     '),
 166 c 0162      2 match bit(8) initial ('00'b4);
 167 c 0162 
 168 c 0162 put skip(2) list ('Send CLI Command Test:');
 169 c 017E on endfile (sysin)
 170 d 0186    goto clresptst;
 171 d 018C 
 172 c 018C pdadr = rpdadr();   /* get current running pd adr */
 173 c 0192 oldpriority = pd.priority;
 174 c 019C clicmd.dslct = pd.slct;
 175 c 01A8 clicmd.console = pd.console;
 176 c 01B3 apb.console = pd.console;
 177 c 01BC do while (true);
 178 c 01BC    put skip list ('  Enter CLI Command: ');
 179 c 01D8    get edit (clicmd.line) (a);
 180 c 01F5    if ~asncon (addr (apb)) then
 181 c 0205       do;
 182 c 0205         put skip list ('*** Failed to assign Cli the console ***');
 183 c 0224       end;
 184 c 0224    else
 185 c 0224       do;
 186 c 0224         call setpri (197);
 187 c 0239         call sclicd (addr (clicmd));
 188 c 0245         call attcon();
 189 c 0248         call setpri (oldpriority);
 190 c 0258       end;
 191 c 0258    end;
