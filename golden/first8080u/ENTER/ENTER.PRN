COMPILATION OF: ENTER

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: ENTER

   1   0000 /******************************************************/
   2   0000 /* This program constructs a data base of employee    */
   3   0000 /* records using a structure declaration.             */
   4   0000 /******************************************************/
   5   0000 
   6 a 0000 enter:
   7 a 0006     procedure options(main);
   8 c 0006     %replace
   9 c 0006         true  by '1'b,
  10 c 0006         false by '0'b;
  11 c 0006 
  12 c 0006     declare 
  13 c 0006        1 employee static,
  14 c 0006          2 name     character(30) varying,
  15 c 0006          2 address,
  16 c 0006            3 street character(30) varying,
  17 c 0006            3 city   character(10) varying,
  18 c 0006            3 state  character(12) varying,
  19 c 0006            3 zip    fixed decimal(5),
  20 c 0006          2 age      fixed decimal(3),
  21 c 0006          2 wage     fixed decimal(5,2),
  22 c 0006          2 hours    fixed decimal(5,1);
  23 c 0006 
  24 c 0006     declare 
  25 c 0006        1 default static,
  26 c 0006          2 street character(30) varying
  27 c 0006            initial('(no street)'),
  28 c 0006          2 city   character(10) varying
  29 c 0006            initial('(no city)'),
  30 c 0006          2 state  character(12)  varying
  31 c 0006            initial('(no state)'),
  32 c 0006          2 zip    fixed decimal(5)
  33 c 0006            initial(00000);
  34 c 0006     declare 
  35 c 0006        emp file;
  36 c 0006 
  37 c 0006     open file(emp) keyed output environment(f(128),b(8000))
  38 c 002A          title ('$1.EMP');
  39 c 002A 
  40 c 002A     do while(true);
  41 c 002A        put list('Employee: ');
  42 c 0041        get list(name);
  43 c 005B        if name = 'EOF' then
  44 c 006A           do;
  45 c 006A             call write_it();
  46 c 006D             stop;
  47 c 0070           end;
  48 c 0070        address = default;
  49 c 007C        put list ('  Age, Wage: ');
  50 c 0093        get list (age,wage);
  51 c 00C5        hours = 0;
  52 c 00D5        call write_it();
  53 c 00DB     end;
  54 c 00DB 
  55 c 00DB     write_it:
  56 c 00DB          procedure;
  57 e 00DB          write file(emp) from(employee);
  58 c 00F4     end write_it;
  59 c 00F4 
  60 a 00F4 end enter;
  61 a 00F4 

CODE SIZE = 00F4
DATA AREA = 00BE
FREE SYMS = 36FF
END  COMPILATION
