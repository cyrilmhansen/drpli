PL/I-80 V1.4 COMPILATION OF: TEST

   1   0000 /***************************************************/ 
   2   0000 /* This program computes the largest of three      */
   3   0000 /* FLOAT BINARY numbers x, y, and z                */   
   4   0000 /***************************************************/
   5 a 0000 test:
   6 a 0006     procedure options(main);
   7 c 0006     declare 
   8 c 0006        (a,b,c) float binary;
   9 c 0006 
  10 c 0006     put list ('Type Three Numbers: ');
  11 c 001D     get list (a,b,c);
  12 c 005F     put list ('The Largest Value is',max3(a,b,c));
  13 c 0084 
  14 c 0084     /* this procedure computes the largest of x, y, and z */
  15 c 0084     max3: 
  16 c 0084         procedure(x,y,z) returns(float binary);
  17 e 0084         declare 
  18 e 0094            (x,y,z,max) float binary;
  19 e 0094 
  20 e 0094         if x > y then
  21 e 00A2            if x > z then
  22 e 00B0               max = x;
  23 e 00BE            else
  24 e 00BE               max = z;
  25 e 00CC         else
  26 e 00CC            if y > z then
  27 e 00DA               max = y;
  28 e 00E8            else
  29 e 00E8               max = z;
  30 e 00F3         return(max);
  31 c 00FC     end max3;
  32 c 00FC 
  33 a 00FC end test;
  34 a 00FF 

