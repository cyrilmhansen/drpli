COMPILATION OF: FLTPOLY2

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: FLTPOLY2

   1   0000 /******************************************************/
   2   0000 /* This program evaluates a polynomial expression     */
   3   0000 /* using FLOAT BINARY data.  It also traps the end-of */
   4   0000 /* file condition for the file SYSIN.                 */
   5   0000 /******************************************************/
   6 a 0000 fltpoly2:
   7 a 0006     procedure options(main);
   8 c 0006     %replace
   9 c 0006         false by '0'b,
  10 c 0006         true  by '1'b;
  11 c 0006     declare
  12 c 0006       (x,y,z) float binary(24),
  13 c 0006       eofile bit(1) static initial(false),
  14 c 0006       sysin file;
  15 c 0006 
  16 c 0006     on endfile(sysin)
  17 d 000E         eofile = true;
  18 d 0016 
  19 c 0016     do while(true);
  20 c 0017        put skip(2) list('Type x,y,z: ');
  21 c 0033        get list(x,y,z);
  22 c 0075 
  23 c 0075        if eofile then
  24 c 007C           stop;
  25 c 007F 
  26 c 007F        put skip list('       2');
  27 c 009B        put skip list('      x  + 2y + z =',P(x,y,z));
  28 c 00C8     end;
  29 c 00C8 
  30 c 00C8     P:
  31 c 00C8      procedure (x,y,z) returns (float binary(24));
  32 e 00C8      declare 
  33 e 00D5        (x,y,z) float binary(24);
  34 e 00D5      return (x * x + 2 * y + z);
  35 c 00F7     end P;
  36 c 00F7 
  37 a 00F7 end fltpoly2;
  38 a 00F7 

CODE SIZE = 00F7
DATA AREA = 0044
FREE SYMS = 3765
END  COMPILATION
