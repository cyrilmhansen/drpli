PL/I-80 V1.4 COMPILATION OF: E46M31

   1 a 0000 E46M31:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2b] RUNTIME, CREATE-SHAPED AND EXECUTABLE: six items in
   4 a 0006      one file PUT -- five CHARACTER VARYING members of one internal
   5 a 0006      record plus one ORDINARY FIXED DECIMAL scalar, assigned and
   6 a 0006      written by ONE statement. This is as close to CREATE:39 as this
   7 a 0006      compiler can reach, because a level-numbered FIXED DECIMAL
   8 a 0006      member is not resolvable here at all. */
   9 c 0006   dcl outf file;
  10 c 0006   dcl 1 rec,
  11 c 0006     2 name  char(30) varying,
  12 c 0006     2 addr  char(30) varying,
  13 c 0006     2 city  char(20) varying,
  14 c 0006     2 state char(10) varying,
  15 c 0006     2 phone char(12) varying;
  16 c 0006   dcl zip fixed dec(6);
  17 c 0006   rec.name = 'JOHN';
  18 c 0013   rec.addr = '1 HIGH ST';
  19 c 0020   rec.city = 'BOSTON';
  20 c 002D   rec.state = 'MA';
  21 c 003A   rec.phone = '555-1212';
  22 c 0047   zip = 12345;
  23 c 0057   open file(outf) stream output title('M31OUT DAT');
  24 c 0074   put file(outf) list(name,addr,city,state,zip,phone);
  25 c 00C2   close file(outf);
  26 c 00C8   put list('DONE');
  27 c 00DF   stop;
  28 a 00E2 end E46M31;

CODE SIZE = 00E2
