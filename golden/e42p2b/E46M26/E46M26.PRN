PL/I-80 V1.4 COMPILATION OF: E46M26

   1 a 0000 E46M26:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2b] AN UNAUTHORIZED SECOND ITEM ON A FILE THIS COMPILER
   4 a 0006      NEVER OPENED. Two guards meet: the per-item authorization and
   5 a 0006      the open guard. E46K10 measured that the ITEM question is
   6 a 0006      answered FIRST, so this must refuse on the item and not on the
   7 a 0006      open -- and it must refuse the statement as a whole, not the
   8 a 0006      second item alone. */
   9 c 0006   dcl outf file, v char(20) varying, q float;
  10 c 0006   put file(outf) list(v,q);
  11 c 0029   stop;
  12 a 002C end E46M26;

CODE SIZE = 002C
DATA AREA = 0019
FREE SYMS = 38C2
END  COMPILATION
