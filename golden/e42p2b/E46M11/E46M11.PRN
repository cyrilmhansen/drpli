PL/I-80 V1.4 COMPILATION OF: E46M11

   1 a 0000 E46M11:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2b] CHARACTER VARYING beside FIXED DECIMAL, both
   4 a 0006      orders, FILE ONLY. This is CREATE's zip-among-the-characters
   5 a 0006      shape in its smallest form. The CONSOLE route refuses a mixed
   6 a 0006      character/decimal multi-item list today (the [E2E-29/P1]
   7 a 0006      classifier admits literals, characters and BINARYs beside each
   8 a 0006      other, not DECIMALS), so the console twin is E46M12 and not an
   9 a 0006      unrelated refusal inside this object. */
  10 c 0006   dcl outf file, v char(20) varying, z fixed dec(6);
  11 c 0006   open file(outf) stream output title('M11OUT DAT');
  12 c 0023   put file(outf) list(v,z);
  13 c 004D   put file(outf) list(z,v);
  14 c 0077   close file(outf);
  15 a 007D end E46M11;

CODE SIZE = 0080
DATA AREA = 0023
FREE SYMS = 389A
END  COMPILATION
