PL/I-80 V1.4 COMPILATION OF: E46M30

   1 a 0000 E46M30:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2b] RUNTIME: two UNDER-FILLED CHARACTER FIXED items in
   4 a 0006      one file PUT. E46L13 measured that ONE under-filled fixed item
   5 a 0006      is padded to its DECLARED length with BLANKS; this asks whether
   6 a 0006      the padding swallows the separator, and whether the second
   7 a 0006      item's padding is affected by the first. */
   8 c 0006   dcl outf file, c char(8), d char(4);
   9 c 0006   c = 'ABC';
  10 c 0013   d = 'W';
  11 c 0020   open file(outf) stream output title('M30OUT DAT');
  12 c 003D   put file(outf) list(c,d);
  13 c 0062   close file(outf);
  14 c 0068   put list('DONE');
  15 c 007F   stop;
  16 a 0082 end E46M30;

CODE SIZE = 0082
DATA AREA = 001E
FREE SYMS = 384E
END  COMPILATION
