PL/I-80 V1.4 COMPILATION OF: E46M6

   1 a 0000 E46M6:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2b] THE EMPTY LITERAL AS AN ITEM of a multi-item file
   4 a 0006      PUT. [C155]'s exception is PL17: a zero-length pool BLOCK is
   5 a 0006      registered per occurrence of '' while a non-empty repeat
   6 a 0006      registers none. This asks whether that holds on the FILE route,
   7 a 0006      where the item also emits `MVI A,00'. */
   8 c 0006   dcl outf file;
   9 c 0006   open file(outf) stream output title('M6OUT DAT');
  10 c 0023   put file(outf) list('','A','');
  11 c 0053   close file(outf);
  12 a 0059 end E46M6;

CODE SIZE = 005C
DATA AREA = 000A
FREE SYMS = 3875
END  COMPILATION
