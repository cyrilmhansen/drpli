PL/I-80 V1.4 COMPILATION OF: E46M17

   1 a 0000 E46M17:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2b] THE CHARACTER FIXED MEMBER CLASS on the file route:
   4 a 0006      a fixed member beside a varying member in one list.
   5 a 0006      E46J12/E46J18 prove the fixed member's CONSOLE chain (`MVI
   6 a 0006      A,<declared length>' + ?SLCTS); nothing proves the file route,
   7 a 0006      so this is that class's own witness. */
   8 c 0006   dcl outf file;
   9 c 0006   dcl 1 rec, 2 c8 char(8), 2 line char(14) varying;
  10 c 0006   open file(outf) stream output title('M17OUT DAT');
  11 c 0023   put file(outf) list(c8);
  12 c 003D   put file(outf) list(c8,line);
  13 c 0060   close file(outf);
  14 a 0066 end E46M17;

CODE SIZE = 0069
