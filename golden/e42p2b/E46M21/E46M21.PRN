   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: E46M21

   1 a 0000 E46M21:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2b] THE SECOND-ITEM GUARD: a FLOAT in position 2.
   4 a 0006      E46L11 pins FLOAT as a my-gap in position 1; each item is
   5 a 0006      authorized on its own, so an unauthorized class anywhere must
   6 a 0006      stop the whole statement. */
   7 c 0006   dcl outf file, v char(20) varying, q float;
   8 c 0006   open file(outf) stream output title('M21OUT DAT');
   9 c 0023   put file(outf) list(v,q);
  10 c 0046   close file(outf);
  11 a 004C end E46M21;

CODE SIZE = 004F
DATA AREA = 0023
FREE SYMS = 389A
END  COMPILATION
