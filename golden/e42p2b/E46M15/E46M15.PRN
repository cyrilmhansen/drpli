PL/I-80 V1.4 COMPILATION OF: E46M15

   1 a 0000 E46M15:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2b] FIVE items, every authorized class, ONE statement:
   4 a 0006      varying char, fixed char, fixed bin, fixed dec, varying char.
   5 a 0006      CREATE's list has six; this is the same spread with ordinary
   6 a 0006      variables, so a length- or class-dependent bug cannot hide. */
   7 c 0006   dcl outf file, v char(20) varying, c char(14),
   8 c 0006        k fixed bin(15), z fixed dec(6);
   9 c 0006   open file(outf) stream output title('M15OUT DAT');
  10 c 0023   put file(outf) list(v,c,k,z,v);
  11 c 006C   close file(outf);
  12 a 0072 end E46M15;

CODE SIZE = 0075
DATA AREA = 0033
FREE SYMS = 3884
END  COMPILATION
