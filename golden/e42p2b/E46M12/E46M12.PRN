PL/I-80 V1.4 COMPILATION OF: E46M12

   1 a 0000 E46M12:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-42/P2b] THE SAME mixed CHARACTER/DECIMAL list on the
   4 a 0006      CONSOLE route, alone. This records DR's OWN verdict on the
   5 a 0006      combination the [E2E-29/P1] classifier refuses. It is a CONSOLE
   6 a 0006      boundary, not a file one; nothing here authorizes a console
   7 a 0006      change. */
   8 c 0006   dcl v char(20) varying, z fixed dec(6);
   9 c 0006   put list(v,z);
  10 c 002D   put list(z,v);
  11 c 0054   stop;
  12 a 0057 end E46M12;

CODE SIZE = 0057
