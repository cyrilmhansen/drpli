PL/I-80 V1.4 COMPILATION OF: E520E

   1 a 0000 E520E: procedure options(main);
   2 a 0006    /* E2E-52/P3-14 probe E (PLAN P3-14 H-5): BOUNDARY,
   3 a 0006       bare STATEMENT form of the shadowed name with
   4 a 0006       EMPTY PARENS and NO CALL keyword. DR acceptance
   5 a 0006       is UNMEASURED (PL/I procedure statements carry
   6 a 0006       CALL); my parser KEEPS the builtin capture here
   7 a 0006       by design. If DR refuses, the [TBD] refusal
   8 a 0006       stays BY NAME; if DR accepts, the bytes
   9 a 0006       adjudicate against the CALL form. */
  10 c 0006    dcl i fixed bin;
  11 c 0006 
  12 c 0006    summary();
  13 c 0006    put skip list(i);
  14 c 0022 
  15 c 0022 summary: procedure();
  16 e 0022    i = 1;
  17 c 0035    end summary;
  18 a 0035 end E520E;

CODE SIZE = 0038
DATA AREA = 0002
FREE SYMS = 38BA
END  COMPILATION
