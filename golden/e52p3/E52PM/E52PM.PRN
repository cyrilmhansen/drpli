PL/I-80 V1.4 COMPILATION OF: E52PM

   1 a 0000 E52PM: procedure options(main);
   2 a 0006    /* E52PM (picture record FLUSH against the 80 00 header (no a
   3 a 0006       record); expect 80 00 02 03 02 05 ... 81) */
   4 a 0006    /* P3-3 decimal family: d fixed decimal(4,2) mirrors LOAN2's yi;
   5 a 0006       the picture operand under test is the ONE varying element. */
   6 c 0006    dcl d fixed decimal(4,2);
   7 c 0006    put edit(d)(p'9V.99');
   8 a 002A end E52PM;

