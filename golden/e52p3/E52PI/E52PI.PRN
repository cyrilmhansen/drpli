PL/I-80 V1.4 COMPILATION OF: E52PI

   1 a 0000 E52PI: procedure options(main);
   2 a 0006    /* E52PI (picture-only console table with scale-matched d:
   3 a 0006       expect 80 00 02 04 02 06 39 39 56 2E 39 39 81) */
   4 a 0006    /* P3-3 decimal family: d fixed decimal(4,2) mirrors LOAN2's yi;
   5 a 0006       the picture operand under test is the ONE varying element. */
   6 c 0006    dcl d fixed decimal(4,2);
   7 c 0006    put edit(d)(p'99V.99');
   8 a 002A end E52PI;

CODE SIZE = 002D
DATA AREA = 0010
FREE SYMS = 38D4
