PL/I-80 V1.4 COMPILATION OF: E52PH

   1 a 0000 E52PH: procedure options(main);
   2 a 0006    /* E52PH (control p'$$$,$$$,$$9V.99': reproduce the LOAN2-179
   3 a 0006       record 02 0A 02 0F in isolation) */
   4 a 0006    /* P3-3 scale-0 family: console EDIT, data = literal + fixed-bin
   5 a 0006       expression (P086K/LOAN2-115 law), format = a + picture; the
   6 a 0006       picture operand under test is the ONE varying element. */
   7 c 0006    dcl m fixed binary, y fixed binary;
   8 c 0006    put edit('|',100*m+y)(a,p'$$$,$$$,$$9V.99');
   9 a 0039 end E52PH;

CODE SIZE = 003C
DATA AREA = 001D
FREE SYMS = 38A6
