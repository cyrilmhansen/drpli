PL/I-80 V1.4 COMPILATION OF: E48D5

   1 a 0000 E48D5:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P2d] EMPTY literal on a STATIC CHARACTER (FIXED) --
   4 a 0006      the corpus witnesses (EXPR2:19, FSCAN:12/19) are all VARYING,
   5 a 0006      so the fixed empty cell is unmeasured: five blanks, or a zero-
   6 a 0006      length cell? */
   7 c 0006   dcl s char(5) static initial(''),
   8 c 0006       k fixed bin(15);
   9 c 0006   put list('S=', s);
  10 c 0028   stop;
  11 a 002B end E48D5;

