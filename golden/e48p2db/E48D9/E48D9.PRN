PL/I-80 V1.4 COMPILATION OF: E48D9

   1 a 0000 E48D9:
   2 a 0006   procedure options(main);
   3 a 0006   /* [E2E-48/P2d] a BIT(1) PUT item that is NOT the final item --
   4 a 0006      all nine sites of [C313] are final, so the tail question (the
   5 a 0006      bit tail replacing the shared literal tail, and then what
   6 a 0006      follows) is unmeasured. */
   7 c 0006   dcl b bit(1) static initial('0'b);
   8 c 0006   dcl k fixed bin(15);
   9 c 0006   put list(b, 'X');
  10 c 0028   stop;
  11 a 002B end E48D9;

