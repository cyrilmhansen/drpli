PL/I-80 V1.4 COMPILATION OF: E52VF

   1 a 0000 E52VF: procedure options(main);
   2 a 0006 
   3 a 0006    /* E2E-52/P3-9 probe VF (PLAN sec P3-9 H6): FOUR operands
   4 a 0006       -- the chain law past 3 is unmeasured. SN predicts three
   5 a 0006       F5/C1-B0 pairs, ONE terminal F2, `dl < 0' LAST,
   6 a 0006       materialisers per registered law. */
   7 a 0006 
   8 c 0006    dcl dl fixed binary;
   9 c 0006    dcl m fixed binary;
  10 c 0006    dcl x fixed bin;
  11 c 0006 
  12 c 0006    if dl = 0 | dl > 2 | m > 1 | dl < 0 then x = 1;
  13 c 0033    x = 2;
  14 c 0039 
  15 a 0039 end E52VF;

CODE SIZE = 003C
DATA AREA = 0006
FREE SYMS = 38A4
