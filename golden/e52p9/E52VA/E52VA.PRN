PL/I-80 V1.4 COMPILATION OF: E52VA

   1 a 0000 E52VA: procedure options(main);
   2 a 0006 
   3 a 0006    /* E2E-52/P3-9 probe VA (PLAN sec P3-9 H3): the STANDALONE
   4 a 0006       `dl < 0' test. DR accepts it inside LOAN2:91's fold; the
   5 a 0006       standalone encoding is UNMEASURED (mine refuses the leaf).
   6 a 0006       Prediction: 3A <dl_hi> / B7 / F2 skip; competitor: bias-0
   7 a 0006       ladder 2A / 7C / B7 / F2. */
   8 a 0006 
   9 c 0006    dcl dl fixed binary;
  10 c 0006    dcl x fixed bin;
  11 c 0006 
  12 c 0006    if dl < 0 then x = 1;
  13 c 0013    x = 2;
  14 c 0019 
  15 a 0019 end E52VA;

CODE SIZE = 001C
