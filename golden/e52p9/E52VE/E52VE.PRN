PL/I-80 V1.4 COMPILATION OF: E52VE

   1 a 0000 E52VE: procedure options(main);
   2 a 0006 
   3 a 0006    /* E2E-52/P3-9 probe VE (PLAN sec P3-9 H2/H5): FIXBIN = 0
   4 a 0006       ([C310] 21/7E/23/B6/D6 01/9F) ORed with the > 2 ladder.
   5 a 0006       No < 0 operand: SN predicts the = 0 head (21); RB
   6 a 0006       predicts the ladder head (2A). */
   7 a 0006 
   8 c 0006    dcl dl fixed binary;
   9 c 0006    dcl x fixed bin;
  10 c 0006 
  11 c 0006    if dl = 0 | dl > 2 then x = 1;
  12 c 0023    x = 2;
  13 c 0029 
  14 a 0029 end E52VE;

CODE SIZE = 002C
DATA AREA = 0004
FREE SYMS = 38AF
END  COMPILATION
