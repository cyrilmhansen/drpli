COMPILATION OF: NETWORK

D: Disk Print
L: List Source Program

   NO ERROR(S) IN PASS 1

   NO ERROR(S) IN PASS 2

PL/I-80 V1.4 COMPILATION OF: NETWORK

   1   0000 /******************************************************/
   2   0000 /* This program finds the shortest path between nodes */
   3   0000 /* in a network.  It has 8 internal procedures:       */
   4   0000 /* SETUP, CONNECT, FIND, PRINT_ALL, PRINT_PATHS,      */
   5   0000 /* SHORTEST_DISTANCE, PRINT_ROUTE, and FREE_ALL.      */
   6   0000 /******************************************************/
   7 a 0000 network:
   8 a 0006     procedure options(main);
   9 c 0006     %replace 
  10 c 0006         true     by '1'b,
  11 c 0006         false    by '0'b,
  12 c 0006         citysize by 20,
  13 c 0006         infinite by 32767;
  14 c 0006     declare
  15 c 0006         sysin file;
  16 c 0006     declare
  17 c 0006         1 city_node based,
  18 c 0006           2 city_name   character(citysize) varying,
  19 c 0006           2 total_distance  fixed,
  20 c 0006           2 investigate bit,
  21 c 0006           2 city_list   pointer,
  22 c 0006           2 route_head  pointer;
  23 c 0006     declare
  24 c 0006         1 route_node based,
  25 c 0006           2 next_city   pointer,
  26 c 0006           2 route_distance  fixed,
  27 c 0006           2 route_list  pointer;
  28 c 0006     declare
  29 c 0006         city_head pointer;
  30 c 0006 
  31 c 0006     do while(true);
  32 c 0006        call setup();
  33 c 0009        if city_head = null then
  34 c 0011           stop;
  35 c 0014        call print_all();
  36 c 0017        call print_paths();
  37 c 001A        call free_all();
  38 c 0020     end;
  39 c 0020 
  40 c 0020 /******************************************************/
  41 c 0020 /* This procedure reads two cities and then calls the */
  42 c 0020 /* procedure CONNECT to establish the connection (in  */
  43 c 0020 /* both directions) between the cities.               */
  44 c 0020 /******************************************************/
  45 c 0020     setup:
  46 c 0020         procedure;
  47 e 0020         declare
  48 e 0027             distance fixed,
  49 e 0027             (city1, city2) character(citysize) varying;
  50 e 0027         on endfile(sysin) goto eof;
  51 e 0035         city_head = null;
  52 e 003B         put skip list('Type "City1, Dist, City2"');
  53 e 0057         put skip;
  54 e 0068         do while(true);
  55 e 0068            get list(city1, distance, city2);
  56 e 009C            call connect(city1, distance, city2);
  57 e 00A2            call connect(city2, distance, city1);
  58 e 00B6         end;
  59 e 00B6         eof:
  60 c 00B6     end setup;
  61 c 00B6 
  62 c 00B6 /******************************************************/
  63 c 00B6 /* This procedure establishes a single route_node to  */
  64 c 00B6 /* connect the first city to the second city by       */
  65 c 00B6 /* calling the FIND procedure twice; once for the     */
  66 c 00B6 /* first city and once for the second city.           */
  67 c 00B6 /******************************************************/
  68 c 00B6     connect:
  69 c 00B6         procedure(source_city, distance, destination_city);
  70 e 00B6         declare
  71 e 00C3             source_city character(citysize) varying,
  72 e 00C3             destination_city character(citysize) varying,
  73 e 00C3             distance fixed,
  74 e 00C3             (r, s, d) pointer;
  75 e 00C3 
  76 e 00C3         s = find(source_city);
  77 e 00D2         d = find(destination_city);
  78 e 00E1         allocate route_node set (r);
  79 e 00EA         r->route_distance = distance;
  80 e 00FB         r->next_city  = d;
  81 e 0106         r->route_list = s->route_head;
  82 e 011D         s->route_head = r;
  83 c 012D     end connect;
  84 c 012D 
  85 c 012D /******************************************************/
  86 c 012D /* This procedure searches the list of cities and     */
  87 c 012D /* returns a pointer to the requested city_node.      */
  88 c 012D /******************************************************/
  89 c 012D     find:
  90 c 012D         procedure(city) returns(pointer);
  91 e 012D         declare
  92 e 0134             city character(citysize) varying,
  93 e 0134             (p, q) pointer;
  94 e 0134 
  95 e 0134         do p = city_head
  96 e 0142            repeat(p->city_list) while(p^=null);
  97 e 0142            if city = p->city_name then
  98 e 0150               return(p);
  99 e 0165         end;
 100 e 0165         allocate city_node set(p);
 101 e 016E         p->city_name  = city;
 102 e 017B         p->city_list  = city_head;
 103 e 018A         city_head     = p;
 104 e 0190         p->total_distance = infinite;
 105 e 019C         p->route_head = null;
 106 e 01A9         return(p);
 107 c 01AD     end find;
 108 c 01AD 
 109 c 01AD /******************************************************/
 110 c 01AD /* This procedure starts at the city_head and displays*/
 111 c 01AD /* all the cities in the city_list.                   */
 112 c 01AD /******************************************************/
 113 c 01AD     print_all:
 114 c 01AD         procedure;
 115 e 01AD         declare
 116 e 01AD             (p, q) pointer;
 117 e 01AD 
 118 e 01AD         do p = city_head
 119 e 01BB            repeat(p->city_list) while(p^=null);
 120 e 01BB            put skip list(p->city_name,':');
 121 e 01E0            do q = p->route_head
 122 e 01F6               repeat(q->route_list) while(q^=null);
 123 e 01F6               put skip list(q->route_distance,'miles to',
 124 e 0253                             q->next_city->city_name);
 125 e 0253            end;
 126 e 0253         end;
 127 c 0253     end print_all;
 128 c 0253 
 129 c 0253 /******************************************************/
 130 c 0253 /* This procedure reads a destination city, calls the */
 131 c 0253 /* SHORTEST_DISTANCE procedure, and sets the          */
 132 c 0253 /* total_distance field in each city_node to the      */
 133 c 0253 /* total distance from the destination city.          */
 134 c 0253 /******************************************************/
 135 c 0253     print_paths:
 136 c 0253         procedure;
 137 e 0253         declare
 138 e 025A             city character(citysize) varying;
 139 e 025A 
 140 e 025A         on endfile(sysin) goto eof;
 141 e 0268         do while(true);
 142 e 0268            put skip list('Type Destination ');
 143 e 0284            get list(city);
 144 e 029E            call shortest_distance(city);
 145 e 02A4            on endfile(sysin) goto eol;
 146 e 02B2            do while(true);
 147 e 02B2               put skip list('Type Start ');
 148 e 02CE               get list(city);
 149 e 02E8               call print_route(city);
 150 e 02F8             end;
 151 e 02F8             eol: revert endfile(sysin);
 152 e 030E         end;
 153 e 030E         eof:
 154 c 030E     end print_paths;
 155 c 030E 
 156 c 030E /******************************************************/
 157 c 030E /* This procedure is the heart of the program.  It    */
 158 c 030E /* takes an input city (the destination), and computes*/
 159 c 030E /* the minimum total distance from every city in the  */
 160 c 030E /* network to the destination.  It then records this  */
 161 c 030E /* minimum value in the total_distance field of every */
 162 c 030E /* city_node.                                         */
 163 c 030E /******************************************************/
 164 c 030E     shortest_distance:
 165 c 030E         procedure(city);
 166 e 030E         declare
 167 e 0315             city character(citysize) varying;
 168 e 0315         declare
 169 e 0315             bestp pointer,
 170 e 0315             (d, bestd) fixed,
 171 e 0315             (p, q, r) pointer;
 172 e 0315         do p = city_head
 173 e 0323            repeat(p->city_list) while(p^=null);
 174 e 0323            p->total_distance  = infinite;
 175 e 032F            p->investigate = false;
 176 e 0346         end;
 177 e 0346         p = find(city);
 178 e 0355         p->total_distance  = 0;
 179 e 0360         p->investigate = true;
 180 e 0368         do while(true);
 181 e 0368            bestp = null;
 182 e 036E            bestd = infinite;
 183 e 0374            do p = city_head
 184 e 0382               repeat(p->city_list) while(p^=null);
 185 e 0382               if p->investigate then
 186 e 038E                  do;
 187 e 038E                    if p->total_distance < bestd then
 188 e 03A3                       do;
 189 e 03A3                         bestd = p->total_distance;
 190 e 03B1                         bestp = p;
 191 e 03C8                       end;
 192 e 03C8                  end;
 193 e 03C8            end;
 194 e 03C8            if bestp = null then
 195 e 03D0               return;
 196 e 03D1            bestp->investigate = false;
 197 e 03DA            do q = bestp->route_head
 198 e 03EF               repeat(q->route_list) while(q^=null);
 199 e 03EF               r = q->next_city;
 200 e 03F9               d = bestd + q->route_distance;
 201 e 040B               if d < r->total_distance then
 202 e 0421                  do;
 203 e 0421                    r->total_distance  = d;
 204 e 0430                    r->investigate = true;
 205 e 044D                  end;
 206 e 044D            end;
 207 e 044D         end;
 208 c 044D     end shortest_distance;
 209 c 044D 
 210 c 044D /******************************************************/
 211 c 044D /* This procedure displays the best route from the    */
 212 c 044D /* input city to the destination.                     */
 213 c 044D /******************************************************/
 214 c 044D     print_route:
 215 c 044D         procedure(city);
 216 e 044D         declare
 217 e 0454             city character(citysize) varying;
 218 e 0454         declare
 219 e 0454             (p,q) pointer,
 220 e 0454             (t,d) fixed;
 221 e 0454         p = find(city);
 222 e 0463         do while(true);
 223 e 0463            t = p->total_distance;
 224 e 0471            if t = infinite then
 225 e 047D               do;
 226 e 047D                 put skip list('(No Connection)');
 227 e 0499                 return;
 228 e 049A               end;
 229 e 049A            if t = 0 then
 230 e 04A3               return;
 231 e 04A4            put skip list(t,'miles remain,');
 232 e 04CB            q = p->route_head;
 233 e 04D9            do while(q^=null);
 234 e 04E1               p = q->next_city;
 235 e 04EB               d = q->route_distance;
 236 e 04F7               if t = d + p->total_distance then
 237 e 0515                  do;
 238 e 0515                     put list(d,'miles to',p->city_name);
 239 e 0540                     q = null;
 240 e 0549                  end; 
 241 e 0549               else
 242 e 0549                  q = q->route_list;
 243 e 055D            end;
 244 e 055D         end;
 245 c 055D     end print_route;
 246 c 055D 
 247 c 055D /******************************************************/
 248 c 055D /* This procedure frees all the storage allocated     */
 249 c 055D /* by the program while processing the network.       */
 250 c 055D /******************************************************/
 251 c 055D     free_all:
 252 c 055D         procedure;
 253 e 055D         declare
 254 e 055D             (p, q) pointer;
 255 e 055D         do p = city_head
 256 e 056B            repeat(p->city_list) while(p^=null);
 257 e 056B            do q = p->route_head
 258 e 0581               repeat(q->route_list) while(q^=null);
 259 e 0581               free q->route_node;
 260 e 0598            end;
 261 e 0598            free p->city_node;
 262 e 05B0         end;
 263 c 05B0     end free_all;
 264 c 05B0 
 265 a 05B0 end network;
 266 a 05B0 

CODE SIZE = 05B0
DATA AREA = 00EB
FREE SYMS = 32EB
END  COMPILATION
